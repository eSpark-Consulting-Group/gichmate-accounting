<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Class="DashboardWPFApp12.MenuWindow"
        Title="MainWindow" Height="900" Width="1500"
        WindowStyle="None" ResizeMode="NoResize" Background="Beige">

    <Window.Resources>
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>

        <Storyboard x:Key="ExpandSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarPanel"
                             Storyboard.TargetProperty="Width"
                             To="200" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="CollapseSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarPanel"
                             Storyboard.TargetProperty="Width"
                             To="60" Duration="0:0:0.3"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <!-- Top Bar -->
        <Grid Background="#EE4540" Height="30" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Content="DASHBOARD"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                Click="btn_Dashboard" RenderTransformOrigin="0.5,0.5">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="MENU"
                 Foreground="WhiteSmoke"
                 Background="Transparent"
                 BorderThickness="0"
                 Grid.Column="2"
                 VerticalAlignment="Bottom"
                 HorizontalAlignment="Center"
                 FontSize="17"
                 FontFamily="Fonts/#myfont"
                 FontWeight="UltraLight"
                 Margin="0,0,0,4" RenderTransformOrigin="0.5,0.5">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="ACCOUNTS"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="3"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                Click="btn_Accounts" RenderTransformOrigin="0.5,0.5">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button x:Name="TopBarReportsButton" Content="REPORTS"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="4"
                VerticalAlignment="Top"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                Click="btn_Reports" RenderTransformOrigin="0.5,0.5" Margin="0,4,0,0">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="PROFILES"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="5"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                Click="btn_Profiles" Margin="0,0,0,4" RenderTransformOrigin="0.5,0.5">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="SEARCH"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="6"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                Click="btn_Accounts" RenderTransformOrigin="0.5,0.5">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="CUSTOMERS"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="7"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                Click="btn_Accounts" RenderTransformOrigin="0.5,0.5" >
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>


            <Button Content="VIEW" Grid.Column="13" Click="btn_View"
                    Foreground="WhiteSmoke" Background="Transparent"
                    BorderThickness="0" FontSize="15" RenderTransformOrigin="0.5,0.5">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button Content="🔔" Grid.Column="14" Click="btn_Notifications"
                    Foreground="WhiteSmoke" Background="Transparent" 
                    BorderThickness="0" FontSize="15" RenderTransformOrigin="0.5,0.5">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button Content="☀" Grid.Column="15" Click="btn_Themes"
                    Foreground="WhiteSmoke" Background="Transparent" 
                    BorderThickness="0" FontSize="15" RenderTransformOrigin="0.5,0.5">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button Content="👤" Grid.Column="16" Click="btn_UseAs"
                    Foreground="WhiteSmoke" Background="Transparent" 
                    BorderThickness="0" FontSize="15" RenderTransformOrigin="0.5,0.5">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button x:Name="btn_Login" Content="Main Menu" Grid.Column="17"
                    Foreground="White" FontSize="14" FontWeight="Medium"
                    Background="#FF801336" BorderThickness="0" Width="85" Height="24" 
                    Click="Btn_Login" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Margin="0,3,0,3">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
        </Grid>

        <!-- Sidebar -->
        <Grid x:Name="SidebarPanel" Width="75"
              Background="{DynamicResource SidebarBrush}"
              Margin="0,30,0,0"
              HorizontalAlignment="Left" RenderTransformOrigin="1.367,0.57">
            <Grid.RowDefinitions>
                <RowDefinition Height="149*"/>
                <RowDefinition Height="286*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="10,10,10,0" VerticalAlignment="Top" Grid.RowSpan="2">
                <Button Content="☰" Click="ToggleSidebar_Click"
                        Foreground="White" Background="Transparent"
                        FontSize="18" Margin="10" BorderThickness="0"/>

                <Button Background="Transparent" BorderThickness="0" Height="50" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" FontSize="18" Margin="10,0"/>
                        <TextBlock x:Name="lblButton1" Text="Home"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="18" Margin="10,0" Foreground="White"/>
                        <TextBlock x:Name="lblButton2" Text="Files"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="18" Margin="10,0" Foreground="White"/>
                        <TextBlock x:Name="lblButton3" Text="Reports"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="18" Margin="10,0" Foreground="White"/>
                        <TextBlock x:Name="lblButton4" Text="Search"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="18" Margin="10,0" Foreground="White"/>
                        <TextBlock x:Name="lblButton5" Text="Settings"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="18" Margin="10,0" Foreground="White"/>
                        <TextBlock x:Name="lblButton6" Text="Profile"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Margin="60,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="306*"/>
                <ColumnDefinition Width="11*"/>
                <ColumnDefinition Width="1123*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FFEE4540"/>
                    <GradientStop Color="#FF2D142C" Offset="1"/>
                    <GradientStop Color="#FF510A32" Offset="0.565"/>
                    <GradientStop Color="#FFC72C41" Offset="0.157"/>
                    <GradientStop Color="#FF801336" Offset="0.365"/>
                    <GradientStop Color="#FF670E33" Offset="0.426"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>
    </Grid>
</Window>