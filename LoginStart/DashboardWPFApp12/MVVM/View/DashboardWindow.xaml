<Window x:Class="DashboardWPFApp12.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard"
        WindowStyle="None"
        ResizeMode="NoResize"
        Width="1024" Height="768">

    <Window.Resources>
        <!-- Navigation Button Style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Login Button Style -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Background" Value="#FF801336"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background Gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#FFEE4540" Offset="0"/>
                <GradientStop Color="#FFC72C41" Offset="0.3"/>
                <GradientStop Color="#FF801336" Offset="0.396"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF541330" Offset="0.669"/>
                <GradientStop Color="#FFB0233D" Offset="0.335"/>
                <GradientStop Color="#FFCC2539" Offset="0.276"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Grid Layout -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Top Navigation -->
            <RowDefinition/>
            <!-- Content -->
            <RowDefinition Height="40"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Sidebar -->
            <ColumnDefinition/>
            <!-- Main Content -->
            <ColumnDefinition Width="240"/>
            <!-- Right Panel -->
        </Grid.ColumnDefinitions>

        <!-- Top navigation bar -->
        <Grid Background="#EE4540" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="DASHBOARD"
           Foreground="WhiteSmoke"
           Background="Transparent"
           BorderThickness="0"
           Grid.Column="0"
           VerticalAlignment="Center"
           HorizontalAlignment="Center"
           FontSize="17"
           FontFamily="Fonts/#myfont"
           FontWeight="UltraLight"
           Click="btn_Dashboard"/>

            <Button Content="MENU"               Foreground="WhiteSmoke"               Background="Transparent"
               BorderThickness="0"               Grid.Column="1"                         HorizontalAlignment="Center"
               FontSize="17"                     FontFamily="Fonts/#myfont"              FontWeight="UltraLight"
               Click="btn_Menu" />

            <Button Content="ACCOUNTS"               Foreground="WhiteSmoke"               Background="Transparent"
               BorderThickness="0"                   Grid.Column="2"         
               HorizontalAlignment="Center"          FontSize="17"               FontFamily="Fonts/#myfont"
               FontWeight="UltraLight"               Click="btn_Accounts" />

            <Button Content="PROFILES"               Foreground="WhiteSmoke"               Background="Transparent"
               BorderThickness="0"                   Grid.Column="3"                         VerticalAlignment="Center"
               HorizontalAlignment="Center"          FontSize="17"                           FontFamily="Fonts/#myfont"
               FontWeight="UltraLight"               Click="btn_Profiles"/>

            <Button x:Name="btn_Login" Grid.Column="7"			Content="Log In"
			Foreground="White"			FontSize="14"			FontWeight="Medium"			Margin="0,-5,0,-5"
            Click="Btn_Login" HorizontalAlignment="Center" Width="137">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF801336"/>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
							Width="90"
							Height="30"
							
							Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="center"
										  HorizontalAlignment="center"
										  Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF9B3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Sidebar (Key Metrics) -->
        <StackPanel Grid.Row="1" Grid.Column="0" Background="#510A32" Margin="10,10,10,10">
            <TextBlock Text="Key Metrics" Foreground="WhiteSmoke" FontSize="18" FontWeight="Bold" Margin="10"/>

            <Border Background="#670E33" CornerRadius="6" Margin="10" Height="80">
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Users" Foreground="WhiteSmoke" FontSize="12"/>
                    <TextBlock Text="1,250" Foreground="WhiteSmoke" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#670E33" CornerRadius="6" Margin="10" Height="80">
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Revenue" Foreground="WhiteSmoke" FontSize="12"/>
                    <TextBlock Text="$58,400" Foreground="WhiteSmoke" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <Border Background="#670E33" CornerRadius="6" Margin="10" Height="80">
                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                    <TextBlock Text="Invoices" Foreground="WhiteSmoke" FontSize="12"/>
                    <TextBlock Text="320" Foreground="WhiteSmoke" FontSize="24" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main Content Area -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="0,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Line Chart -->
            <Border Grid.Row="0" Background="#510A46" CornerRadius="8" Margin="10">
                <Grid>
                    <TextBlock Text="Sales Trend" Foreground="WhiteSmoke" FontSize="16" FontWeight="Bold" Margin="10"/>
                    <Canvas Margin="10,40,10,10">
                        <Line X1="30" Y1="100" X2="300" Y2="100" Stroke="WhiteSmoke" StrokeThickness="1"/>
                        <Line X1="30" Y1="30" X2="30" Y2="100" Stroke="WhiteSmoke" StrokeThickness="1"/>
                        <Polyline Points="30,100 80,70 130,90 180,50 230,75 290,45 430,50"
                                  Stroke="LightGreen" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Center" Width="450" Height="99"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Bar Chart -->
            <Border Grid.Row="1" Background="#510A46" CornerRadius="8" Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="396*"/>
                        <ColumnDefinition Width="149*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Monthly Revenue" Foreground="WhiteSmoke" FontSize="16" FontWeight="Bold" Margin="10,10,10,10" Grid.ColumnSpan="2"/>
                    <UniformGrid Rows="1" Columns="6" Margin="182,40,0,10" HorizontalAlignment="Left">
                        <Rectangle Width="30" Height="60" Fill="#EE4540"/>
                        <Rectangle Width="30" Height="90" Fill="#FF801336"/>
                        <Rectangle Width="30" Height="45" Fill="#EE4540"/>
                        <Rectangle Width="30" Height="120" Fill="#FF9B3D3D"/>
                        <Rectangle Width="30" Height="75" Fill="#EE4540"/>
                        <Rectangle Width="30" Fill="#FF801336" Margin="0,10,0,77"/>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Panel (User Engagement) -->
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="10" HorizontalAlignment="Center">
            <TextBlock Text="Engagement" FontSize="18" Foreground="WhiteSmoke" FontWeight="Bold" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <!-- Circle 1 -->
                <Grid Width="90" Height="90" Margin="5">
                    <Ellipse Fill="#510A32"/>
                    <Ellipse Margin="8" Fill="#670E33"/>
                    <TextBlock Text="75%" Foreground="WhiteSmoke" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>

                <!-- Circle 2 -->
                <Grid Width="90" Height="90" Margin="5">
                    <Ellipse Fill="#510A32"/>
                    <Ellipse Margin="8" Fill="#C72C41"/>
                    <TextBlock Text="60%" Foreground="WhiteSmoke" FontSize="18" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <!-- Circle 3 -->
            <Grid Width="90" Height="90" Margin="5" HorizontalAlignment="Center">
                <Ellipse Fill="#510A32"/>
                <Ellipse Margin="8" Fill="#801336"/>
                <TextBlock Text="85%" Foreground="WhiteSmoke" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </StackPanel>

        <!--Footer-->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Background="#2D142C" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="199*"/>
                <ColumnDefinition Width="73*"/>
                <ColumnDefinition Width="752*"/>
            </Grid.ColumnDefinitions>
            <!-- Electric Eel - a glowing path moving horizontally -->
            <Canvas Grid.ColumnSpan="3">
                <Rectangle Width="210" Height="10" RadiusX="5" RadiusY="15" Fill="#FFEE4540" Opacity="0.9">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="Orange" BlurRadius="20" ShadowDepth="15"/>
                    </Rectangle.Effect>
                    <Rectangle.RenderTransform>
                        <TranslateTransform x:Name="EelTransform" />
                    </Rectangle.RenderTransform>
                    <Rectangle.Triggers>
                        <EventTrigger RoutedEvent="Rectangle.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation Storyboard.TargetName="EelTransform"
                                             Storyboard.TargetProperty="X"
                                             From="0" To="1024"
                                             Duration="0:0:10" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Rectangle.Triggers>
                </Rectangle>
            </Canvas>
        </Grid>

    </Grid>
</Window>
