<Window x:Class="MVVMApp20.ReportMenu"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MVVMApp20"
        xmlns:viewModel="clr-namespace:MVVMApp20.MVVM.ViewModel"
        mc:Ignorable="d"
        Title="ReportMenu" Height="900" Width="1600" Background="#FF252525">

    <!--AllowsTransparency="True"-->

    <Window.DataContext>
        <viewModel:ReportViewModel/>
    </Window.DataContext>



    <Border Background="AliceBlue"
            CornerRadius="30">

        <Grid x:Name="MenuBarStackPanel">
            <Grid.Background>

                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFEE4540"/>
                    <GradientStop Color="#FF2D142C" Offset="1"/>
                    <GradientStop Color="#FF510A32" Offset="0.565"/>
                    <GradientStop Color="#FFC72C41" Offset="0.157"/>
                    <GradientStop Color="#FF801336" Offset="0.365"/>
                    <GradientStop Color="#FF670E33" Offset="0.426"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="201"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="0*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="REPORTS"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="32"
                       FontFamily="/Fonts/#Poppins-Bold"
                       Margin="10,0,0,0" Height="48" />


            <StackPanel Grid.Row="1">

                <RadioButton Content=""
                             Height="29"
                             Foreground="White"
                             FontSize="14"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="ADVANCE REPORTS"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton x:Name="SalesReportButton" Content="SALES"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}" 
                             Command="{Binding ShowSalesPageCommand}"                             
                             />

                <RadioButton Content="SALES RETURN REPORT"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="PURCHASE"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="PURCHASE RETURN REPORT"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="SALES ESTIMATE REPORT"
                            Height="30"
                            Foreground="White"
                            FontSize="14"
                            FontFamily="/Fonts/#Poppins"
                            Style="{StaticResource MenuButtonTheme}"                             
                            />

                <RadioButton Content="SALES ORDER REPORT"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                            
                             />

                <RadioButton Content="SALES QUOTATION REPORT"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="PURCHASE ORDER REPORT"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="PRICE LIST"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="PARTY LIST"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="ACCOUNT PAYABLE REPORT"
                            Height="30"
                            Foreground="White"
                            FontSize="14"
                            FontFamily="/Fonts/#Poppins"
                            Style="{StaticResource MenuButtonTheme}"                             
                            />

                <RadioButton Content="RECIEVABLE REPORT"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                           
                             />

                <RadioButton Content="ROOTWISE COLLECTION RP."
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="TRANSACTION REPORT"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="CUSTOMER REPORT"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="SUPPLIER REPORT"
                             Height="30"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="OTHER REPORTS"
                            Height="30"
                            Foreground="White"
                            FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                            Style="{StaticResource MenuButtonTheme}"                             
                            />


            </StackPanel>

            <TextBox Width="258"
                     VerticalContentAlignment="Center"
                     HorizontalAlignment="Left"
                     Margin="5,18,0,17"
                     Grid.Column="1"
                     Style="{StaticResource ModernTextBox}"/>

            <!--INCLUDING THE MAIN CONTENT HERE -->

            <ContentControl Grid.Row="1"
                      Grid.Column="1"
                      Margin="10,10,10,-1"
                      Content="{Binding CurrentView}"/>





        </Grid>
    </Border>
</Window>
