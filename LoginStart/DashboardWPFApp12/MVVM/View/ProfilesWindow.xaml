<Window x:Class="DashboardWPFApp12.ProfilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DashboardWPFApp12"
        mc:Ignorable="d"
        Title="MainWindow" Height="550" Width="900"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Beige">




    <Grid>


        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Top navigation bar -->
        <Grid Background="#EE4540" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Content="DASHBOARD"
	   Foreground="WhiteSmoke"
	   Background="Transparent"
	   BorderThickness="0"
	   Grid.Column="0"
	   VerticalAlignment="Center"
	   HorizontalAlignment="Center"
	   FontSize="17"
	   FontFamily="Fonts/#myfont"
	   FontWeight="UltraLight"
	   Click="btn_Dashboard"/>

            <Button Content="MENU"
            Foreground="WhiteSmoke"
            Background="Transparent"
            BorderThickness="0"
            Grid.Column="1"
            VerticalAlignment="Bottom"
            HorizontalAlignment="Center"
            FontSize="17"
            FontFamily="Fonts/#myfont"
            FontWeight="UltraLight"
            Click="btn_Menu" Margin="0,0,0,4"/>

            <Button Content="ACCOUNTS"
                       Foreground="WhiteSmoke"
                       Background="Transparent"
                       BorderThickness="0"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontFamily="Fonts/#myfont"
                       FontWeight="UltraLight"
                       Click="btn_Accounts"/>

            <Button Content="PROFILES"
                       Foreground="WhiteSmoke"
                       Background="Transparent"
                       BorderThickness="0"
                       Grid.Column="3"
                       VerticalAlignment="Bottom"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontFamily="Fonts/#myfont"
                       FontWeight="UltraLight"
                       Click="btn_Profiles" Margin="0,0,0,4"/>

            <Button x:Name="btn_LoginMenu" Grid.Column="7"
			Content="Main Menu"
			Foreground="White"
			FontSize="14"
			FontWeight="Medium"
			Margin="10,-5,-14,0" Height="40" VerticalAlignment="Top" Click="btn_LoginMenu_Click">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF801336"/>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
							Width="90"
							Height="30"
							
							Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="center"
										  HorizontalAlignment="center"
										  Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF9B3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!--The main design here-->
        <Grid
	  Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="175,-445,-569,791"
	  >

            <Grid.RenderTransform>
                <RotateTransform Angle ="40" />
            </Grid.RenderTransform>

            <StackPanel Orientation ="Horizontal">

                <StackPanel>
                    <Border Width="700" 
					Height="35"
					Background="#510A32"
					Margin="150,0,0,0"
					CornerRadius="20"/>

                    <Border Width="700"
					Height="35"
					Background="#801336"
					Margin="0,15,0,0"
					CornerRadius="20"/>

                    <Border Width="700"
					Height="35"
					Background="#510A46"
					Margin="75,15,0,0"
					CornerRadius="20"/>
                </StackPanel>
                <StackPanel>
                    <Border Width="650" 
					Height="35"
					Background="#EE4540"
					Margin="150,0,0,0"
					CornerRadius="20" RenderTransformOrigin="0.297,0.863"/>

                    <Border Width="700"
					Height="35"
					Background="white"
					Margin="0,15,0,0"
					CornerRadius="20"/>

                    <Border Width="700"
					Height="35"
					Background="#EE4540"
					Margin="75,15,0,0"
					CornerRadius="20"/>
                </StackPanel>

            </StackPanel>

        </Grid>
        <Border
            Background="#EE4540"
            CornerRadius="20" RenderTransformOrigin="0.297,0.863" Margin="769,116,-519,357" Grid.Row="1">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="39.218"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>



    </Grid>

</Window>