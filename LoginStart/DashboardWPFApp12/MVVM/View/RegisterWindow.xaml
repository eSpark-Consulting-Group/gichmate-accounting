<Window x:Class="DashboardWPFApp12.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RegisterWindow"
        Height="550" Width="900"
        WindowStyle="None"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Angled TextBox Style -->

        <Style x:Key="AngledTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF801336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Path Data="M0,0 L10,0 L0,10 Z"
                                  Fill="#FF801336"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="2"/>
                            <Path Data="M0,10 L10,10 L10,0 Z"
                                  Fill="#FF801336"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="2"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Angled PasswordBox Style -->
        <Style x:Key="AngledPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF801336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Path Data="M0,0 L10,0 L0,10 Z"
                                  Fill="#FF801336"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="2"/>
                            <Path Data="M0,10 L10,10 L10,0 Z"
                                  Fill="#FF801336"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="2"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Top Navigation Bar -->
        <Grid Background="#EE4540" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="DASHBOARD"
                   Foreground="WhiteSmoke"
                   Grid.Column="0"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   FontSize="17"
                   FontFamily="Fonts/#myfont"
                   FontWeight="UltraLight"
                   />

            <TextBlock Text="MENU"
                       Foreground="WhiteSmoke"                     
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontFamily="Fonts/#myfont"
                       FontWeight="UltraLight"
                       />

            <TextBlock Text="ACCOUNTS"
                       Foreground="WhiteSmoke"                       
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontFamily="Fonts/#myfont"
                       FontWeight="UltraLight"
                       />

            <TextBlock Text="PROFILES"
                       Foreground="WhiteSmoke"                       
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontFamily="Fonts/#myfont"
                       FontWeight="UltraLight"
                       />

            <Button x:Name="btn_Login" Grid.Column="7" Content="Main Menu" Margin="10,-5,-14,0"
                    Foreground="White" FontSize="14" FontWeight="Medium"
                    Background="#FF801336" Click="Btn_Login" Height="30" VerticalAlignment="Top"/>
        </Grid>

        <!-- Register Form -->
        <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto" Margin="-10,52,10,-52">
            <StackPanel HorizontalAlignment="Center" Width="500" Margin="0,20">
                <!-- Logo + Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Image Source="C:\Users\Dotnet_User1\Source\Repos\DashboardWPFApp12\Images\logo.png" Width="80" Height="80"
                           RenderOptions.BitmapScalingMode="Fant"
/>
                    <TextBlock Text="AccountsPRO" FontFamily="Fonts/#font2" FontSize="30"
                               Foreground="White" FontWeight="Medium" VerticalAlignment="Center"
                               Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Form Fields -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="First Name:" Width="120" FontSize="14" FontFamily="Fonts/#myfont"
                               Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <TextBox x:Name="firstName" Style="{StaticResource AngledTextBoxStyle}" Width="350" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Last Name:" Width="120" FontSize="14" FontFamily="Fonts/#myfont"
                               Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <TextBox x:Name="lastName" Style="{StaticResource AngledTextBoxStyle}" Width="350" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Email:" Width="120" FontSize="14" FontFamily="Fonts/#myfont"
                               Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <TextBox x:Name="email" Style="{StaticResource AngledTextBoxStyle}" Width="350" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Username:" Width="120" FontSize="14" FontFamily="Fonts/#myfont"
                               Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <TextBox x:Name="userName" Style="{StaticResource AngledTextBoxStyle}" Width="350" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Password:" Width="120" FontSize="14" FontFamily="Fonts/#myfont"
                               Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <PasswordBox x:Name="passwords" Style="{StaticResource AngledPasswordBoxStyle}" Width="350" Height="28"/>
                </StackPanel>

                <!-- Register Button -->
                <Button x:Name="Submit" Content="Register"
                        Width="120" Height="35" Margin="0,20,0,0"
                        FontSize="14" FontWeight="Medium"
                        Foreground="White" Background="#FF801336"
                        HorizontalAlignment="Center" Click="btn_Submit">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>
            </StackPanel>
        </ScrollViewer>
        <!-- Dashboard Content Panel -->
        <StackPanel x:Name="DashboardPanel" Grid.Row="1" Grid.ColumnSpan="2" VerticalAlignment="Center">
            <!-- Move all your original dashboard StackPanel content here -->
            <!-- Copy the StackPanel you already have (with logo, text, buttons) inside this one -->
        </StackPanel>

        <!-- Register Panel -->
        <ScrollViewer x:Name="RegisterPanel"
              Grid.Row="1" Grid.ColumnSpan="2"
              Visibility="Collapsed"
              VerticalScrollBarVisibility="Auto"
              HorizontalAlignment="Center">
            <StackPanel Width="500" Margin="0,20,0,0">
                <!-- Logo + Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <Image Source="Images/logo.png" Width="80" Height="80"/>
                    <TextBlock Text="AccountsPRO"
                       FontFamily="Fonts/#font2"
                       FontSize="30"
                       Foreground="White"
                       FontWeight="Medium"
                       VerticalAlignment="Center"
                       Margin="10,0,0,0"/>
                </StackPanel>

                <!-- Registration Fields -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="First Name:" Width="120" FontFamily="Fonts/#myfont"
                       FontSize="14" Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <TextBox Width="350" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Last Name:" Width="120" FontFamily="Fonts/#myfont"
                       FontSize="14" Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <TextBox Width="350" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Email:" Width="120" FontFamily="Fonts/#myfont"
                       FontSize="14" Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <TextBox Width="350" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Username:" Width="120" FontFamily="Fonts/#myfont"
                       FontSize="14" Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <TextBox Width="350" Height="28"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="Password:" Width="120" FontFamily="Fonts/#myfont"
                       FontSize="14" Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <PasswordBox Width="350" Height="28"/>
                </StackPanel>


            </StackPanel>
        </ScrollViewer>
        <Grid
	  Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="175,-445,-569,791"
	  >

            <Grid.RenderTransform>
                <RotateTransform Angle ="45" />
            </Grid.RenderTransform>

            <StackPanel Orientation ="Horizontal">

                <StackPanel>
                    <Border Width="700" 
					Height="35"
					Background="#510A32"
					Margin="190,0,0,0"
					CornerRadius="20"/>

                    <Border Width="675"
					Height="35"
					Background="#801336"
					Margin="0,15,0,0"
					CornerRadius="20"/>
                </StackPanel>
                <StackPanel>
                    <Border Width="682" 
					Height="35"
					Background="#EE4540"
					Margin="150,0,0,0"
					CornerRadius="20"/>

                    <Border Width="833"
					Height="35"
					Background="white"
					Margin="0,15,0,0"
					CornerRadius="20"/>

                    <Border Width="700"
					Height="35"
					Background="#EE4540"
					Margin="75,15,0,0"
					CornerRadius="20"/>
                </StackPanel>

            </StackPanel>

        </Grid>
        <Border
            Background="#EE4540"
            CornerRadius="20" Grid.ColumnSpan="2" Margin="-22,-146,240,146" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="45.047"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
        <Border
            Background="#EE4540"
            CornerRadius="20" Margin="250,415,-482,89" Grid.Column="1" Grid.Row="1" RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="46.452"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>
    </Grid>
</Window>