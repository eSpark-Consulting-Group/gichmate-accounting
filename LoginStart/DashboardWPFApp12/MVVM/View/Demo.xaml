<!-- MainWindow.xaml -->
<Window x:Class="DashboardWPFApp12.Demo.xaml"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dashboard"
        WindowState="Maximized"
        WindowStyle="None"
        ResizeMode="NoResize" Width="921">

    <Window.Resources>
        <!-- NavButton style -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <!-- LoginButton style -->
        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="100"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Foreground" Value="WhiteSmoke"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Background" Value="#FF801336"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Width="{TemplateBinding Width}"
                                Height="{TemplateBinding Height}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF9B3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- Background gradient -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FFEE4540" Offset="0"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Layout grid -->
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <!-- Top nav -->
            <RowDefinition/>
            <!-- Main content -->
            <RowDefinition Height="40"/>
            <!-- Footer -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <!-- Sidebar -->
            <ColumnDefinition/>
            <!-- Center -->
            <ColumnDefinition Width="220"/>
            <!-- Right panel -->
        </Grid.ColumnDefinitions>

        <!-- Top navigation bar -->
        <Grid Grid.Row="0" Grid.ColumnSpan="3" Background="#EE4540">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource NavButtonStyle}" Content="DASHBOARD"/>
            <Button Grid.Column="1" Style="{StaticResource NavButtonStyle}" Content="MENU"/>
            <Button Grid.Column="2" Style="{StaticResource NavButtonStyle}" Content="ACCOUNTS"/>
            <Button Grid.Column="3" Style="{StaticResource NavButtonStyle}" Content="PROFILES"/>

            <Button Grid.Column="7" Style="{StaticResource LoginButtonStyle}" Content="Log In"/>
        </Grid>

        <!-- Left Sidebar: Key Metrics -->
        <StackPanel Grid.Row="1" Grid.Column="0" Background="#510A32" Margin="20">
            <TextBlock Text="Key Metrics" Foreground="WhiteSmoke" FontSize="20" Margin="0,0,0,20"/>
            <!-- Metric tile -->
            <Border Background="#670E33" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Users" Foreground="WhiteSmoke" FontSize="13"/>
                    <TextBlock Text="1,250" Foreground="WhiteSmoke" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#670E33" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Sales" Foreground="WhiteSmoke" FontSize="13"/>
                    <TextBlock Text="$58,400" Foreground="WhiteSmoke" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
            </Border>
            <Border Background="#670E33" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="Feedback" Foreground="WhiteSmoke" FontSize="13"/>
                    <TextBlock Text="89%" Foreground="WhiteSmoke" FontSize="26" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Center: Line & Bar Charts -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition/>
                <!-- Line chart -->
                <RowDefinition/>
                <!-- Bar chart -->
            </Grid.RowDefinitions>

            <!-- Sales Trend (Line Chart) -->
            <Border Grid.Row="0" Background="#510A46" CornerRadius="10" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <TextBlock Text="Sales Trend" Foreground="WhiteSmoke" FontSize="16" FontWeight="Bold" Margin="0,-10,0,10"/>
                    <Canvas Margin="0,30,0,10">
                        <!-- Axes -->
                        <Line X1="0" Y1="120" X2="300" Y2="120" Stroke="White" StrokeThickness="1"/>
                        <Line X1="0" Y1="0"   X2="0"   Y2="120" Stroke="White" StrokeThickness="1"/>
                        <!-- Trend line -->
                        <Polyline Points="0,120 50,80 100,100 150,60 200,70 250,40 300,60"
                                  Stroke="WhiteSmoke" StrokeThickness="2" HorizontalAlignment="Left" Height="138" VerticalAlignment="Center" Width="352" Canvas.Top="-67"/>
                    </Canvas>
                </Grid>
            </Border>

            <!-- Monthly Revenue (Bar Chart) -->
            <Border Grid.Row="1" Background="#510A46" CornerRadius="10" Padding="12">
                <Grid>
                    <TextBlock Text="Monthly Revenue" Foreground="WhiteSmoke" FontSize="16" FontWeight="Bold"/>
                    <UniformGrid Rows="1" Columns="6" Margin="0,28,0,0" HorizontalAlignment="Center" VerticalAlignment="Bottom">
                        <Rectangle Width="30" Height="60"  Fill="#EE4540"/>
                        <Rectangle Width="30" Height="90"  Fill="#FF801336"/>
                        <Rectangle Width="30" Height="45"  Fill="#EE4540"/>
                        <Rectangle Width="30" Height="120" Fill="#FF9B3D3D"/>
                        <Rectangle Width="30" Height="75"  Fill="#EE4540"/>
                        <Rectangle Width="30" Height="100" Fill="#FF801336"/>
                    </UniformGrid>
                </Grid>
            </Border>
        </Grid>

        <!-- Right Panel: Circular Engagement Indicators -->
        <StackPanel Grid.Row="1" Grid.Column="2" Margin="20" Background="Transparent">
            <TextBlock Text="User Engagement" Foreground="WhiteSmoke" FontSize="20" Margin="0,0,0,20"/>

            <StackPanel Orientation="Horizontal">
                <!-- Circle 1 -->
                <Grid Width="100" Height="100">
                    <Ellipse Fill="#510A32"/>
                    <Ellipse Margin="10" Fill="#670E33"/>
                    <TextBlock Text="75%" Foreground="WhiteSmoke" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
                <!-- Spacer -->
                <Rectangle Width="20" Fill="Transparent"/>
                <!-- Circle 2 -->
                <!-- Circle 2 -->
                <Grid Width="100" Height="100">
                    <Ellipse Fill="#510A32"/>
                    <Ellipse Margin="10" Fill="#C72C41"/>
                    <TextBlock Text="60%" Foreground="WhiteSmoke" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                <!-- Circle 3 -->
                <Grid Width="100" Height="100">
                    <Ellipse Fill="#510A32"/>
                    <Ellipse Margin="10" Fill="#801336"/>
                    <TextBlock Text="85%" Foreground="WhiteSmoke" FontSize="20" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" Grid.ColumnSpan="3" Background="#2D142C" VerticalAlignment="Bottom">
            <!--<TextBlock Text=" 2025 Dashboard Inc. All rights reserved."
                       Foreground="WhiteSmoke"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,10"/>-->
        </Grid>
    </Grid>
</Window>
