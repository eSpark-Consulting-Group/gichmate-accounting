<?xml version="1.0" encoding="utf-8"?>
<Report
  xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition"
  xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner"
  Name="RegisterReport"
  Language="en-US">

	<DataSources>
		<DataSource Name="DataSource1">
			<ConnectionProperties>
				<DataProvider>System.Data.DataSet</DataProvider>
				<ConnectString/>
			</ConnectionProperties>
			<rd:DataSourceID>abc123-def456-ghi789</rd:DataSourceID>
		</DataSource>
	</DataSources>

	<DataSets>
		<DataSet Name="RegistrationDataSet">
			<Fields>
				<Field Name="FirstName">
					<DataField>FirstName</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="LastName">
					<DataField>LastName</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="Email">
					<DataField>Email</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="UserName">
					<DataField>UserName</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
				<Field Name="Password">
					<DataField>Password</DataField>
					<rd:TypeName>System.String</rd:TypeName>
				</Field>
			</Fields>
			<Query>
				<DataSourceName>DataSource1</DataSourceName>
				<CommandText/>
			</Query>
		</DataSet>
	</DataSets>

	<Body>
		<ReportItems>
			<Textbox Name="txtFirstName">
				<Value>=Fields!FirstName.Value</Value>
				<rd:DefaultName>txtFirstName</rd:DefaultName>
			</Textbox>
			<Textbox Name="txtLastName">
				<Value>=Fields!LastName.Value</Value>
				<rd:DefaultName>txtLastName</rd:DefaultName>
			</Textbox>
			<Textbox Name="txtEmail">
				<Value>=Fields!Email.Value</Value>
				<rd:DefaultName>txtEmail</rd:DefaultName>
			</Textbox>
			<Textbox Name="txtUserName">
				<Value>=Fields!UserName.Value</Value>
				<rd:DefaultName>txtUserName</rd:DefaultName>
			</Textbox>
			<Textbox Name="txtPassword">
				<Value>=Fields!Password.Value</Value>
				<rd:DefaultName>txtPassword</rd:DefaultName>
			</Textbox>
		</ReportItems>
		<Height>2in</Height>
	</Body>

	<Width>6.5in</Width>
</Report>