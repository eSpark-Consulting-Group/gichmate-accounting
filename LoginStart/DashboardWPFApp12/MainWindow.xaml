<Window x:Class="DashboardWPFApp12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:DashboardWPFApp12"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        WindowStyle="None"
        Background="Beige">


    <Window.Resources>
        <Style TargetType="Button" x:Key="AnimatedRedButton">
            <Setter Property="Width" Value="75"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF6F0404"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
        CornerRadius="5"
        SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation To="#FFAA0000"
                                    Duration="0:0:0.3"
                                    Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"/>
                                            <DoubleAnimation To="1.2"
                                     Duration="0:0:0.3"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation To="1.2"
                                     Duration="0:0:0.3"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation To="#FF6F0404"
                                    Duration="0:0:0.3"
                                    Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"/>
                                            <DoubleAnimation To="1.0"
                                     Duration="0:0:0.3"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation To="1.0"
                                     Duration="0:0:0.3"
                                     Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="9" Color="White" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid UseLayoutRounding="True">

        <Grid.Background>

            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="105*"/>
            <ColumnDefinition Width="54*"/>
            <ColumnDefinition Width="241*"/>
            <ColumnDefinition Width="400*"/>
        </Grid.ColumnDefinitions>

        <!-- Top navigation bar -->
        <Grid Background="#EE4540" Grid.ColumnSpan="4" Margin="0,0,0,404" Grid.RowSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>


            <Button Margin="10,0,0,0"
                    x:Name="btn_Login"
                    Click="Btn_Login"
                    Grid.Column="7"
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Update" Background="#FF3A0000" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </Grid>

        <!-- Main content -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Grid.ColumnSpan="3">
            <StackPanel Orientation="Horizontal" Margin="30">
                <Image Width="99" Height="99"
					   RenderOptions.BitmapScalingMode="Fant"
                       Source="C:\Users\Dotnet_User1\Source\Repos\DashboardWPFApp12\Images\logo.png"/>

                <TextBlock Text="AccountsPRO"
                           Foreground="White"
                           FontWeight="Medium"
                           FontFamily="Fonts/#font2"
                           VerticalAlignment="Center"
                           FontSize="30"
						   Margin="0,10,10,0"/>
            </StackPanel>
            <TextBlock Text="Welcome to AccountsPRO, your one-stop solution!"
                       Foreground="WhiteSmoke"
                       FontSize="16"
                       FontFamily="Fonts/#myfont"
                       TextWrapping="Wrap" Height="25" Width="360"/>

            <!-- Start Buttons side by side -->
            <StackPanel Orientation="Horizontal" Margin="40,10,0,0">
                <Button x:Name="btn_Start" Content="Start"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Medium"
                        Height="45"
                        Width="112" Click="Btn_Start">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF801336"/>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
									Width="100"
									Height="25"
									CornerRadius="12"
									Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
												  HorizontalAlignment="Center"
												  Content="{TemplateBinding Content}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF9B3D3D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>


                <Button Content="Register"
                    Width="100" Height="25"
                    Margin="0,0,0,0"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Click="Btn_Register">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF801336"/>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                        Property="Background"
                                        Value="#FF9B3D3D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>


        <!--The main design here-->
        <Grid Grid.ColumnSpan="4" Margin="4,-430,-398,372"
			  >

            <Grid.RenderTransform>
                <RotateTransform Angle ="45" />
            </Grid.RenderTransform>

            <StackPanel Orientation ="Horizontal">

                <StackPanel>
                    <Border Width="700" 
							Height="35"
							Background="#510A32"
							Margin="150,0,0,0"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="#801336"
							Margin="0,15,0,0"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="#510A46"
							Margin="75,15,0,0"
							CornerRadius="20"/>
                </StackPanel>
                <StackPanel>
                    <Border Width="700" 
							Height="35"
							Background="#EE4540"
							Margin="150,0,0,0"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="white"
							Margin="0,15,0,0"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="#EE4540"
							Margin="75,15,0,0"
							CornerRadius="20"/>
                    <Border Width="700" 
                        Height="35"
                        Background="#EE4540"
                        CornerRadius="20"/>
                </StackPanel>

            </StackPanel>

        </Grid>
        <Border
            Background="#EE4540"
            CornerRadius="20" Grid.ColumnSpan="3" Margin="45,0,-80,0" RenderTransformOrigin="0.5,0.5" Grid.Column="1">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="45.396"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Border.RenderTransform>
        </Border>


    </Grid>


</Window>