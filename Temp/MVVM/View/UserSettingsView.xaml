<Window x:Class="FlexMold.MVVM.View.UserSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="User Privilege"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Height="700"
        Width="1048">
    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="20">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" Margin="0,0,0,10" Background="White">
            <TextBlock Text="User Privilege Name:" VerticalAlignment="Center" FontWeight="Bold"/>
            <TextBox Width="200" Margin="10,0,0,0"/>
        </StackPanel>


        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,10">
            <CheckBox Content="Enable All" VerticalAlignment="Center" Foreground="White"/>
            <CheckBox Content="Save" Margin="20,0" Foreground="White"/>
            <CheckBox Content="Edit" Margin="20,0" Foreground="White"/>
            <CheckBox Content="Delete" Margin="20,0" Foreground="White"/>
        </StackPanel>


        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Margin="0,0,0,10">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="Enable" Width="60" Binding="{Binding Enable}"/>
                <DataGridTextColumn Header="Menu Name" Width="*" Binding="{Binding MenuName}"/>
                <DataGridTextColumn Header="Menu Title" Width="*" Binding="{Binding MenuTitle}"/>
                <DataGridCheckBoxColumn Header="Save" Width="60" Binding="{Binding Save}"/>
                <DataGridCheckBoxColumn Header="Edit" Width="60" Binding="{Binding Edit}"/>
                <DataGridCheckBoxColumn Header="Delete" Width="60" Binding="{Binding Delete}"/>
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Save" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Delete" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Clear" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Search" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>
    </Grid>
</Window>

 