<UserControl x:Class="AccountsPro.MVVM.View.PropertyManagement.PropertyManagement"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AccountsPro.MVVM.View.PropertyManagement"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             BorderBrush="White"
             BorderThickness="1.7"
             Height="770" 
             Width="1200">
    
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540" Offset="0"/>
                <GradientStop Color="#FFC72C41" Offset="0.2"/>
                <GradientStop Color="#FF801336" Offset="0.4"/>
                <GradientStop Color="#FF670E33" Offset="0.6"/>
                <GradientStop Color="#FF510A32" Offset="0.8"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="350"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="100"/>
            <RowDefinition/>


        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#22FFFFFF"
                    Height="55" Width="1170">
            
            <Label Content="Property Management"
                   FontSize="25" FontWeight="Bold"/>

            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"                    
                    Command="{Binding DefaultAccountScreenCommand}"
                    Margin="830,0,0,0" />
        </StackPanel>


        <StackPanel Grid.Row="2" Width="1170" Background="#22FFFFFF">

            <DataGrid x:Name="PropertyManagementDataGrid"
                      Height="330" Width="1180"
                      Margin="0,10,0,0">                
            </DataGrid>
            
        </StackPanel>


        <StackPanel Grid.Row="3">
            <Label Content="Tenant Information"
                   FontWeight="SemiBold"/>
        </StackPanel>


        <StackPanel Grid.Row="4" Orientation="Horizontal" Width="1170" Height="40" Background="#22FFFFFF">

            <Label Content="Tenant ID :"
                   Margin="48,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <mah:NumericUpDown x:Name="VoucherNoBox"
                   Width="250"                               
                   Height="30" 
                   FontSize="14"
                   VerticalContentAlignment="Center"
                   Minimum="0" Maximum="99999"/>

            <Label Content="Unit No :"
                   Margin="53,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox x:Name="UnitNoComboBox"
                      Margin="2,0,0,0"
                      Style="{StaticResource AccountsComboBox}">              
            </ComboBox>

            <Label Content="Tenant Identity No :"
                   Margin="20,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox  x:Name="TenantIdentityBox"
                      Style="{StaticResource AccountsTextBox}"
                     />

        </StackPanel>


        <StackPanel Grid.Row="5" Orientation="Horizontal" Width="1170" Height="40" Background="#22FFFFFF">

            <Label Content=" Tenant Name : "
                   Margin="20,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="TenantNameTextBox" 
                     Margin="1,0,0,0"
                     Style="{StaticResource AccountsTextBox}"/>
            
            <Label Content=" Tenant Phone :"
                   Margin="20,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="PhoneTextBox" 
                     Margin="1,0,0,0"
                     Style="{StaticResource AccountsTextBox}"/>

            <Label Content="Tenant Email :"
                   Style="{StaticResource AccountsLabel}"
                   Margin="55,0,0,0"/>

            <TextBox x:Name="TenantEmailTextBox"
                     Margin="2,0,0,0"
                     Style="{StaticResource AccountsTextBox}"/>
           
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" Width="1170" Height="40" Background="#22FFFFFF">


            <Label Content="Tenant Start Date : "
                   Margin="2,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <DatePicker x:Name="StartDatePickerBox"
                        Width="250" Height="30"
                        VerticalContentAlignment="Center"/>

            <Label Content="Tenant End Date :"
                   Margin="7,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <DatePicker x:Name="EndDatePickerBox"
                        Width="250" Height="30"
                       VerticalContentAlignment="Center"/>

            <Label Content="Update Time :"
                   Style="{StaticResource AccountsLabel}"
                   Margin="55,0,0,0"/>

            <DatePicker x:Name="UpdateDatePickBox"
                        Width="250"
                        Height="30"
                        VerticalContentAlignment="Center"/>

        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" Width="1170" Height="40" Background="#22FFFFFF"> 
            <CheckBox x:Name="TenantActiveCheckBox" 
                      Margin="128,0,0,0"
                      FontSize="14"
                      Content="Is Tenant Still Active ?"/>
        </StackPanel>

        <StackPanel Grid.Row="8" VerticalAlignment="Center" HorizontalAlignment="Center">

            <StackPanel Orientation="Horizontal">

                <Button x:Name="SaveButton"
                        Content="Save"
                        Style="{StaticResource AnimatedRedButton}"/>

                <Button x:Name="UpdateButton"
                        Content="Update"
                        Style="{StaticResource AnimatedRedButton}"/>

                <Button x:Name="DeleteButton"
                        Content="Delete"
                        Style="{StaticResource AnimatedRedButton}"/>

                <Button x:Name="ClearButton"
                        Content="Clear"
                        Style="{StaticResource AnimatedRedButton}"/>

            </StackPanel>
            
        </StackPanel>
        
        
    </Grid>
    
</UserControl>
