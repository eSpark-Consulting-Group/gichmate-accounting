<Window x:Class="AccountsPro.MVVM.View.PropertyManagement.UtilityPerUnitCostCharges"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccountsPro.MVVM.View.PropertyManagement"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        BorderBrush="White"
        ResizeMode="NoResize"
        BorderThickness="1.7"
        Title="Utility Per Unit Cost Charges"
        Height="680" Width="1200">
    
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540" Offset="0"/>
                <GradientStop Color="#FFC72C41" Offset="0.2"/>
                <GradientStop Color="#FF801336" Offset="0.4"/>
                <GradientStop Color="#FF670E33" Offset="0.6"/>
                <GradientStop Color="#FF510A32" Offset="0.8"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="270"/>
            <RowDefinition Height="60"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        
        <StackPanel Grid.Row="0" Style="{StaticResource AccountsStackPanel}">

            <Label Content="UTILITY COST PER UNIT CHARGES"
                   FontSize="20"
                   FontWeight="Bold"/>

        </StackPanel>


        <StackPanel Grid.Row="1" Style="{StaticResource AccountsStackPanel}">

            <Label Content="Water Charges Per Unit : "
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="WaterChargesPerUnitTxtBox"
                     Width="200"
                     PreviewTextInput ="NumericOnly"
                     MaxLength="5"
                     Style="{StaticResource AccountsTextBox}"/>


            <Label Content="Sanitation Charges Per Unit : "
                   Margin="30,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="SanitationChargesPerUnitTxtBox"
                     Width="200"
                     PreviewTextInput ="NumericOnly"
                     MaxLength="5"
                     Style="{StaticResource AccountsTextBox}"/>

            <Label Content="Gas Charges Per Unit : "
                   Margin="30,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="GasChargesPerUnitTxtBox"
                     Width="200"
                     PreviewTextInput ="NumericOnly"
                     MaxLength="5"
                     Style="{StaticResource AccountsTextBox}"/>

        </StackPanel>


        <StackPanel Grid.Row="2" Style="{StaticResource AccountsStackPanel}">

            <Label Content="TV Charges Per Unit : "
                   Margin="20,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="TVChargesPerUnitTxtBox"
                     Width="200"
                     PreviewTextInput ="NumericOnly"
                     MaxLength="5"
                     Style="{StaticResource AccountsTextBox}"/>
            
            <Label Content="Electricity Charges Per Unit : "
                   Margin="35,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="ElectricityChargesPerUnitTxtBox"
                     Width="200"
                     PreviewTextInput ="NumericOnly"
                     MaxLength="5"
                     Style="{StaticResource AccountsTextBox}"/>


            <Label Content="Internet Charges Per Unit : "
                   Margin="4,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="InternetChargesPerUnitTxtBox"
                     Width="200"
                     PreviewTextInput ="NumericOnly"
                     MaxLength="5"
                     Style="{StaticResource AccountsTextBox}"/>

        </StackPanel>
        
        
        <StackPanel Grid.Row="3" Style="{StaticResource AccountsStackPanel}">


            <Label Content="MISC Charges Per Unit : "
                   Margin="5,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="MiscChargesPerUnitTxtBox"
                     Width="200"
                     PreviewTextInput ="NumericOnly"
                     MaxLength="5"
                     Style="{StaticResource AccountsTextBox}"/>



            <Label Content="Laundry Charges Per Unit : "
                   Margin="45,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="LaundryChargesPerUnitTxtBox"
                     Width="200"
                     PreviewTextInput ="NumericOnly"
                     MaxLength="5"
                     Style="{StaticResource AccountsTextBox}"/>

          
        </StackPanel>

        <StackPanel Grid.Row="4" Style="{StaticResource AccountsStackPanel}">

            <StackPanel Orientation="Horizontal">
                
            <Button x:Name="ClearBtn"
                    Content="Clear all fields"
                    Width="120"
                    Margin="790,0,0,0"
                    Style="{StaticResource AnimatedRedButton}"
                    Click="ClearBtn_Click"/>
            
            <Button x:Name="SaveCurrentChargesBtn" Content="Set As Current Charges Per Unit"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="20,0,0,0"
                    Style="{StaticResource AnimatedRedButton}"
                    Width="220"
                    Click="SaveCurrentChargesBtn_Click"/>
        </StackPanel>
            
        </StackPanel>


        <StackPanel Grid.Row="5" Width="1170" 
                    Background="#22FFFFFF">

            <DataGrid  x:Name="UtilityCostPerUnitChargesGrid"
                       Height="250"
                Margin="0,10,0,0">
                
            </DataGrid>
        </StackPanel>
        

        <StackPanel Grid.Row="6" Style="{StaticResource AccountsStackPanel}">

            <Button x:Name="UpdateCurrentChargesBtn" Content="Update Current Charges Per Unit"
                    VerticalContentAlignment="Center"
                    HorizontalAlignment="Center"
                    Margin="930,0,0,0"
                    Style="{StaticResource AnimatedRedButton}"
                    Width="220"
                    Click="UpdateCurrentChargesBtn_Click"/>

        </StackPanel>



    </Grid>
</Window>
