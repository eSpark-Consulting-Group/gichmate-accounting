<UserControl x:Class="AccountsPro.MVVM.View.PropertyManagement.HistoricalBalance"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AccountsPro.MVVM.View.PropertyManagement"
             mc:Ignorable="d" 
             BorderBrush="White"
             BorderThickness="1.7"
             Height="770" 
             Width="1200">    
    
    
    <Grid>        
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540" Offset="0"/>
                <GradientStop Color="#FFC72C41" Offset="0.2"/>
                <GradientStop Color="#FF801336" Offset="0.4"/>
                <GradientStop Color="#FF670E33" Offset="0.6"/>
                <GradientStop Color="#FF510A32" Offset="0.8"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>            
            <RowDefinition Height="400"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        
        
        <StackPanel Grid.Row="0"
                    Orientation="Horizontal"
                    Height="55"
                    Width="1170" 
                    Background="#22FFFFFF">

            <Label Content="Historical Balance Tracking Across Months"
                   FontSize="25"
                   FontWeight="Bold"/>

            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"                    
                    Command="{Binding DefaultAccountScreenCommand}"
                    Margin="600,0,0,0" />            
        </StackPanel>


        <StackPanel Grid.Row="1" 
                    Style="{StaticResource AccountsStackPanel}">

            <Label Content="📅 From Month :"
                   Margin="180,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <DatePicker x:Name="FromMonthDatePicker"
                        Width="250"
                        Height="30" VerticalContentAlignment="Center"
                        FontSize="14"/>


            <Label Content="📅 To Month :"
                   Margin="30,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <DatePicker x:Name="ToMonthDatePicker"
                        Width="250"
                        Height="30" VerticalContentAlignment="Center"
                        FontSize="14"/>
        </StackPanel>


        <StackPanel Grid.Row="2"
                    Style="{StaticResource AccountsStackPanel}">

            <Label Content="👤 Tenant Name :"
                   Margin="177,0,0,0"
                   Style="{StaticResource AccountsLabel}"
                   />

            <ComboBox x:Name="TenantNameComboBox"
                     Style="{StaticResource AccountsComboBox}"/>
        </StackPanel>


        <StackPanel Grid.Row="3"
                    Height="380"
                    Width="1170"
                    Background="#22FFFFFF">

            <DataGrid x:Name="HistoricalBalanceDataGrid"
                      Height="360"
                      Width="1160"
                      Margin="0,10,0,0">
                
            </DataGrid>
            
        </StackPanel>
        

    </Grid>
</UserControl>
