<UserControl x:Class="AccountsPro.MVVM.View.PropertyManagement.ArrearsAgingAnalysis"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AccountsPro.MVVM.View.PropertyManagement"
             mc:Ignorable="d" 
             BorderBrush="White"
             BorderThickness="1.7"
             Height="770" 
             Width="1200">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540" Offset="0"/>
                <GradientStop Color="#FFC72C41" Offset="0.2"/>
                <GradientStop Color="#FF801336" Offset="0.4"/>
                <GradientStop Color="#FF670E33" Offset="0.6"/>
                <GradientStop Color="#FF510A32" Offset="0.8"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#22FFFFFF" Height="55" Width="1170">
            <Label Content="Arrears Aging Analysis"
                   FontSize="25"
                   FontWeight="Bold"/>

            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"                    
                    Command="{Binding DefaultAccountScreenCommand}"
                    Margin="840,0,0,0" />
        </StackPanel>


        <StackPanel Grid.Row="1" Style="{StaticResource AccountsStackPanel}">

            <Label Content="📅 Month : "
                       Style="{StaticResource AccountsLabel}"
                       Margin="30,0,0,0"/>

            <ComboBox x:Name="MonthsComboBox"
                      HorizontalContentAlignment="Center"
                      Style="{StaticResource AccountsComboBox}"
                      IsEditable="False"/>

            <Label Content="📊 Arrears Aging :"
                   Style="{StaticResource AccountsLabel}"
                   Margin="30,0,0,0"/>
            <ComboBox x:Name="ArrearsAgingComboBox"
                      HorizontalContentAlignment="Center"
                      Style="{StaticResource AccountsComboBox}"
                      IsEditable="False"
                      >      

                <ComboBoxItem Content="30 Days"/>
                <ComboBoxItem Content="60 Days"/>
                <ComboBoxItem Content="90 Days"/>
            </ComboBox>

            <Label Content="👤 Tenant :"
                   Style="{StaticResource AccountsLabel}"
                   Margin="30,0,0,0"/>
            
            <TextBox x:Name="TenantNameTextBox"
                     Style="{StaticResource AccountsTextBox}"/>

        </StackPanel>

        <StackPanel Grid.Row="3"
                    Height="380"
                    Width="1170"
                    Background="#22FFFFFF">
            
            <DataGrid x:Name="TenantsDataGrid"
                      Margin="0,10,0,0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      Height="360" Width="1150">
                
            </DataGrid>
        </StackPanel>

        <StackPanel Grid.Row="4" 
                    Orientation="Horizontal" 
                    Background="#22FFFFFF"
                    Height="80"
                    Width="1170">

            <Button Content="Send Reminder Emails"
                    Width="170"
                    Height="45"
                    Margin="400,0,0,0"
                    Style="{StaticResource AnimatedRedButton}"/>

            <Button Content="Export to CSV"
                    Width="170"
                    Height="45"
                    Margin="20,0,0,0"
                    Style="{StaticResource AnimatedRedButton}"/>

        </StackPanel>
        
        
        

        
        
    </Grid>
</UserControl>
