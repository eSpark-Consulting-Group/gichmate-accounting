<UserControl x:Class="AccountsPro.MVVM.View.PropertyManagement.ArrearsAgingAnalysis"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AccountsPro.MVVM.View.PropertyManagement"
             mc:Ignorable="d" 
             BorderBrush="White"
             BorderThickness="1.7"
             Height="770" 
             Width="1200">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540" Offset="0"/>
                <GradientStop Color="#FFC72C41" Offset="0.2"/>
                <GradientStop Color="#FF801336" Offset="0.4"/>
                <GradientStop Color="#FF670E33" Offset="0.6"/>
                <GradientStop Color="#FF510A32" Offset="0.8"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="80"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Background="#22FFFFFF" Height="55" Width="1170">
            <Label Content="Arrears Aging Analysis"
                   FontSize="25"
                   FontWeight="Bold"/>

            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"                    
                    Command="{Binding DefaultAccountScreenCommand}"
                    Margin="840,0,0,0" Click="Close_Click" />
        </StackPanel>


        <StackPanel Grid.Row="1" Style="{StaticResource AccountsStackPanel}">

            <Label Content="📅 Month : "
                       Style="{StaticResource AccountsLabel}"
                       Margin="30,0,0,0"/>

            <ComboBox x:Name="MonthsComboBox"
                      HorizontalContentAlignment="Center"
                      Style="{StaticResource AccountsComboBox}"
                      IsEditable="False"/>

            <Label Content="📊 Arrears Aging :"
                   Style="{StaticResource AccountsLabel}"
                   Margin="30,0,0,0"/>
            <ComboBox x:Name="ArrearsAgingComboBox"
                      HorizontalContentAlignment="Center"
                      Style="{StaticResource AccountsComboBox}"
                      IsEditable="False"
                      >
                <ComboBoxItem Content=" All"/>
                <ComboBoxItem Content=" 1 - 30 Days"/>
                <ComboBoxItem Content=" 31 - 60 Days"/>
                <ComboBoxItem Content=" 61 - 90 Days"/>
                <ComboBoxItem Content=" 90+ Days"/>
            </ComboBox>

            <Label Content="👤 Tenant :"
                   Style="{StaticResource AccountsLabel}"
                   Margin="30,0,0,0"/>
            
            <ComboBox x:Name="TenantNameComboBox"
                     Style="{StaticResource AccountsComboBox}"/>

        </StackPanel>


        <StackPanel Grid.Row="2" Style="{StaticResource AccountsStackPanel}">

            <Label Content="🔍  Unit No : "
                   Style="{StaticResource AccountsLabel}"
                   Margin="17,0,0,0"/>

            <ComboBox x:Name="UnitNoComboBox"
                      Style="{StaticResource AccountsComboBox}"/>

            <Button x:Name="ClearBtn"
                    Content="Clear"                    
                    Style="{StaticResource AnimatedRedButton}"
                    Margin="700,0,0,0"
                    Click="ClearBtn_Click"/>
        </StackPanel> 
       

        <StackPanel Grid.Row="3"
                    Height="380"
                    Width="1170"
                    Background="#22FFFFFF">

            <DataGrid x:Name="TenantsDataGrid"
                      Margin="0,10,0,0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Center"
                      HorizontalContentAlignment="Center"
                      Height="360" Width="1150"
                      AutoGenerateColumns="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      IsReadOnly="True">
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextBlock.TextAlignment" Value="Center"/>
                    </Style>
                </DataGrid.CellStyle>
            </DataGrid>


        </StackPanel>


        <StackPanel Grid.Row="4" Style="{StaticResource AccountsStackPanel}">

            <Label Content="Total Amount of Arrears in selected range : "
                   Style="{StaticResource AccountsLabel}"/>
            
            <TextBox x:Name="TotalArrearsAmountTxt" Style="{StaticResource AccountsTextBox}"/>

        </StackPanel>
        
        <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    Background="#22FFFFFF"
                    Height="70"
                    Width="1170">

            <Button Content="Send Reminder Emails"
                    Width="170"
                    Margin="400,0,0,0"
                    Style="{StaticResource AnimatedRedButton}"
                    Click="SendReminderEmails_Click"/>

            <Button Content="Export to CSV"
                    Width="170"
                    Margin="20,0,0,0"
                    Style="{StaticResource AnimatedRedButton}"
                    Click="ExportToCsv_Click"/>

        </StackPanel>
        
        
        

        
        
    </Grid>
</UserControl>
