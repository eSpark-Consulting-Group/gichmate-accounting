<Window x:Class="FlexMold.MVVM.View.Master.SearchBank"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Master"
        mc:Ignorable="d"
        ResizeMode="NoResize"        
        BorderBrush="Black"
        BorderThickness="3"
        Title="SearchBank" Height="600" Width="950">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="10"/>
            <RowDefinition Height="0"/>
            <!--This Row (Row 1) is only added for marginal aesthetics only-->
            <RowDefinition Height="50"/>
            <RowDefinition Height="440"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">

            <Label x:Name="SearchLabel" Content="Search"
                   FontSize="14" VerticalAlignment="Center"/>

            <TextBox x:Name="SearchTextBox" Width="500"
                     Height="30"
                     VerticalContentAlignment="Center"/>

        </StackPanel>


        <StackPanel Grid.Row="3">

            <DataGrid x:Name="AccountsDataGrid" 
                      Width="930" HorizontalAlignment="Center" Height="440"
                      AutoGenerateColumns="True">
            </DataGrid>

        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,30,0" VerticalAlignment="Center">
            <Button Content="Select" 
                    FontSize="14"
                    Background="ForestGreen" 
                    Style="{StaticResource AnimatedRedButton}"
                    Click="SelectButton"/>

            <Button Content="Delete"
                    FontSize="14"
                    Background="ForestGreen" 
                    Style="{StaticResource AnimatedRedButton}"
                    Click="DeleteButton"/>

            <Button Content="Cancel"
                    FontSize="14" 
                    Background="ForestGreen" 
                    Style="{StaticResource AnimatedRedButton}"
                    Click="CancelButton"/>

            <Button Content="Clear"
                    FontSize="14"
                    Background="ForestGreen" 
                    Style="{StaticResource AnimatedRedButton}"
                    Click="ClearButton"/>
        </StackPanel>




    </Grid>
</Window>

