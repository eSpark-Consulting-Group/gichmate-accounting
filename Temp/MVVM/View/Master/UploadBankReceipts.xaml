<Window x:Class="FlexMold.MVVM.View.Master.UploadBankReceipts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Master"
        BorderBrush="White"
        BorderThickness="1.7"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="Upload Bank Receipts"
        Height="770" Width="1200">

    <Grid>

        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>           
            <RowDefinition Height="630"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" >
            <Label Style="{StaticResource AccountsLabel}"
                   Content="Upload Bank Receipts"
                   FontSize="22" FontWeight="Bold"/>
        </StackPanel>

       
        <StackPanel Grid.Row="1" Margin="10,10,10,10" >

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6" HorizontalAlignment="Center">

                    <Label Content="Search : " VerticalAlignment="Center" Style="{StaticResource AccountsLabel}" />

                    <TextBox x:Name="SearchTextBox" Width="300" Height="28" Margin="6,0,0,0" VerticalContentAlignment="Center"
                              />

                    <Button x:Name="SearchBtn" 
                            Content="Load" 
                            Style="{StaticResource AnimatedRedButton}"
                            Margin="20,0,0,0" Click="SearchBtn_Click"/>

                </StackPanel>

                <DataGrid x:Name="BankReceiptsDataGrid"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          HorizontalContentAlignment="Center"
                          TextBlock.TextAlignment="Center"
                          IsReadOnly="True"
                          Height="560"
                          Margin="0,0,0,0"
                          SelectionMode="Extended" />
            </DockPanel>
        </StackPanel>




            <Button x:Name="LoadFile" Content="Load File"
                    Grid.Row="3"
                    FontSize="20"
                    Style="{StaticResource AnimatedRedButton}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="150"
                    
                    Click="LoadFileBtn_Click"/>
        
    
    </Grid>
</Window>
