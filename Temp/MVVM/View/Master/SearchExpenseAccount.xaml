<Window x:Class="FlexMold.MVVM.View.Master.SearchExpenseAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Master"
        mc:Ignorable="d"
        ResizeMode="NoResize"       
        BorderBrush="Black"
        BorderThickness="3"
        Title="Search" Height="600" Width="800">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="0"/>
            <!--This Row (Row 1) is only added for marginal aesthetics only-->
            <RowDefinition Height="50"/>
            <RowDefinition Height="410"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0" HorizontalAlignment="Left">

            <Label Content="Search"
                   FontSize="25"
                   FontWeight="Bold"/>

        </StackPanel>


        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">

            <Label x:Name="SearchLabel" Content="Search"
                   FontSize="14" VerticalAlignment="Center"/>

            <TextBox x:Name="SearchTextBox" Width="500"
                     Height="30"
                     VerticalContentAlignment="Center"/>

        </StackPanel>

        

        <StackPanel Grid.Row="3">

            <DataGrid x:Name="SearchExpenseDataGrid" Width="780" HorizontalAlignment="Center" Height="410" 
                      SelectionChanged="DataGrid_SelectionChanged" AutoGenerateColumns="False">
                
                <DataGrid.Columns>
                    <DataGridTextColumn Width="50" Header="ID" Binding="{Binding ID}"/>
                    <DataGridTextColumn Width="250" Header="Account Name" Binding="{Binding AccountName}"/>
                    <DataGridTextColumn Width="*" Header="Account Group" Binding="{Binding AccountGroup}"/>
                </DataGrid.Columns>
                
            </DataGrid>

        </StackPanel>

        
        
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,30,0" VerticalAlignment="Center">

            <Button Content="Select" 
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}"
                    Click="SelectButton"/>

            <Button Content="Cancel"
                    FontSize="14"  
                    Style="{StaticResource AnimatedRedButton}"
                    Click="CancelButton"/>

            <Button Content="Delete"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}"
                    Click="DeleteButton"/>


        </StackPanel>




    </Grid>
</Window>

