<Window x:Class="FlexMold.MVVM.View.Master.TransactionWithoutInventory"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Master"
        BorderBrush="White"
        ResizeMode="NoResize"
        BorderThickness="1.7"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="Transaction Without inventory"
        Height="770" Width="1200">


    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>


        <StackPanel VerticalAlignment="Center" Orientation="Vertical" >
            <Label Content="Transaction Without Inventory"
                   FontSize="20" FontWeight="Bold"/>

            <Border Background="White"
                    Height="3"
                    Width="1250"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" >
            <Label Style="{StaticResource AccountsLabel}"
                   Content="Date : "
                   Margin="50,0,0,0"/>
            <DatePicker VerticalContentAlignment="Center"
                        Width="250"
                        Height="30"
                        FontSize="14"/>

            <Label Content="Voucher Type : "
                   Margin="70,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox Width="250"
                      Height="30"/>
        </StackPanel>



        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" >
            <Label Style="{StaticResource AccountsLabel}"
                   Content="Account :"
                   Margin="25,0,0,0"/>

            <ComboBox VerticalContentAlignment="Center"
                        Width="250"
                        Height="30"
                        FontSize="14"/>

            <Label Content="Party A/c : "
                   Margin="94,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox Width="250"
                      Height="30"/>
        </StackPanel>



        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" >
            <Label Style="{StaticResource AccountsLabel}"
                   Content="Ref No :"
                   Margin="35,0,0,0"/>

            <TextBox VerticalContentAlignment="Center"
                        Width="250"
                        Height="30"
                        FontSize="14"/>

            <Label Content="Amount : "
                   Margin="100,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox Width="250"
                     VerticalContentAlignment="Center"
                     Height="30"
                     FontSize="14"                     
                     PreviewTextInput="TransactionAmount_TextPreviewInput"/>


            <Label Content="Remarks :"
                   Margin="25,0,0,0"
                   Style="{StaticResource AccountsLabel}"
                    />

            <TextBox Width="250"
                     Height="30"
                     FontSize="14"
                      />
        </StackPanel>


        <StackPanel Grid.Row="4" Orientation="Horizontal" Grid.ColumnSpan="2" Margin="0,0,0,50" >


        </StackPanel>


        <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    VerticalAlignment="Center"
                    Margin="100,0,0,0" Grid.ColumnSpan="2">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Save"
                        Style="{StaticResource AnimatedRedButton}"/>

                <Button Content="Delete"
                        Style="{StaticResource AnimatedRedButton}"/>

                <Button Content="Clear"
                        Style="{StaticResource AnimatedRedButton}"/>
            </StackPanel>

            <Label Content="Reports : "
                   Margin="118,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox Width="250"
                      Height="30"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      FontSize="14"/>

            <Button Content="Show"
                    Margin="20,0,0,0"
                    Style="{StaticResource AnimatedRedButton}"/>

        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center" >
            <Border Width="100"
                    Height="3"
                    Background="White"/>
            <Label Content="Search"
                   FontSize="9"
                   VerticalAlignment="Top"/>
            <Border Width="1100"
                    Background="White"
                    Height="3"/>
        </StackPanel>



        <StackPanel Grid.Row="7" Orientation="Horizontal" VerticalAlignment="Top" Grid.RowSpan="2">
            <Label Style="{StaticResource AccountsLabel}"
                   Margin="55,0,0,0"
                   Content="From :  "/>

            <DatePicker VerticalContentAlignment="Center"
                        Width="250" 
                        Height="30"
                        FontSize="14"/>

            <Label Content="To : "
                   Margin="131,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <DatePicker Width="250"
                        Height="30"
                        VerticalContentAlignment="Center"
                        FontSize="14"/>
        </StackPanel>


        <StackPanel Grid.Row="9" Orientation="Horizontal" VerticalAlignment="Center" >
            <Label Style="{StaticResource AccountsLabel}"
           Content="Voucher Type : "/>
            <ComboBox VerticalContentAlignment="Center"
                Width="250"
                Height="30"
                FontSize="14"/>

            <Label Content="Party A/c :"
                   Margin="86,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox Width="250"
                      Height="30"
                      VerticalContentAlignment="Center"
                      FontSize="14"/>

            <Label Content="Ref No : "
                   Margin="35,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox Width="250"
                      Height="30"
                      VerticalContentAlignment="Center"
                      FontSize="14"/>

        </StackPanel>


        <StackPanel Grid.Row="10" Grid.ColumnSpan="2">
            
            <DataGrid Height="300" 
                      HorizontalContentAlignment="Center"
                      TextBlock.TextAlignment="Center">
                
                <DataGrid.Columns >
                    <DataGridTextColumn Width="140" Header="             Date"/>
                    <DataGridTextColumn Width="140" Header="     Voucher Type"/>
                    <DataGridTextColumn Width="110" Header=" Voucher No"/>
                    <DataGridTextColumn Width="140" Header="           Ref No"/>
                    <DataGridTextColumn Width="140" Header="      Particulars"/>
                    <DataGridTextColumn Width="140" Header="     Opp Account"/>
                    <DataGridTextColumn Width="140" Header="          Amount"/>
                    <DataGridTextColumn Width="*" Header=" Narration"/>
                </DataGrid.Columns>
            
            </DataGrid>
        </StackPanel>


        <StackPanel Grid.Row="11" Orientation="Horizontal" VerticalAlignment="Center">

            <Label Style="{StaticResource AccountsLabel}"
                   Content="Cash : "
                   Margin="40,0,0,0"/>

            <TextBox Text="0.00 "
                     Width="250"
                     Height="14"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <Label Style="{StaticResource AccountsLabel}"
                   Margin="40,0,0,0"
                   Content="Bank : "/>

            <TextBox Text="0.00 "
                     Width="250"
                     Height="14"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <Label Style="{StaticResource AccountsLabel}"
                   Margin="40,0,0,0"
                   Content="Payable : "/>

            <TextBox Text="0.00 "
                     Width="250"
                     Height="14"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="12" Orientation="Horizontal" VerticalAlignment="Center">


            <Label Style="{StaticResource AccountsLabel}"
           
                    Content=" Sale : "
                   Margin="40,0,0,0"/>

            <TextBox Text="0.00 "
                      Width="250"
                      Height="14"
                      FontSize="14"
                      VerticalContentAlignment="Center">
                <TextBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="-0.112"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TextBox.RenderTransform>
            </TextBox>

            <Label Style="{StaticResource AccountsLabel}"
                   Margin="15,0,0,0"
                   Content="Purchase : "/>

            <TextBox Text="0.00 "
                     Width="250"
                     Height="14"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <Label Style="{StaticResource AccountsLabel}"
                   Margin="38,0,0,0"
                   Content="Expense : "/>

            <TextBox Text="0.00 "
                     Width="250"
                     Height="14"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="13" Orientation="Horizontal">

            <Label Style="{StaticResource AccountsLabel}"
                   Margin="5,0,0,0"
                   Content="Receivable : "/>

            <TextBox Text="0.00 "
                     Width="250"
                     Height="14"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>
        </StackPanel>



    </Grid>
</Window>