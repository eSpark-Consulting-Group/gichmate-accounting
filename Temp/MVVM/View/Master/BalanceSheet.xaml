<Window x:Class="AccountsPRO.MVVM.View.Master.BalanceSheet"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccountsPRO.MVVM.View.Master"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        BorderThickness="3"
        BorderBrush="White"
        WindowStartupLocation="CenterScreen"
        Title="BalanceSheet" Height="770" Width="1200">

    <Window.Resources>
        <Style TargetType="{x:Type Label}" x:Key="LabelBalanceSheet">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="StackPanel" x:Key="StackPanelBalanceSheet">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="TextBox" x:Key="TextboxBalanceSheet">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="200"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox" x:Key="ComboBoxBalanceSheet">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Width" Value="250"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>


    <Grid>
       
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="550"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" >
            <Label Content="Balance Sheet"
                   FontSize="20"
                   FontWeight="Bold"/>
        </StackPanel>



        <StackPanel Grid.Row="1" 
                    Style="{StaticResource StackPanelBalanceSheet}" HorizontalAlignment="Left" Margin="188,0,0,0"
                    >

            <Label Content="As on : "
                   Margin="75,0,0,0"
                   Style="{StaticResource LabelBalanceSheet}"/>

            <DatePicker x:Name="dtmDate" 
                        Height="30"
                        Width="250"
                        VerticalContentAlignment="Center"
                        SelectedDate="{x:Static sys:DateTime.Now}"/>

            <Button Style="{StaticResource AnimatedRedButton}"
                    Content="Load"
                    FontSize="15"        
                    Margin="40,0,0,0"
                    Click="Button_Click" />

        </StackPanel>

        <StackPanel Grid.Row="2"
                   Style="{StaticResource StackPanelBalanceSheet}" Orientation="Horizontal">


            <Label Content="Closing Stock Validation Using : " 
                   Style="{StaticResource LabelBalanceSheet}"
                   Margin="0,0,0,0"/>

            <ComboBox x:Name="ClosingValidationComboBox" Style="{StaticResource ComboBoxBalanceSheet}"/>

            
            <Label Content="Opening Stock Validation Using : "
                   Style="{StaticResource LabelBalanceSheet}"
                   Margin="30,0,0,0"/>

            <ComboBox x:Name="cmbOppStock" Style="{StaticResource ComboBoxBalanceSheet}"
                      />
        </StackPanel>



        <StackPanel Grid.Row="3" Style="{StaticResource StackPanelBalanceSheet}" HorizontalAlignment="Left" Margin="2,0,0,0">
          
            
            <RichTextBox Name="rchTransdtls" 
                         Height="550" 
                         Width="1190"
                         AcceptsReturn="True"
                         HorizontalScrollBarVisibility="Disabled" 
                         VerticalScrollBarVisibility="Auto"
                         BorderBrush="White"
                         BorderThickness="3"
                         FontSize="15" 
                         FontStyle="Normal" >
                
            </RichTextBox>
            
            
        </StackPanel>


        <StackPanel Grid.Row="4" Style="{StaticResource StackPanelBalanceSheet}" HorizontalAlignment="Left" Margin="437,0,0,0">
            <StackPanel Style="{StaticResource StackPanelBalanceSheet}">

                <Button Style="{StaticResource AnimatedRedButton}"
                        Content="Show"
                        FontSize="15"             
                        Click="Button_Click" />

                <Button Style="{StaticResource AnimatedRedButton}"
                        Content="Print"
                        FontSize="15"        
                        Click="printDocument1_PrintPage_Click"/>

                <Button Style="{StaticResource AnimatedRedButton}"
                        Content="Clear"
                        FontSize="15"
                        Click="ClearWindow_Click"/>

                <Button Style="{StaticResource AnimatedRedButton}"
                        Content="Close"
                        FontSize="15"
                        Click="CloseWindow_Click" />

            </StackPanel>            
        </StackPanel>
    </Grid>
    
</Window>