<Window x:Class="FlexMold.MVVM.View.Master.Bank"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Master"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        BorderBrush="Black"
        BorderThickness="3"
        mc:Ignorable="d"
        Height="950" Width="850">



    <Window.Resources>
        <Style TargetType="{x:Type TextBox}" x:Key="MyTextbox">
            <Setter Property="Width" Value="250" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#FFEE4540"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="{x:Type Label}" x:Key="MyLabel">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="30" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="0,0,0,-2">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="230"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,83" Grid.RowSpan="2">
            <Label Content="BANK"
                   FontSize="25"
                   FontWeight="Bold"/>

        </StackPanel>

        <StackPanel Grid.Column="0" 
                    Grid.Row="1" 
                    Grid.RowSpan="16" Margin="0,0,0,-159"
                    >
            <Border BorderThickness="1000" Height="882">
                <Border.BorderBrush>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF5B0000" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                        <GradientStop Color="Red" Offset="0.269"/>
                        <GradientStop Color="#FFFFADAD" Offset="0.516"/>
                        <GradientStop Color="White" Offset="0.685"/>
                        <GradientStop Color="White" Offset="0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
        </StackPanel>


        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">

            <StackPanel Orientation="Horizontal" Height="40">

                <Label Margin="26.5,0,0,0"
                       Content="Account Name :"
                       FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="AccountName" 
                         Margin="10,0,0,0" 
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Height="30"
                         Width="400"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Height="40">

                <Label Content="Accounting Group :"
                       FontSize="14"
                       VerticalAlignment="Center"/>
                <ComboBox x:Name="AccountGroupComboBox" 
                          Margin="5,0,0,0"
                          Width="362" VerticalContentAlignment="Center"
                          Height="30" VerticalAlignment="Center">
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                </ComboBox>

                <Button Content="+" 
                        FontSize="15" 
                        Background="#FF008800" 
                        Foreground="White" 
                        Height="27" 
                        Width="28"
                        Style="{StaticResource AnimatedRedButton}"
                        VerticalContentAlignment="Center" 
                        Click="Button_Click">

                </Button>

            </StackPanel>


            <StackPanel Orientation="Horizontal" Height="40">

                <Label Margin="13,0,0,0"
                       VerticalAlignment="Center"
                       Content="Opening Balance :"
                       FontSize="14"/>

                <TextBox x:Name="OpeningBalanceTextBox" Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         Text="0" 
                         Width="200" 
                         VerticalContentAlignment="Center"/>

                <ComboBox x:Name="DrCrComboBox" Margin="17,0,0,0" Width="100" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <ComboBoxItem IsSelected="True" Content="DR" />
                    <ComboBoxItem Content="CR"/>
                </ComboBox>

                <CheckBox x:Name="ActiveCheckbox"  Margin="17,0,0,0" Content="Active"
                          FontSize="14" Width="96"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Height="40">

                <Label Margin="88,0,0,0"
                       Content="Date :"
                       VerticalAlignment="Center"
                       FontSize="14"/>

                <DatePicker x:Name="DatePickBox" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" 
                            Height="30"
                            Width="200"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="40">

                <Label Margin="47,0,0,0" Content="Description :"
                       FontSize="14"
                       VerticalAlignment="Center"/>

                <TextBox x:Name="DescriptionInputBox" Width="400"
                         Height="30"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Text=""/>

            </StackPanel>
        </StackPanel>


        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

            <Border BorderBrush="White"
                    BorderThickness="2" 
                    Width="30"
                    Height="3"
                    VerticalAlignment="Center"/>
            <Label Content="Contact Details"
                   FontWeight="Bold"
                   Style="{StaticResource MyLabel}"/>
            <Border BorderBrush="White"
                    BorderThickness="3"
                    Width="500"
                    Height="3"/>

        </StackPanel>



        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
            <Label Margin="30,0,0,0" 
                   Content="Road :"
                   Style="{StaticResource MyLabel}"/>

            <TextBox x:Name="RoadTextBox" Style="{StaticResource MyTextbox}"
                     Margin="60,0,0,0"
                     />
        </StackPanel>

        <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">

            <Label Margin="30,0,0,0"
                   Content="Building :"
                   Style="{StaticResource MyLabel}"/>

            <TextBox x:Name="BuildingTextBox" Style="{StaticResource MyTextbox}"
                     Margin="42,0,0,0"/>

        </StackPanel>


        <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal">

            <Label Content="Block :" 
                   Style="{StaticResource MyLabel}"
                   Margin="30,0,0,0"/>

            <TextBox x:Name="BlockTextBox" Style="{StaticResource MyTextbox}"
                     Margin="60,0,0,0"/>
        </StackPanel>


        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">

            <Label Content="Phone No :"
                   Margin="30,0,0,0"
                   Style="{StaticResource MyLabel}"/>

            <TextBox x:Name="PhoneTextBox" Margin="32,0,0,0"
                     Style="{StaticResource MyTextbox}"/>
        </StackPanel>


        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal">

            <Label Content="Mobile No :"
                   Style="{StaticResource MyLabel}"
                   Margin="30,0,0,0"/>
            <TextBox x:Name="MobileTextBox"
                     Margin="28,0,0,0"
                     Style="{StaticResource MyTextbox}"/>

        </StackPanel>


        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal">

            <Label Content="Fax :"
                   Margin="30,0,0,0"
                   Style="{StaticResource MyLabel}"/>
            <TextBox x:Name="FaxTextBox" Style="{StaticResource MyTextbox}"
                     Margin="74,0,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="9" Grid.Column="1" Orientation="Horizontal">

            <Label Margin="30,0,0,0"
                   Content="Email Address :"
                   Style="{StaticResource MyLabel}"/>

            <TextBox x:Name="EmailAddressTextBox" Style="{StaticResource MyTextbox}"
                     Margin="8,0,0,0"/>
        </StackPanel>


        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal">

            <Label Content=" GST No :"
                   Margin="30,0,0,0"
                   Style="{StaticResource MyLabel}"/>

            <TextBox x:Name="GSTNoTextBox" Style="{StaticResource MyTextbox}"
                     Margin="45,0,0,0"/>

        </StackPanel>


        <StackPanel Grid.Row="11" Grid.Column="1" Orientation="Horizontal">

            <Border BorderBrush="White"
                    BorderThickness="3"
                    Height="3"
                    Width="30"/>
            <Label Content="Bank Details"
                   Style="{StaticResource MyLabel}"/>
            <Border BorderBrush="White"
                    BorderThickness="3"
                    Height="3"
                    Width="500"/>
        </StackPanel>

        <StackPanel Grid.Row="12" Grid.Column="1" Orientation="Horizontal">

            <Label Content="Bank Name :"
                   Margin="30,0,0,0"
                   Style="{StaticResource MyLabel}"/>

            <TextBox x:Name="BankNameTextBox" Style="{StaticResource MyTextbox}"
                     Margin="27,0,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="13" Grid.Column="1" Orientation="Horizontal">

            <Label Content="Address :"
                   Margin="30,0,0,0"
                   Style="{StaticResource MyLabel}"/>

            <TextBox x:Name="BankDetailsAddress" Style="{StaticResource MyTextbox}"
                     Margin="48,0,0,0"/>

        </StackPanel>


        <StackPanel Grid.Row="14" Grid.Column="1" Orientation="Horizontal">

            <Label Content="Account No. :"
                   Style="{StaticResource MyLabel}"
                   Margin="30,0,0,0"/>

            <TextBox x:Name="AccountNoTextBox" Style="{StaticResource MyTextbox}"
                     Margin="22,0,0,0"/>
        </StackPanel>










        <StackPanel Grid.Row="16" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" >

            <Button Content="Save" 
                    FontSize="14" 
                    Style="{StaticResource AnimatedRedButton}"/>

            <Button Content="Delete"
                    FontSize="14" 
                    Style="{StaticResource AnimatedRedButton}"/>

            <Button Content="New"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}"/>

            <Button Content="Search"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}" Click="SearchButton_Click"/>

            <Button x:Name="ClearButton" Content="Clear"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}" Click="ClearButton_Click"/>

        </StackPanel>

    </Grid>
</Window>

