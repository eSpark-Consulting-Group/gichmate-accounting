<Window x:Class="FlexMold.MVVM.View.Master.JournalEntry"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Master" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Title="JournalEntry" Height="400" Width="900">

    <Window.Resources>
        <Style TargetType="StackPanel" x:Key="StackPanelJournalEntry">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Label" x:Key="LabelJournalEntry">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0"
                    Style="{StaticResource StackPanelJournalEntry}">
            <Label Content="Journal Entry"
                   Style="{StaticResource LabelJournalEntry}"
                   FontSize="25"
                   FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center"
                    Style="{StaticResource StackPanelJournalEntry}" Height="50" Margin="0,0,0,10" VerticalAlignment="Bottom">
            <Label Content="Voucher No : " Style="{StaticResource LabelJournalEntry}"/>
            
            <mah:NumericUpDown x:Name="VoucherNoBox" Width="200"
                               Height="30"
                               FontSize="14"
                               VerticalAlignment="Center"
                               VerticalContentAlignment="Center"/>
            <Label Content="Date : " Margin="50,0,0,0" Style="{StaticResource LabelJournalEntry}"/>
          
            <DatePicker x:Name="DatePickBox" Height="30"
                        Width="200"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Style="{StaticResource StackPanelJournalEntry}" VerticalAlignment="Top" Height="60" Grid.RowSpan="2">
            <Label Content="Debit" Margin="580,0,0,0" Style="{StaticResource LabelJournalEntry}"/>
            <Label Content="Credit" Margin="140,0,0,0" Style="{StaticResource LabelJournalEntry}"/>
        </StackPanel>

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center"
                    Style="{StaticResource StackPanelJournalEntry}">
             
            <Label Content="Party Account : " 
                   Style="{StaticResource LabelJournalEntry}"/>
            
            <ComboBox x:Name="PartyAccountBox" Width="250"
                      Height="30"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"/>
            
            <Label Content="Amount : " Margin="50,0,0,0" Style="{StaticResource LabelJournalEntry}"/>
            
            <TextBox x:Name="DebitAmountBox" 
                     PreviewTextInput="DebitAmountBox_TextPreviewInput"
                     Text="0.00"
                     Width="150"
                     Height="30"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center" 
                     />
            
            <TextBox x:Name="CreditAmountBox" 
                     PreviewTextInput="CreditAmountBox_TextPreviewInput"
                     Text="0.00"
                     Width="150"
                     Height="30"
                     Margin="20,0,0,0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center" 
                     />
        </StackPanel>

        <StackPanel Grid.Row="4"
                    HorizontalAlignment="Center"
                    Style="{StaticResource StackPanelJournalEntry}">
            
            <Label Content=" Narration : "
                   Style="{StaticResource LabelJournalEntry}"/>
            
            <TextBox x:Name="NarrationBox" Width="740"
                     Height="30"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="6"
                    Style="{StaticResource StackPanelJournalEntry}"
                    HorizontalAlignment="Right"
                    Margin="0,0,50,0">
            <StackPanel Style="{StaticResource StackPanelJournalEntry}">
                
                <Button Content="Save"
                        x:Name="SaveButton"
                        Click="SaveButton_Click"
                        FontSize="15"
                        Width="80"
                        Height="35"
                        Style="{StaticResource AnimatedRedButton}"/>
                
                <Button Content="Clear"
                        x:Name="ClearButton"
                        FontSize="15"
                        Width="80"
                        Height="35"
                        Style="{StaticResource AnimatedRedButton}" Click="ClearButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
