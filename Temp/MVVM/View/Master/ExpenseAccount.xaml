<Window x:Class="FlexMold.MVVM.View.Master.ExpenseAccount"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Master"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        BorderBrush="Black"
        BorderThickness="3"
        mc:Ignorable="d"
        Title="AccountsGroup" Height="600" Width="850">


    <Grid Margin="0,0,0,-2">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="300"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>


        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,83" Grid.RowSpan="2">
            <Label Content="Expense Account"
                   FontSize="25"
                   FontWeight="Bold"/>

        </StackPanel>

        <StackPanel Grid.Column="0" 
                    Grid.Row="1" 
                    Grid.RowSpan="6" Margin="0,0,0,1"
                    >
            <Border BorderThickness="1000">
                <Border.BorderBrush>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FF5B0000" Offset="0"/>
                        <GradientStop Color="White" Offset="1"/>
                        <GradientStop Color="Red" Offset="0.269"/>
                        <GradientStop Color="#FFFFADAD" Offset="0.516"/>
                        <GradientStop Color="White" Offset="0.685"/>
                        <GradientStop Color="White" Offset="0"/>
                    </LinearGradientBrush>
                </Border.BorderBrush>
            </Border>
        </StackPanel>


        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Vertical">

            <StackPanel Orientation="Horizontal" Height="40">

                <Label Margin="26.5,0,0,0"
                       Content="Account Name :"
                       FontSize="14" VerticalAlignment="Center"/>
                <TextBox x:Name="AccountName" 
                         Margin="10,0,0,0" 
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Height="30"
                         Width="400"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Height="40">

                <Label Content="Accounting Group :"
                       FontSize="14"
                       VerticalAlignment="Center"/>
                <ComboBox x:Name="AccountGroupComboBox" Width="362" VerticalContentAlignment="Center" Height="30" VerticalAlignment="Center">
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                    <ComboBoxItem/>
                </ComboBox>

                <Button Content="+" 
                        FontSize="15" 
                        Background="#FF008800" 
                        Foreground="White" 
                        Height="27" 
                        Width="28"
                        Style="{StaticResource AnimatedRedButton}"
                        VerticalContentAlignment="Center" 
                        Click="Button_Click">

                </Button>

            </StackPanel>


            <StackPanel Orientation="Horizontal" Height="40">

                <Label Margin="13,0,0,0"
                       VerticalAlignment="Center"
                       Content="Opening Balance :"
                       FontSize="14"/>

                <TextBox x:Name="OpeningBalanceTextBox" Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         Text="0" 
                         Width="200" 
                         VerticalContentAlignment="Center"/>

                <ComboBox x:Name="DrCrComboBox" Margin="10,0,0,0" Width="120" Height="30" VerticalAlignment="Center" VerticalContentAlignment="Center">
                    <ComboBoxItem IsSelected="True" Content="DR" />
                    <ComboBoxItem Content="CR"/>
                </ComboBox>

                <CheckBox x:Name="ActiveCheckbox"  Margin="10,0,0,0" Content="Active"
                          FontSize="14" Width="96"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" Height="40">

                <Label Margin="88,0,0,0"
                       Content="Date :"
                       VerticalAlignment="Center"
                       FontSize="14"/>

                <DatePicker x:Name="DatePickBox" Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            VerticalContentAlignment="Center" 
                            Height="30"
                            Width="200"/>

            </StackPanel>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Height="40">

                <Label Margin="47,0,0,0" Content="Description :"
                       FontSize="14"
                       VerticalAlignment="Center"/>

                <TextBox x:Name="DescriptionTextBox" Width="400"
                         Height="30"
                         Margin="10,0,0,0"
                         VerticalAlignment="Center"
                         VerticalContentAlignment="Center"
                         Text=""/>

            </StackPanel>
        </StackPanel>


        <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">

            <Button x:Name="SaveButton" Content="Save" 
                    FontSize="14" 
                    Style="{StaticResource AnimatedRedButton}" Click="SaveButton_Click"/>

            <Button x:Name="DeleteButton" Content="Delete"
                    FontSize="14" 
                    Style="{StaticResource AnimatedRedButton}" Click="DeleteButton_Click"/>

            <Button x:Name="NewButton" Content="New"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}" RenderTransformOrigin="0.5,0.5" Click="NewButton_Click">
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="1.096"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="Search"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}" Click="Button_Click_1"  />

            <Button x:Name="ClearButton" Content="Clear"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}" Click="ClearButton_Click"/>

        </StackPanel>






    </Grid>
</Window>
