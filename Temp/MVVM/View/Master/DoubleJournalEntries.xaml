<Window x:Class="AccountsPRO.MVVM.View.Master.DoubleJournalEntries"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccountsPRO.MVVM.View.Master" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        BorderBrush="White"
        BorderThickness="3"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="Double Journal Entries"
        Height="770" Width="1200">


    <Window.Resources>

            <Style x:Key="CenterTextStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="TextAlignment" Value="Center"/>
            </Style>
        
        
        <Style TargetType="Label" x:Key="LabelJournalEntries">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style TargetType="StackPanel" x:Key="StackPanelJournalEntries">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="30"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>



        <StackPanel Grid.Row="0"
                    Style="{StaticResource StackPanelJournalEntries}">

            <Label Content="Journal Entries"
                   FontSize="25"
                   FontWeight="Bold"/>
        </StackPanel>


        <StackPanel Grid.Row="1" VerticalAlignment="Bottom" Style="{StaticResource StackPanelJournalEntries}">
            <Label Content="Search" VerticalAlignment="Bottom" Style="{StaticResource LabelJournalEntries}"/>
            <Border BorderBrush="White" BorderThickness="3" Height="5" Width="1140"/>
        </StackPanel>


        <StackPanel Grid.Row="2">
            <DataGrid x:Name="JournalDataGrid" 
                      FontSize="11"  
                      Width="1190" 
                      Height="400" 
                      AutoGenerateColumns="False"
                      HorizontalContentAlignment="Center"
                      TextBlock.TextAlignment="Center"
                      SelectionMode="Single" SelectionChanged="JournalDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="40" Header="SL" Binding="{Binding SL}" 
                            ElementStyle="{StaticResource CenterTextStyle}" />

                    <DataGridTextColumn Width="100" Header="Voucher No" Binding="{Binding VoucherNo}" 
                            ElementStyle="{StaticResource CenterTextStyle}" />

                    <DataGridTextColumn Width="140" Header="Date" Binding="{Binding Date}" 
                            ElementStyle="{StaticResource CenterTextStyle}" />

                    <DataGridTextColumn Width="150" Header="From Account" Binding="{Binding FromAccount}" 
                            ElementStyle="{StaticResource CenterTextStyle}" />

                    <DataGridTextColumn Width="160" Header="To Account" Binding="{Binding ToAccount}" 
                            ElementStyle="{StaticResource CenterTextStyle}" />

                    <DataGridTextColumn Width="120" Header="Amount" Binding="{Binding Amount, StringFormat={}{0:N0}}" 
                            ElementStyle="{StaticResource CenterTextStyle}" />

                    <DataGridTextColumn Width="*" Header="Narration" Binding="{Binding Narration}" 
                            ElementStyle="{StaticResource LeftTextStyle}" />
                </DataGrid.Columns>
            </DataGrid>

        </StackPanel>

        <StackPanel Grid.Row="3" Style="{StaticResource StackPanelJournalEntries}">
            <Border BorderBrush="White" BorderThickness="2" Width="1200"/>

        </StackPanel>


        <StackPanel Grid.Row="4"
                    Style="{StaticResource StackPanelJournalEntries}">

            <Label Content="Voucher No : "
                   Margin="50,0,0,0"
                   Style="{StaticResource LabelJournalEntries}"/>

            <mah:NumericUpDown x:Name="UpDownBox" 
                               Width="250"
                               Height="30"
                               FontSize="15"
                               VerticalContentAlignment="Center"/>

            <Label Content="Date : "
                   Margin="100,0,0,0"
                   Style="{StaticResource LabelJournalEntries}"/>

            <DatePicker x:Name="DatePickBox" Width="250"
                        Height="30"
                        VerticalContentAlignment="Center"
                        FontSize="15"/>

        </StackPanel>



        <StackPanel Grid.Row="5"
                    Style="{StaticResource StackPanelJournalEntries}">

            <Label Content="From Acc/Credit : "
                   Margin="20,0,0,0"
                   Style="{StaticResource LabelJournalEntries}"/>

            <ComboBox x:Name="FromAccCreditBox" Width="250"
                      Height="30"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      FontSize="15"/>

            <Label Content="Amount : "
                   Margin="80,0,0,0"
                   Style="{StaticResource LabelJournalEntries}" Width="70"/>
            <TextBox x:Name="AmountBox" Width="250"
                     Height="30"
                     Text="0.00"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                      PreviewTextInput="Amount_TextPreviewInput"/>
        </StackPanel>



        <StackPanel Grid.Row="6"
                    Style="{StaticResource StackPanelJournalEntries}">

            <Label Content=" To Acc/Debit : "
                   Margin="40,0,0,0"
                   Style="{StaticResource LabelJournalEntries}"/>

            <ComboBox x:Name="ToAccDebitBox" Width="250"
                      Height="30"
                      FontSize="15"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="7"
                    Style="{StaticResource StackPanelJournalEntries}">
            <Label Content="Narration : "
                   Margin="65,0,0,0"
                   Style="{StaticResource LabelJournalEntries}"/>

            <TextBox x:Name="NarrationBox" Width="250"
                     Height="30"
                     FontSize="15"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="8"
                    Style="{StaticResource StackPanelJournalEntries}">

            <CheckBox x:Name="CustomerOnlyCheckBox" Content="Customer Only"
                      Margin="150,0,0,0"/>

            <CheckBox x:Name="SupplierOnlyCheckBox" Content="Supplier Only"
                      Margin="10,0,0,0"/>

            <CheckBox x:Name="OthersCheckBox" Content="Others"
                      Margin="10,0,0,0"/>

            <CheckBox x:Name="AllSelectCheckBox" Content="All"/>

            <!--StackPanel inside StackPanel for buttons-->
            <StackPanel Margin="0,0,0,0" Orientation="Horizontal" VerticalAlignment="Center">

                <Button Content="Save"
                        FontSize="15"
                        Style="{StaticResource AnimatedRedButton}" Click="SaveButton_Click"/>

                <Button Content="Edit"
                        FontSize="15"
                        Style="{StaticResource AnimatedRedButton}" Click="EditButton_Click"/>

                <Button Content="Delete"
                        FontSize="15"
                        Style="{StaticResource AnimatedRedButton}" Click="DeleteButton_Click"/>

                <Button Content="Clear"
                        FontSize="15"
                        Style="{StaticResource AnimatedRedButton}" Click="ClearButton_Click"/>

            </StackPanel>
        </StackPanel>

    </Grid>
</Window>
