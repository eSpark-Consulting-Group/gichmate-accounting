<Window x:Class="FlexMold.MVVM.View.Master.AccountsGroup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Master"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        BorderBrush="Black"
        BorderThickness="3"
        mc:Ignorable="d"
        Title="AccountsGroup" Height="670" Width="1000">

    <Window.Resources>
        <Style TargetType="Button" x:Key="AnimatedRedButton">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF6F0404"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation  To="#FFAA0000"
                                                             Duration="0:0:0.3"
                                                             Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"/>

                                            <DoubleAnimation To="1.2"
                                                             Duration="0:0:0.3"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation To="1.2"
                                                             Duration="0:0:0.3"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation  To="#FF6F0404"
                                                             Duration="0:0:0.3"
                                                             Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"/>
                                            <DoubleAnimation To="1.0"
                                                             Duration="0:0:0.3"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation To="1.0"
                                                             Duration="0:0:0.3"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="9" Color="Black" Opacity="0.9"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>


    <Grid Margin="0,0,0,-2">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="0"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="350"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <Label Content="Accounts Group"
                   FontWeight="Bold"
                   VerticalAlignment="Center"
                   FontSize="20"/>

            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    VerticalContentAlignment="Center"
                    Width="60"
                    Height="35"
                    Margin="740,0,0,0"
                    Content="X"
                    Background="ForestGreen" 
                    Style="{StaticResource AnimatedRedButton}"
                    Click="Button_Click">
               </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

            
            <Label Content="Group Name :"
                   VerticalAlignment="Center"
                   FontSize="14"/>
            <TextBox x:Name="GroupNameTextBox" VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Width="300"
                     Height="30"
                     />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

            <Label Margin="41.5,0,0,0" 
                   Content="Under :"
                   FontSize="14"
                   VerticalAlignment="Center"/>
            <ComboBox x:Name="UnderComboBox" Margin="10.5,0,0,0" 
                     VerticalAlignment="Center" VerticalContentAlignment="Center"
                     Width="300"
                     Height="30" >

                <ComboBoxItem/>
                <!--We need to add a binding here, like Balance sheets etc.-->
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
                <ComboBoxItem/>
            </ComboBox>

        </StackPanel>

        
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,2,0">
            <Border BorderBrush="White" BorderThickness="2" VerticalAlignment="Center" Height="3" Width="100"/>
            <Label  Content="Existing Group" VerticalAlignment="Center"/>
            <Border BorderBrush="White" BorderThickness="2" VerticalAlignment="Center" Width="800" Height="3"/>
        </StackPanel>


        <StackPanel Grid.Row="5">

            <DataGrid x:Name="ExistingGroupDataGrid" Height="350" Width="900" SelectionChanged="ExistingGroupDataGrid_SelectionChanged">
                <DataGrid.Columns>
                    
                </DataGrid.Columns>
            </DataGrid>
           
        </StackPanel>


        <StackPanel Grid.Row="6" VerticalAlignment="Center">
            <Border BorderBrush="White" BorderThickness="1"/>
        </StackPanel>

        <StackPanel Grid.Row="7" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">

            <Button x:Name="SaveButton" 
                    Background="ForestGreen" 
                    Content="Save"
                    FontSize="15" 
                    Style="{StaticResource AnimatedRedButton}" 
                    Click="SaveButton_Click" />

            <Button x:Name="DeleteButton" 
                    Background="ForestGreen"  
                    Content="Delete"
                    FontSize="15" 
                    Style="{StaticResource AnimatedRedButton}" 
                    Click="DeleteButton_Click"/>

            <Button x:Name="NewButton" 
                    Background="ForestGreen"  
                    Content="New" 
                    FontSize="15" 
                    Style="{StaticResource AnimatedRedButton}" 
                    Click="NewButton_Click"/>
            
        </StackPanel>

        
        
        


    </Grid>
</Window>
