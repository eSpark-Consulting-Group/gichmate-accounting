<UserControl x:Class="AccountsPRO.MVVM.View.Accounts.ReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AccountsPRO.MVVM.View.Accounts"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d"            
             BorderThickness="3" 
             BorderBrush="White"
             Height="770" Width="1200">

    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="450"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="top">

            <Label Content="Receipt View" FontSize="25" FontWeight="Bold"/>


            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"
                    Command="{Binding DefaultAccountScreenCommand}"
                    Margin="960,0,0,0" />   
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" >


            <Label Content="Receipt Date :" 
                   FontSize="14" 
                   VerticalAlignment="Center"/>

            <DatePicker Width="468" 
                        Height="30" 
                        VerticalAlignment="Center" 
                        VerticalContentAlignment="Center" 
                        FontSize="14" 
                        x:Name="ReceiptDateBox"
                        Margin="0,0,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">

            <Label Content="Route :" 
                   VerticalAlignment="Center"
                   Margin="15,0,0,0"
                   FontSize="14"/>

            <ComboBox x:Name="routeComboBox"
                      Width="250" 
                      Height="30" 
                      FontSize="14" 
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="All" />
            </ComboBox>

            <DatePicker x:Name="routeDateBox" 
                        Width="250" 
                        Height="30" 
                        VerticalAlignment="Center" 
                        FontSize="14" 
                        VerticalContentAlignment="Center" 
                        Margin="0,0,0,0"/>


            <Label Content="Unit No :  " 
                   Margin="22,0,0,0"
                   FontSize="14"
                   VerticalAlignment="Center"/>

            <ComboBox x:Name="vehicleComboBox"
                      Width="250" 
                      Height="30" 
                      FontSize="14"
                      VerticalAlignment="Center" 
                      VerticalContentAlignment="Center" >
                <ComboBoxItem Content="All" />
            </ComboBox>

            <DatePicker x:Name="vehicleDateBox"
                        Width="250"
                        Height="30" 
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"
                        FontSize="14" 
            />
            

        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" >
            
            <Label Content="Sales Exi :" 
                   FontSize="14"
                   Margin="0,0,0,0"/>

            <TextBox x:Name="txtSalesExi"
                     Width="250" 
                     VerticalAlignment="Center" 
                     Height="20"
                     FontSize="14"
                     VerticalContentAlignment="Center" />

            <Label Content=" Remarks :" 
                   Margin="265,0,0,0"
                   FontSize="14" 
                   VerticalAlignment="Center"/>

            <TextBox x:Name="txtRemarks"
                     Text=".." 
                     Margin="10,0,0,0"
                     FontSize="14"
                     Width="250" 
                     Height="30" 
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"/>

            <Button Click="LoadBtn_Click"
                    Content="Load"
                    Style="{StaticResource AnimatedRedButton}" Height="30"/>
        </StackPanel>


        <StackPanel Grid.Row="4">
            <DataGrid x:Name="receiptGrid"
                      Width="1180" 
                      FontSize="14" 
                      Height="450"
                      HorizontalContentAlignment="Center"
                      TextBlock.TextAlignment="Center"/>

        </StackPanel>
        

        <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center">
           
            <Label Content="Total Cash :" 
                   FontSize="14" 
                   VerticalAlignment="Center"/>

            <TextBox x:Name="txtTotalCash"
                     Text="0.00"
                     Width="200" 
                     Height="30" 
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"/>

            <Label Content="Online total :"
                   FontSize="14" 
                   VerticalAlignment="Center" 
                   Margin="20,0,0,0"/>

            <TextBox x:Name="txtOnlineTotal"
                     Text="0.00" 
                     Width="200" 
                     Height="30"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"/>
        
        </StackPanel>

        
        <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center" Height="56">
          
            <Label Content="Total Card :"
                   FontSize="14" 
                   VerticalAlignment="Center"/>

            <TextBox x:Name="txtTotalCard"
                     Text="0.00" 
                     Width="200" 
                     Height="30" 
                     VerticalAlignment="Center" 
                     VerticalContentAlignment="Center"/>

            <Label Content="Credit Total :"
                   FontSize="14" 
                   VerticalAlignment="Center" 
                   Margin="24,0,0,0"/>

            <TextBox x:Name="txtCreditTotal"
                     Text="0.00" 
                     Width="200" 
                     Height="30"
                     VerticalAlignment="Center" 
                     VerticalContentAlignment="Center"/>

            <Label Content="Total Amount :"
                   FontSize="14"
                   VerticalAlignment="Center" 
                   Margin="20,0,0,0"/>

            <TextBox x:Name="txtTotalAmount"
                     Text="0.00" 
                     Width="200" 
                     Height="30" 
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"/>

            
            <Button Click="SaveBtn_Click"
                    Content="Save"  
                    Margin="50,0,0,0"
                    VerticalAlignment="Center" 
                    Foreground="White"
                    Style="{StaticResource AnimatedRedButton}">
                
            </Button>


            <Button Click="ClearBtn_Click"
                    Content="Clear" 
                    Margin="20,0,0,0"
                    Style="{StaticResource AnimatedRedButton}"
                    VerticalAlignment="Center"
                    Foreground="White">
               
            </Button>
        </StackPanel>


    </Grid>
</UserControl>
