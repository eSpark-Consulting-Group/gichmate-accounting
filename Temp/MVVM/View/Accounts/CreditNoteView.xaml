<UserControl x:Class="FlexMold.MVVM.View.Accounts.CreditNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             BorderThickness="3"
             BorderBrush="White"
             Height="770" Width="1200">

    <UserControl.Background>
        <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="450"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Credit Note"
                       FontSize="20"
                       FontWeight="Bold"
                       Foreground="White"/>
            <Button Content="X"
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"
                    Command="{Binding DefaultAccountScreenCommand}"
                    HorizontalAlignment="Right"
                    Margin="1020,0,10,0"/>
        </StackPanel>


        <DataGrid x:Name="dgCreditNotes"
                  Grid.Row="1"
                  AutoGenerateColumns="True"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  HorizontalContentAlignment="Center"
                  TextBlock.TextAlignment="Center"
                  Height="450"
                  SelectionChanged="dgCreditNotes_SelectionChanged"/>


        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">

            <Label   Content ="Voucher No : "
                     Margin="200,0,0,0"
                     Style="{StaticResource AccountsLabel}"/>

            <mah:NumericUpDown x:Name="numVoucherNo" 
                    Height="30" 
                    Width="250" 
                    Maximum="9999" 
                    VerticalContentAlignment="Center"
                    FontSize="14"
                    Minimum="0"/>


            <Label Content ="Date :  "
                   Margin="110,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <DatePicker x:Name="dpDate"
                        Width="250"
                        Height="30"
                        VerticalContentAlignment="Center"
                        FontSize="14"
                         />

        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">

            <Label Content ="Party Supplier : "
                   Margin="190,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox x:Name="cmbParty"
                      Style="{StaticResource AccountsComboBox}"
                      DisplayMemberPath="AccountName"
                      SelectedValuePath="AccountId"/>

            <Label Content ="Amount : "
                   Margin="105,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="txtAmount"
          Style="{StaticResource AccountsTextBox}"
          Text="0.00"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">

            <Label Content ="Account Name : "
                   Margin="185,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox x:Name="cmbAccount"
                      Style="{StaticResource AccountsComboBox}"
                      DisplayMemberPath="AccountName"
                      SelectedValuePath="AccountId"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">

            <Label Content ="Narration : "
                   Margin="217,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="txtNarration"
                     Style="{StaticResource AccountsTextBox}"/>

        </StackPanel>


        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,10">
            <Button x:Name="btnSave"
                    Content="Save"
                    Style="{StaticResource AnimatedRedButton}"
                    FontSize="14"
                    Margin="5,0"
                    Click="btnSave_Click"/>
            <Button x:Name="btnEdit"
                    Content="Edit"
                    Style="{StaticResource AnimatedRedButton}"
                    FontSize="14"
                    Margin="5,0"
                    Click="btnEdit_Click"/>
            <Button x:Name="btnDelete"
                    Content="Delete"
                    Style="{StaticResource AnimatedRedButton}"
                    FontSize="14"
                    Margin="5,0"
                    Click="btnDelete_Click"/>
            <Button x:Name="btnClear"
                    Content="Clear"
                    Style="{StaticResource AnimatedRedButton}"
                    FontSize="14"
                    Margin="5,0"
                    Click="btnClear_Click"/>
        </StackPanel>


    </Grid>
</UserControl>