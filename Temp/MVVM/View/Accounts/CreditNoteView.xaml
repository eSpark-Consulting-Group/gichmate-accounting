<UserControl x:Class="FlexMold.MVVM.View.Accounts.CreditNoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             BorderThickness="3" 
             Loaded="UserControl_Loaded"
             BorderBrush="White"
             Height="902" Width="1123">

    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="10,20,0,19">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="613*"/>
            <ColumnDefinition Width="501*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="28"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="201*"/>
            <RowDefinition Height="Auto" MinHeight="39.62"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="dgVouchers" Grid.Row="2" Grid.ColumnSpan="2" Grid.RowSpan="2"
                  AutoGenerateColumns="False" HeadersVisibility="Column"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  Margin="22,44,22,321" SelectionChanged="dgVouchers_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="SL" Width="50" Binding="{Binding SL}"/>
                <DataGridTextColumn Header="Voucher No" Width="120" Binding="{Binding VchrNo}"/>
                <DataGridTextColumn Header="Date" Width="110" Binding="{Binding VchrDate, StringFormat=dd-MM-yyyy}"/>
                <DataGridTextColumn Header="Party Account" Width="160" Binding="{Binding PartyAccountName}"/>
                <DataGridTextColumn Header="Credit Account" Width="150" Binding="{Binding CreditAccountName}"/>
                <DataGridTextColumn Header="Amount" Width="110" Binding="{Binding VchrAmount, StringFormat=N2}"/>
                <DataGridTextColumn Header="Narration" Width="*" Binding="{Binding Narration}"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="188,3,0,-2" Width="360">
            
            <Button x:Name="btnSave" Content="Save" 
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}"
                    Click="btnSave_Click">
            </Button>
            
            <Button x:Name="btnEdit" Content="Edit" 
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}"
                    Click="btnEdit_Click">
            </Button>
            
            <Button x:Name="btnDelete" Content="Delete" 
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}"
                    Click="btnDelete_Click">
            </Button>
        
            <Button x:Name="btnClear" Content="Clear"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}"
                    Click="btnClear_Click">
            </Button>
        
        </StackPanel>

        <Border BorderBrush="White" BorderThickness="4" Margin="-10,-20,0,4" Grid.ColumnSpan="2" >

            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"
                    Click="Close_Click"
                    Margin="1052,0,0,0" 
                    />
       
        </Border>

        <StackPanel Orientation="Horizontal" Margin="127,135,54,217" Grid.Row="3">
            <TextBlock Text="Voucher No : " VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="White"/>
            <TextBox x:Name="txtVoucherNo" Height="27" Width="302" IsReadOnly="True"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="108,192,70,170" Grid.Row="3">
            <TextBlock Text="Party/Supplier :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox x:Name="cmbPartyAccount" Width="300" Margin="10,0,0,0" Height="27" DisplayMemberPath="AccountName" SelectedValuePath="AccountId"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="106,236,61,128" Grid.Row="3">
            <TextBlock Text="Account Name :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox x:Name="cmbCreditAccount" Width="300" Margin="10,0,0,0" Height="27" DisplayMemberPath="AccountName" SelectedValuePath="AccountId"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="140,277,57,75" Grid.Row="3">
            <TextBlock Text="Narration :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <TextBox x:Name="txtNarration" Width="302" Margin="10,0,0,0" Height="27"/>
        </StackPanel>

        <TextBlock HorizontalAlignment="Left" Height="36" Margin="0,-12,0,0" 
                   TextWrapping="Wrap" FontSize="24" Text="Credit Note" 
                   Foreground="White" FontWeight="Bold" VerticalAlignment="Top" Width="194"/>

        <StackPanel Orientation="Horizontal" Margin="6,141,112,225" Grid.Row="3" Grid.Column="1">
            <TextBlock Text="Date :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <DatePicker x:Name="dtpDate" Width="300" Margin="7,0,0,0" Height="27"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="586,188,93,170" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text=" Amount :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <TextBox x:Name="txtAmount" Width="300" Margin="10,0,0,0" Height="27" Text="0.00"/>
        </StackPanel>

        <Border BorderBrush="white" BorderThickness="4" Grid.ColumnSpan="2" HorizontalAlignment="Left" 
                Height="3" Margin="106,107,0,0" Grid.Row="3" VerticalAlignment="Top" Width="900"/>

        <TextBlock HorizontalAlignment="Left" Height="25" Margin="22,17,0,0" 
                   TextWrapping="Wrap" FontSize="20" Text="Search" 
                   Foreground="White" FontWeight="Light" VerticalAlignment="Top" Width="194" Grid.Row="2"/>
    </Grid>
</UserControl>