<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" x:Class="FlexMold.MVVM.View.Accounts.PaymentAndReceiptView"
             mc:Ignorable="d" 
             BorderThickness="3" 
             BorderBrush="White"
             Height="770" Width="1200">

    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </UserControl.Background>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="60"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center">


            <Label Content="Payment And Receipt"
                   FontSize="25"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>

            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"
                    Command="{Binding DefaultAccountScreenCommand}"
                    Margin="850,0,0,0"/>
            
        </StackPanel>


        <StackPanel Grid.Row="1" Orientation="Horizontal">

            <TextBlock Text="Voucher No :"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="40,0,0,0"
                       FontSize="14"/>
           
            <mah:NumericUpDown VerticalAlignment="Center"
                               x:Name="txtVoucherNo"
                               Width="250"
                               FontSize="14"
                               VerticalContentAlignment="Center"
                               Height="30"
                               Margin="15,0,0,0"/>


            <Label Content="Date :"
                   VerticalAlignment="Center"
                   Margin="150,0,0,0"
                   FontSize="14"/>
            
            
            <DatePicker VerticalAlignment="Center"
                        x:Name="dpVoucherDate"
                        Width="250"
                        Height="30"
                        FontSize="14"
                        VerticalContentAlignment="Center"
                        Margin="5,0,0,0"/>
        </StackPanel>


        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            
            <Label Content="Receipt/Payment :" 
                   Foreground="White" 
                   FontSize="14"
                   VerticalAlignment="Center"/>
            
            
            <ComboBox Width="250" 
                      x:Name="cmbVoucherType"
                      Height="30" 
                      VerticalAlignment="Center" 
                      VerticalContentAlignment="Center"
                      FontSize="14">
            </ComboBox>


            <Label Content="Cash/Bank A/C :" 
                   x:Name="cmbCashBank"
                   FontSize="14"
                   Margin="80,0,0,0"
                   VerticalAlignment="Center"/>

            <ComboBox Width="250"
                      VerticalAlignment="Center" 
                      x:Name="CashBankAccount"
                      Height="30" 
                      VerticalContentAlignment="Center" 
                      FontSize="14"/>

        </StackPanel>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
            
            <Label Content="   Party :"
                   FontSize="14" VerticalAlignment="Center" 
                   Margin="65,0,0,0"
                   Width="67"/>

            <ComboBox Width="250" 
                      x:Name="cmbParty"
                      Height="30"  
                      FontSize="14"
                      VerticalContentAlignment="Center"/>

            <Label Content="Executive :" 
                   VerticalAlignment="Center"
                   FontSize="14" 
                   Margin="116,0,0,0"/>

            <ComboBox Width="250" 
                      x:Name="SelectedValue"
                      Height="30" 
                      VerticalContentAlignment="Center"
                      FontSize="14"/>
            
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal" 
                    VerticalAlignment="Center">
           
            <Label Content="Ledger/Balance :" 
                   FontSize="14" 
                   Margin="10,0,0,0"
                   VerticalAlignment="Center"/>
            
            <TextBox Width="250"
                     x:Name="LedgerAndBalance"
                     Height="30" 
                     FontSize="14" 
                     VerticalContentAlignment="Center" 
                     Margin="15,0,0,0"/>

            <Label Content=" Paid Amount :" 
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="96,0,0,0"/>
            
            <TextBox Text="0.00"
                     x:Name="txtPaidAmount"
                     FontSize="14" 
                     Width="250"
                     Height="30"
                     VerticalContentAlignment="Center"/>
      
        </StackPanel>

        <StackPanel Grid.Row="5">
           
            <DataGrid Height="400" 
                      x:Name="dgVouchers"
                      FontSize="14"
                      HorizontalContentAlignment="Center"
                      TextBlock.TextAlignment="Center" SelectionChanged="dgVouchers_SelectionChanged_1"/>

        </StackPanel>

        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <CheckBox Content="    Discount :"
                      FontSize="14" 
                      Width="102" 
                      Margin="20,0,0,0"/>
            
            <TextBox Width="250"
                     x:Name="Discount"
                     Height="30"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center" 
                     Text="0.00" 
                     FontSize="20" />

            <Label Content="Narration :" 
                   Margin="160,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="14"/>
            
            <TextBox Width="250"
                     x:Name="txtNarration"
                     Height="30" 
                     VerticalContentAlignment="Center" 
                     FontSize="14"/>
            
        </StackPanel>

        <StackPanel Grid.Row="7" 
                    Orientation="Horizontal"
                    VerticalAlignment="Bottom">
            
            <Label Content="Amount in Words :" 
                   VerticalAlignment="Center" 
                   FontSize="14"/>
           
            <TextBox Width="750"
                     Height="30"
                     x:Name="TxtAmountInWords"
                     VerticalAlignment="Center" 
                     VerticalContentAlignment="Center" 
                     FontSize="20"/>
        </StackPanel>


        <StackPanel Grid.Row="8"
                    Orientation="Horizontal" 
                    VerticalAlignment="Center">
            
            <CheckBox Content="Print While Saving"
                      FontSize="14"
                      Margin="180,0,0,0">
            </CheckBox>
            
            
            <CheckBox Width="200"
                      Margin="50,0,0,0"
                      Content="Mail While Saving"
                      FontSize="14"
                      Height="24" 
                      >
            </CheckBox>


            <Button Content="Save" 
                    Style="{StaticResource AnimatedRedButton}"
                    Margin="70,0,0,0"
                    Click="SaveVoucher_Click"/>


            <Button Content="Edit" 
                    Style="{StaticResource AnimatedRedButton}"      
                    Margin="10,0,0,0"
                    Click="EditVoucher_Click"/>


            <Button Content="Delete" 
                    Style="{StaticResource AnimatedRedButton}" 
                    Margin="10,0,0,0"
                    Click="DeleteVoucher_Click"/>


            <Button Content="Clear"          
                    Style="{StaticResource AnimatedRedButton}"  
                    Margin="10,0,0,0"
                    Click="Clear_Click"/>


            <Button Content="Print"            
                    Style="{StaticResource AnimatedRedButton}" 
                    Margin="10,0,0,0"
                    Click="BtnPrint_Click"/>


            <Button Content="Mail"           
                    Style="{StaticResource AnimatedRedButton}"  
                    Margin="10,0,0,0"
                    Click="BtnMail_Click"/>

        </StackPanel>



    </Grid>
</UserControl>
