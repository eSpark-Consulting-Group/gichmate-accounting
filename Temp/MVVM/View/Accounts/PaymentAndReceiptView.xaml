<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" x:Class="FlexMold.MVVM.View.Accounts.PaymentAndReceiptView"
             mc:Ignorable="d" 
             BorderThickness="3" 
             BorderBrush="White"
             Height="900" Width="1300">

    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </UserControl.Background>


    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <Label Content="Payment And Receipt"
                   FontSize="35"
                   FontWeight="Bold"
                   VerticalAlignment="Center"/>

            <TextBlock Text="Voucher No :"
                       Foreground="White"
                       VerticalAlignment="Center"
                       Margin="100,0,0,0"
                       FontSize="20"/>
            <mah:NumericUpDown VerticalAlignment="Center"
                               Width="250"
                               FontSize="20"
                               Height="40"
                               Margin="10,0,0,0"/>


            <Label Content="Date :"
                   VerticalAlignment="Center"
                   Margin="100,0,0,0"
                   FontSize="20"/>
            <DatePicker VerticalAlignment="Center"
                        Width="250"
                        Height="40"
                        FontSize="20"
                        VerticalContentAlignment="Center"
                        Margin="10,0,0,0"/>
        </StackPanel>


        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    >
            <Label Content="Receipt/Payment :" Foreground="White" FontSize="20" VerticalAlignment="Center"/>
            <ComboBox Width="350" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="20">
                <ComboBoxItem Content="Receipt"/>
                <ComboBoxItem Content="Item"/>
            </ComboBox>


            <Label Content="Cash/Bank A/C :"
                   Margin="120,0,0,0"
                   VerticalAlignment="Center"/>
            <ComboBox Width="350" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="20">
                <ComboBoxItem Content="Cash"/>
                <ComboBoxItem Content="Bank Account"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="Party :" VerticalAlignment="Center" Margin="112,0,0,0" Width="67"/>
            <ComboBox Width="350">
                <ComboBoxItem Content="Sample Suppliers"/>
                <ComboBoxItem Content="Supplier2"/>
            </ComboBox>

            <Label Content="Executive :" VerticalAlignment="Center" Margin="170,0,0,0"/>
            <ComboBox Width="350" VerticalContentAlignment="Center">
                <ComboBoxItem Content="SM"/>
                <ComboBoxItem Content="Demo"/>
                <ComboBoxItem Content="Executive"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="Ledger/Balance :" Margin="20,0,0,0" VerticalAlignment="Center"/>
            <TextBox Width="350" Height="40" FontSize="20" VerticalContentAlignment="Center" Margin="9,0,0,0"/>

            <Label Content="Paid Amount :" VerticalAlignment="Center" Margin="143,0,0,0"/>
            <TextBox Text="0.00" FontSize="20" Width="350" Height="40" VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="4">
            <DataGrid Height="400" FontSize="20">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="SL" Width="50" Binding="{Binding}"/>
                    <DataGridTextColumn Header="Invoice No" Width="150" Binding="{Binding}"/>
                    <DataGridTextColumn Header="Date" Width="140" Binding="{Binding}"/>
                    <DataGridTextColumn Header="Invoice Amount" Width="200" Binding="{Binding}"/>
                    <DataGridTextColumn Header="Paid Amount" Width="190" Binding="{Binding}"/>
                    <DataGridTextColumn Header="Credit Amount" Width="200" Binding="{Binding}"/>
                    <DataGridTextColumn Header="Payment" Width="180" Binding="{Binding}"/>
                    <DataGridTextColumn Header="Balance" Width="*" Binding="{Binding}"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox RenderTransformOrigin="0.5,0.5" Width="102" Margin="-40,0,0,0">
                <CheckBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </CheckBox.RenderTransform>
            </CheckBox>
            <Label Content="Discount :" VerticalAlignment="Center"/>
            <TextBox Width="350" Height="40" VerticalAlignment="Center" VerticalContentAlignment="Center" Text="0.00" FontSize="20" />

            <Label Content="Narration :" Margin="160,0,0,0" VerticalAlignment="Center"/>
            <TextBox Width="350" VerticalContentAlignment="Center" FontSize="20"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Label Content="Amount in Words :" VerticalAlignment="Center" FontSize="20"/>
            <TextBox Width="976" Height="40" VerticalAlignment="Center" VerticalContentAlignment="Center" FontSize="20"/>
        </StackPanel>


        <StackPanel Grid.Row="7" Orientation="Horizontal" VerticalAlignment="Center">
            <CheckBox Margin="0,0,0,0" RenderTransformOrigin="0.5,0.5" Width="90">
                <CheckBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </CheckBox.RenderTransform>
            </CheckBox>
            <Label Content="Print while Saving" VerticalAlignment="Center" FontSize="20"/>
            <CheckBox Width="112" Height="24" RenderTransformOrigin="0.5,0.5" >
                <CheckBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </CheckBox.RenderTransform>
            </CheckBox>
            <Label Content="Mail while Saving" FontSize="20"/>

            <Button Content="Save" Foreground="White" FontSize="20"
                    Width="100" Height="40" Background="#FF6F0404" VerticalAlignment="Center" Margin="40,0,0,0">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Edit" Foreground="White" FontSize="20"
                    Width="100" Height="40" Background="#FF6F0404" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Delete" Foreground="White" FontSize="20"
                    Width="100" Height="40" Background="#FF6F0404" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Clear" Foreground="White" FontSize="20"
                    Width="100" Height="40" Background="#FF6F0404" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Print" Foreground="White" FontSize="20"
                    Width="100" Height="40" Background="#FF6F0404" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Mail" Foreground="White" FontSize="20"
                    Width="100" Height="40" Background="#FF6F0404" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

        </StackPanel>



    </Grid>
</UserControl>
