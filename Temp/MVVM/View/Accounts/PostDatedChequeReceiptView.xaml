<UserControl x:Class="FlexMold.MVVM.View.Accounts.PostDatedChequeReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"        
             mc:Ignorable="d"
             BorderThickness="3"
             BorderBrush="White"
                         Height="770" 
             Width="1200">

    <Control.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </Control.Background>
    <Grid>



        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="350"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <Label Content="Post Dated Cheque Receipt" 
                   FontSize="20" 
                   FontWeight="Bold"/>

            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"
                    Command="{Binding DefaultAccountScreenCommand}"
                    Margin="860,0,0,0" />


        </StackPanel>


        <StackPanel Grid.Row="1" Orientation="Horizontal">

            <Label Content="From : "
               Margin="225,0,0,0"
               Style="{StaticResource AccountsLabel}"/>

            <DatePicker  Width="250"
                     Height="30"
                     VerticalContentAlignment="Center"/>



            <Label Content="To : "
                   Margin="85,0,0,0"
               Style="{StaticResource AccountsLabel}"/>

            <DatePicker  Width="250"
                     Height="30"
                     VerticalContentAlignment="Center"/>

        </StackPanel>



        <StackPanel Grid.Row="2" Orientation="Horizontal">



            <Label Content="Party A/C : "
                   Margin="200,0,0,0"
               Style="{StaticResource AccountsLabel}"/>

            <ComboBox Width="250"
                      Style="{StaticResource AccountsComboBox}"
                      Height="30"
                      VerticalContentAlignment="Center"/>

            <Label Content="Cheque No : "
                   Margin="30,0,0,0"
               Style="{StaticResource AccountsLabel}"/>

            <TextBox Width="250"
                      Style="{StaticResource AccountsTextBox}"
                      Height="30"
                      VerticalContentAlignment="Center"/>
        </StackPanel>


        <StackPanel Grid.Row="3">
            <DataGrid Height="350">

            </DataGrid>
        </StackPanel>



        <StackPanel Grid.Row="4" HorizontalAlignment="right">
            <Button Style="{StaticResource AnimatedRedButton}"
                    Margin="0,0,20,0"
                    Content="Export"/>
        </StackPanel>



        <StackPanel Grid.Row="5" Orientation="Horizontal">

            <Label Content="Voucher No : "
                   Margin="30,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <mah:NumericUpDown Height="30" 
                               Width="250"
                               FontSize="14"
                               VerticalContentAlignment="Center"
                               Maximum="9999"
                               Minimum="0"/>

            <Label Content="Date : "
                   Margin="50,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <DatePicker  Width="250"
                         Height="30"
                         VerticalContentAlignment="Center"/>


            <Label Content="Bank : "
                   Margin="55,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox Width="250"
                     Style="{StaticResource AccountsTextBox}"
                     Height="30"
                     VerticalContentAlignment="Center"/>
        </StackPanel>



        <StackPanel Grid.Row="6" Orientation="Horizontal">
            <Label Content="Party A/C : "
                   Margin="50,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox Width="250"
                      Style="{StaticResource AccountsComboBox}"
                      Height="30"
                      VerticalContentAlignment="Center"/>

            <Label Content="Amount : "
                   Margin="35,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox Width="250"
                     Style="{StaticResource AccountsTextBox}"
                     Height="30"
                     VerticalContentAlignment="Center"/>

            <Label Content="Branch : "
                   Margin="44,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox Width="250"
                     Style="{StaticResource AccountsTextBox}"
                     Height="30"
                     VerticalContentAlignment="Center"/>


        </StackPanel>





        <StackPanel Grid.Row="7" Orientation="Horizontal">
            <Label Content="Bank A/C : "
                   Margin="50,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox Width="250"
                      Style="{StaticResource AccountsComboBox}"
                      Height="30"
                      VerticalContentAlignment="Center"/>

            <Label Content="Exi :"
                   Margin="68,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox Width="250"
                     FontSize="14"
                     Height="30"
                     VerticalContentAlignment="Center"/>


            <Label Content="Chq No: "
                   Margin="38,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox Width="250"
                     Style="{StaticResource AccountsTextBox}"
                     Height="30"
                     VerticalContentAlignment="Center"/>




        </StackPanel>



        <StackPanel Grid.Row="8" Orientation="Horizontal">
            <Label Content=" Remarks : "
                   Margin="50,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox Width="250"
                      Style="{StaticResource AccountsTextBox}"
                      Height="30"
                      VerticalContentAlignment="Center"/>

            <Label Content="Ref No :  "
                   Margin="43,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox Width="250"
                     Style="{StaticResource AccountsTextBox}"
                     Height="30"
                     VerticalContentAlignment="Center"/>



            <Label Content="Chq Date : "
                   Margin="28,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <DatePicker  Width="250"
                         Height="30"
                         VerticalContentAlignment="Center"/>


        </StackPanel>


        <StackPanel Grid.Row="9" Orientation="Horizontal" Margin="0,0,0,-17" RenderTransformOrigin="0.5,0.5">
            <StackPanel.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="0.754"/>
                    <RotateTransform/>
                    <TranslateTransform X="0.487"/>
                </TransformGroup>
            </StackPanel.RenderTransform>

            <StackPanel Orientation="Horizontal" 
                        Margin="100,0,0,0"
                        VerticalAlignment="Center">

                <Button Content="Save" 
                        FontSize="14"
                        Style="{StaticResource AnimatedRedButton}">
                </Button>

                <Button Content="Edit" 
                        FontSize="14"
                        Style="{StaticResource AnimatedRedButton}">
                </Button>

                <Button Content="Delete" 
                        FontSize="14"
                        Style="{StaticResource AnimatedRedButton}">
                </Button>

                <Button Content="Clear"
                        FontSize="14"
                        Style="{StaticResource AnimatedRedButton}">
                </Button>

            </StackPanel>

            <Label Content="Collection Status : "
                   Margin="300,0,0,0"
                   VerticalAlignment="Top"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox Width="250"
                      VerticalAlignment="top"
                      Style="{StaticResource AccountsComboBox}"
                      Height="30"
                      VerticalContentAlignment="Center"/>

        </StackPanel>


    </Grid>
</UserControl>
    