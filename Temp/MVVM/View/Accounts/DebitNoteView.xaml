<UserControl
    x:Class="FlexMold.MVVM.View.Accounts.DebitNoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    BorderThickness="3"
    BorderBrush="White"
    Height="900"
    Width="1123"
    mc:Ignorable="d">

    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid Margin="10,20,0,10">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="613*"/>
            <ColumnDefinition Width="501*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" MinHeight="28"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="201*"/>
            <RowDefinition Height="Auto" MinHeight="39.62"/>
        </Grid.RowDefinitions>
        
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        <!-- DataGrid -->
        
        <DataGrid x:Name="dgDebitNotes"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Margin="22,44,22,321"
                  Grid.Row="2"
                  Grid.RowSpan="2"
                  Grid.ColumnSpan="2"
                  SelectionChanged="dgDebitNotes_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Voucher No" Width="120" Binding="{Binding VoucherNo}"/>
                <DataGridTextColumn Header="Date" Width="110" Binding="{Binding Date, StringFormat=d}"/>
                <DataGridTextColumn Header="Account Name" Width="160" Binding="{Binding AccountName}"/>
                <DataGridTextColumn Header="Party/Supplier" Width="150" Binding="{Binding SupplierName}"/>
                <DataGridTextColumn Header="Cash Account" Width="150" Binding="{Binding CashAccount}"/>
                <DataGridTextColumn Header="Amount" Width="110" Binding="{Binding Amount, StringFormat=N2}"/>
                <DataGridTextColumn Header="Narration" Width="*" Binding="{Binding Narration}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="188,3,0,-2" Width="360">    
            
            <Button x:Name="btnSave"   
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Save"   
                    Click="btnSave_Click"/>
            
            <Button x:Name="btnEdit"   
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Edit"   
                    Click="btnEdit_Click"/>
            
            <Button x:Name="btnDelete" 
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Delete" 
                    Click="btnDelete_Click"/>
            
            <Button x:Name="btnClear"  
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Clear"  
                    Click="btnClear_Click"/>
            
        </StackPanel>

        
        <TextBlock HorizontalAlignment="Left" Foreground="White"
                   Height="26" Margin="802,107,0,0" FontSize="15"
                   Grid.Row="3" TextWrapping="Wrap" FontWeight="Bold"
                   Text="0.00" VerticalAlignment="Top" Width="68" Grid.Column="1"/>

        
        <StackPanel Orientation="Horizontal" Margin="127,135,57,217" Grid.Row="3">
            
            <TextBlock Text="Voucher No : " 
                       VerticalAlignment="Center"
                       FontSize="15" 
                       FontWeight="Bold"
                       Foreground="White"/>
            
            <mah:NumericUpDown x:Name="numVoucherNo" 
                               Height="33" 
                               Width="267" 
                               Maximum="9999" 
                               Minimum="0"/>
       
        </StackPanel>

        
        <StackPanel Orientation="Horizontal" Margin="108,192,40,170" Grid.Row="3">
            
            <TextBlock Text="Party/Supplier :" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       FontSize="15" 
                       Foreground="White"/>
            
            <ComboBox x:Name="cmbParty" 
                      Width="267" 
                      Margin="10,0,0,0" 
                      Height="27" 
                      RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>

        
        <StackPanel Orientation="Horizontal" Margin="106,240,55,124" Grid.Row="3">

            <TextBlock Text="Account Name :" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       FontSize="15"
                       Foreground="White"/>
            
            <ComboBox x:Name="cmbAccount" 
                      Width="268" 
                      Margin="10,0,0,0" 
                      Height="27" 
                      RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>

       
        <StackPanel Orientation="Horizontal" Margin="142,282,65,81" Grid.Row="3">
 
            <TextBlock Text="Narration :" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       FontSize="15" 
                       Foreground="White"/>
            
            <TextBox x:Name="txtNarration" 
                     Width="268" 
                     Margin="10,0,0,0" 
                     Height="27" 
                     RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>

        
        <TextBlock HorizontalAlignment="Left"
                   Height="36" 
                   Margin="0,-12,0,0"
                   TextWrapping="Wrap" 
                   FontSize="24"
                   Text="Debit Note" 
                   Foreground="White" 
                   FontWeight="Bold"
                   VerticalAlignment="Top" 
                   Width="194"/>

        
        <StackPanel Orientation="Horizontal" Margin="609,141,91,225" Grid.Row="3" Grid.ColumnSpan="2">
        
            <TextBlock Text="Date :" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       FontSize="15" 
                       Foreground="White"/>
            
            <DatePicker x:Name="dpDate" 
                        Width="300" 
                        Margin="10,0,0,0" 
                        Height="27" 
                        RenderTransformOrigin="0.594,0.542"/>
        
        </StackPanel>

        
        <StackPanel Orientation="Horizontal" Margin="506,183,181,219" Grid.Row="3" Grid.ColumnSpan="2">
        
            <TextBlock Text="Cash Account :" 
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       FontSize="15" 
                       Foreground="White"/>
            
            <ComboBox x:Name="cmbCashAccount" 
                      Width="300" 
                      Margin="10,0,0,0" 
                      Height="27" 
                      RenderTransformOrigin="0.594,0.542"/>
        
        </StackPanel>

        
        <Border BorderBrush="white" 
                BorderThickness="4" 
                Grid.ColumnSpan="2" 
                HorizontalAlignment="Left" 
                Height="3" 
                Margin="106,107,0,0" 
                Grid.Row="3"
                VerticalAlignment="Top" 
                Width="900"/>

        <TextBlock HorizontalAlignment="Left"
                   Height="25" Margin="22,17,0,0"
                   TextWrapping="Wrap" FontSize="20"
                   Text="Search" Foreground="White" FontWeight="Light"
                   VerticalAlignment="Top" Width="194" Grid.Row="2"/>

        
        <StackPanel Orientation="Horizontal" Margin="586,188,105,178" Grid.Row="3" Grid.ColumnSpan="2">
        
            <TextBlock Text="Amount :"
                       FontWeight="Bold" 
                       VerticalAlignment="Center" 
                       FontSize="15" 
                       Foreground="White"/>
            
            <TextBox x:Name="txtAmount" 
                     Width="300" 
                     Margin="10,0,0,0" 
                     Height="27" 
                     RenderTransformOrigin="0.594,0.542" 
                     Text="0.00"/>
        
        </StackPanel>

        
        <StackPanel Grid.Column="1" Margin="61,254,22,10" Grid.Row="3" Grid.RowSpan="2">
            
            <Button Content="..." Click="ToggleFields_Click" Margin="0,0,0,10" Width="54" HorizontalAlignment="Left" Background="White"/>
            
            <StackPanel Name="FieldContainer" Visibility="Collapsed">
                
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account Group:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountGroupTextBox" Width="150"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountTextBox" Width="150"/>
                </StackPanel>
                
            </StackPanel>
            
        </StackPanel>
        
        
        
    </Grid>
    
</UserControl>