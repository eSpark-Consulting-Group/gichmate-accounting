<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" 
             x:Class="FlexMold.MVVM.View.Accounts.DebitNoteView"
             BorderThickness="7" 
             BorderBrush="White"
             Height="900" Width="1123">

    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </UserControl.Background>


    <Grid Margin="10,20,0,10">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="613*"/>
            <ColumnDefinition Width="501*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" MinHeight="28"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="201*"/>
            <RowDefinition Height="Auto" MinHeight="39.62"/>
        </Grid.RowDefinitions>

        <DataGrid ItemsSource="{Binding DebitNotes}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="True"
                  CanUserDeleteRows="True"
                  Margin="22,44,22,321"
                  Grid.Row="2"
                  Grid.RowSpan="2"
                  Grid.ColumnSpan="2">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="SL" Width="50" Binding="{Binding SL}"/>
                <DataGridTextColumn Header="Voucher No" Width="120" Binding="{Binding VoucherNo}"
         />
                <DataGridTextColumn Header="Date" Width="110" Binding="{Binding Date}"/>
                <DataGridTextColumn Header="Account Name" Width="160" Binding="{Binding PartyAccount}"/>
                <DataGridTextColumn Header="Party/Supplier" Width="150" Binding="{Binding SupplierName}"/>
                <DataGridTextColumn Header="Amount" Width="110" Binding="{Binding Amount}"/>
                <DataGridTextColumn Header="Narration" Width="*" Binding="{Binding Narration}"/>
            </DataGrid.Columns>
        </DataGrid>



        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="188,3,0,-2" Width="360">
            <StackPanel.Resources>
                <Style TargetType="Button" x:Key="AnimatedRedButton">
                    <Setter Property="Width" Value="80"/>
                    <Setter Property="Margin" Value="5"/>
                    <Setter Property="Foreground" Value="White"/>
                    <Setter Property="Background" Value="#FF6F0404"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Trigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation To="#FFAA0000"
                                                            Duration="0:0:0.3"
                                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"/>
                                                    <DoubleAnimation To="1.2"
                                                             Duration="0:0:0.3"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                                    <DoubleAnimation To="1.2"
                                                             Duration="0:0:0.3"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.EnterActions>
                                        <Trigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation To="#FF6F0404"
                                                            Duration="0:0:0.3"
                                                            Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"/>
                                                    <DoubleAnimation To="1.0"
                                                             Duration="0:0:0.3"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                                    <DoubleAnimation To="1.0"
                                                             Duration="0:0:0.3"
                                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </Trigger.ExitActions>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="5" ShadowDepth="2" Color="Black" Opacity="0.5"/>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>

            <Button Style="{StaticResource AnimatedRedButton}" Content="Save" />
            <Button Style="{StaticResource AnimatedRedButton}" Content="Edit" />
            <Button Style="{StaticResource AnimatedRedButton}" Content="Delete" />
            <Button Style="{StaticResource AnimatedRedButton}" Content="Clear" />
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" Foreground="White"
            Height="26" Margin="802,107,0,0" FontSize="15"
            Grid.Row="3" TextWrapping="Wrap" FontWeight="Bold"
            Text="0.00" VerticalAlignment="Top" Width="68" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" Margin="127,135,57,217" Grid.Row="3">
            <TextBlock Text="Voucher No : " VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="White"/>
            <mah:NumericUpDown Height="33" Width="267"
                               Maximum="9999"
                               Minimum="0"/>

        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="108,192,40,170" Grid.Row="3">
            <TextBlock Text="Party/Supplier :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="267" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Sample Suppliers"/>
                <ComboBoxItem Content="Supplier 1"/>
                <ComboBoxItem Content="eSpark"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="106,240,55,124" Grid.Row="3">
            <TextBlock Text="Account Name :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="268" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="142,282,65,81" Grid.Row="3">
            <TextBlock Text="Narration :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <TextBox Width="268" Margin="10,0,0,0" Height="12" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" 
                   Height="36" Margin="0,-12,0,0" 
                   TextWrapping="Wrap" FontSize="24"
                   Text="Debit Note" Foreground="White" FontWeight="Bold"
                   VerticalAlignment="Top" Width="194"/>
        <StackPanel Orientation="Horizontal" Margin="6,141,91,225" Grid.Row="3" Grid.Column="1">
            <TextBlock Text="Date :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <DatePicker Width="300" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="506,183,181,219" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Cash Account :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="300" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <Border BorderBrush="white" BorderThickness="4" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="3" Margin="106,107,0,0" Grid.Row="3" VerticalAlignment="Top" Width="900"/>
        <TextBlock HorizontalAlignment="Left" 
            Height="25" Margin="22,17,0,0" 
            TextWrapping="Wrap" FontSize="20"
            Text="Search" Foreground="White" FontWeight="Light"
            VerticalAlignment="Top" Width="194" Grid.Row="2"/>
        <StackPanel Orientation="Horizontal" Margin="586,188,105,178" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Amount :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <TextBox Width="300" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542" Text="0.00"/>
            <TextBlock Margin="40,0,0,0" Width="50" Foreground="White" Text="{Binding DebitNotes.Count}" />

        </StackPanel>


        <StackPanel Grid.Column="1" Margin="61,254,22,10" Grid.Row="3" Grid.RowSpan="2">
            <!-- Toggle Button -->
            <Button Content="..." Click="ToggleFields_Click" Margin="0,0,0,10" Width="54" HorizontalAlignment="Left" Background="White"/>

            <!-- Field Container -->
            <StackPanel Name="FieldContainer" Visibility="Collapsed">
                <!-- Account Group -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account Group:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountGroupTextBox" Width="150"/>
                </StackPanel>

                <!-- Account -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountTextBox" Width="150"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <!--<CheckBox Grid.Column="1" Content="" 
                  HorizontalAlignment="Left" 
                  Height="37" 
                  Margin="58,237,0,0"
                  Grid.Row="3"


                  BorderThickness="1"
                  VerticalAlignment="Top" 
                  Width="54"/>-->
    </Grid>
</UserControl>
