<UserControl
    x:Class="FlexMold.MVVM.View.Accounts.DebitNoteView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    BorderThickness="3"
    BorderBrush="White"
    Height="770" Width="1200">

    <UserControl.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </UserControl.Background>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">

            <Label Content="Debit Note" 
                   FontSize="20" 
                   FontWeight="Bold"/>

            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"
                    Command="{Binding DefaultAccountScreenCommand}" Margin="1000,0,0,0"/>

        </StackPanel>

        <StackPanel Grid.Row="1" >
            <DataGrid x:Name="dgDebitNotes"                    
                      Height="400"
                      HorizontalContentAlignment="Center"
                      TextBlock.TextAlignment="Center"
                      SelectionChanged="dgDebitNotes_SelectionChanged">

            </DataGrid>
        </StackPanel>


        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" >

            <Label Content="Voucher No :"
                   Margin="12,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <mah:NumericUpDown x:Name="numVoucherNo" 
                               Height="30" 
                               Width="250" 
                               Maximum="9999" 
                               VerticalContentAlignment="Center"
                               FontSize="14"
                               Minimum="0"/>

            <Label Content="Date :"
                   Style="{StaticResource AccountsLabel}"
                   Margin="107,0,0,0"/>

            <DatePicker x:Name="dpDate" 
                        Width="250" 
                        Height="30" 
                        VerticalContentAlignment="Center"
                        FontSize="14"/>

        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">

            <Label Content="Party/Supplier : " 
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox x:Name="cmbParty" 
                      Style="{StaticResource AccountsComboBox}"/>

            <Label Content="Amount :" 
                   Margin="90,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="txtAmount" 
                     Text="0.00"
                     Style="{StaticResource AccountsTextBox}"/>



        </StackPanel>



        <StackPanel Grid.Row="4" Orientation="Horizontal">

            <Label Content="Account Name : "
                   Margin="210,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox x:Name="cmbAccount"
                      Style="{StaticResource AccountsComboBox}"
              />
        </StackPanel>


        <StackPanel Grid.Row="5" Orientation="Horizontal" >

            <Label Content="Narration :  "
                   Margin="240,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="txtNarration" 
                     Style="{StaticResource AccountsTextBox}"/>
        </StackPanel>


        <StackPanel Grid.Row="7" Orientation="Horizontal">

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="270,0,0,0">
                <Button x:Name="btnSave"   
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Save" 
                    Click="btnSave_Click"/>

                <Button x:Name="btnEdit"   
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Edit"  
                    Click="btnEdit_Click"/>

                <Button x:Name="btnDelete" 
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Delete" 
                    Click="btnDelete_Click"/>

                <Button x:Name="btnClear"  
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Clear"
                    Click="btnClear_Click"/>

            </StackPanel>
        </StackPanel>


   </Grid>
</UserControl>
