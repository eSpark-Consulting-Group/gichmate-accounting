<UserControl x:Class="FlexMold.MVVM.View.Accounts.BankReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             BorderBrush="White"
             Loaded="UserControl_Loaded"
             BorderThickness="3"
             Height="770" Width="1200">

    <Grid Margin="0,0,0,-6">
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="40"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

     
        <StackPanel Grid.Row="0" HorizontalAlignment="Left" Orientation="Horizontal" Margin="0,0,0,55" Grid.RowSpan="2">
           
            <Label Content="Bank Receipt" 
                   FontSize="25" 
                   FontWeight="Bold"/>
        
            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"
                   
                    Click="Close_Click"
                    Margin="960,0,0,0" />
            
        </StackPanel>

        
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
           
            <Label Content="Collected By :" 
                   Style="{StaticResource AccountsLabel}"/>
            
            <ComboBox x:Name="PaidByCombo" 
                      Width="300" 
                      Height="30"/>
            
            <CheckBox Content="Auto-refresh"
                      FontSize="15"
                      x:Name="AutoRefreshChk"
                      Margin="50,0,0,0" 
                      VerticalAlignment="Center"/>                      
        </StackPanel>

        
        <StackPanel Grid.Row="2">
         
            <DataGrid x:Name="dgBankPayments" 
                      Width="1193" 
                      Height="300" 
                      FontSize="15" 
                      AutoGenerateColumns="False"
                      SelectionMode="Single" SelectionUnit="FullRow">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="50" Header="SL" Binding="{Binding RowNumber}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="150" Header="Voucher No" Binding="{Binding VchrNo}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="150" Header="Date" Binding="{Binding VchrDate, StringFormat=d}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="180" Header="Cash Account" Binding="{Binding ToAccountName}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="180" Header="Party Account" Binding="{Binding FromAccountName}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="150" Header="Amount" Binding="{Binding VchrAmount, StringFormat=N2}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="200" Header="Narration" Binding="{Binding Narration}" IsReadOnly="True"/>
                    <DataGridTextColumn Width="*" Header="Collected By" Binding="{Binding EmpName}" IsReadOnly="True"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        
        
        <StackPanel Grid.Row="3" Orientation="Horizontal">
           
            <Label Content="Total :" 
                   Style="{StaticResource AccountsLabel}" 
                   Margin="350,0,0,0"/>
            
            <TextBlock x:Name="TotalText" 
                       Text="0.00" 
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="White" 
                       FontSize="20"/>
            
            <Label Content="Bank Account Balance :" 
                   Margin="150,0,0,0" 
                   Style="{StaticResource AccountsLabel}"/>
            
            <TextBlock x:Name="BankBalanceText" Text="0.00" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="White" FontSize="20"/>
        
        </StackPanel>

       
        <StackPanel Grid.Row="4" Orientation="Horizontal" VerticalAlignment="Center">
            
            <Label Content="Voucher No :  "
                   Margin="13,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>
            
            <mah:NumericUpDown x:Name="VoucherNoBox" 
                               Width="297" 
                               Height="30" 
                               VerticalContentAlignment="Center"
                               FontSize="14"
                               Minimum="0" Maximum="99999"/>
            
            <Label Content="Date : " 
                   Margin="154,0,0,0" 
                   Style="{StaticResource AccountsLabel}"/>
           
            <DatePicker x:Name="VoucherDateBox" 
                        Width="300" 
                        Margin="5,0,0,0" 
                        Height="30"/>
        
        </StackPanel>

        
        <StackPanel Grid.Row="5" Orientation="Horizontal" VerticalAlignment="Center">
            
            <Label Content="Account : " 
                   Margin="37,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>
            
            <ComboBox x:Name="AccountCombo"
                      Width="300" 
                      Height="30"
                      FontSize="15"
                      Margin="10,0,0,0"
                      DisplayMemberPath="AccountName" 
                      SelectedValuePath="AccountId"/>
            
            <Label Content="Bank Account : " 
                   Margin="95,0,0,0" 
                   Style="{StaticResource AccountsLabel}"/>
            
            <ComboBox x:Name="BankAccountCombo" 
                      Width="300"
                      Height="30" 
                      DisplayMemberPath="AccountName" 
                      SelectedValuePath="AccountId"/>        
        </StackPanel>

        
        <StackPanel Grid.Row="6" Orientation="Horizontal" VerticalAlignment="Center">
            
            <Label Content="Amount : " 
                   Margin="38,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>
            
            <TextBox x:Name="AmountBox" 
                     Text="0.00" 
                     Width="300" 
                     Height="30" 
                     Margin="11,0,0,0"
                     PreviewTextInput="AmountBox_TextPreviewInput"/>
            
            <CheckBox x:Name="DiscountChk" 
                      Content="    Discount : "
                      FontSize="15"
                      Margin="86,0,0,0"
                      VerticalAlignment="Center" 
                      Width="9"/>
            
                    
            <TextBox x:Name="DiscountBox" 
                     Text="0.00"
                     Width="300" 
                     Height="30" 
                     PreviewTextInput="DiscountBox_TextPreviewInput"/>
        
        </StackPanel>

        
        
        <StackPanel Grid.Row="7" Orientation="Horizontal" VerticalAlignment="Center">
            
            <Label Content="Collected By : " 
                   Margin="10,0,0,0" 
                   Style="{StaticResource AccountsLabel}"/>
        
            <ComboBox x:Name="PaidByCombo2" 
                      Width="300" 
                      Height="30" 
                      Margin="11,0,0,0" 
                      DisplayMemberPath="EmpName" 
                      SelectedValuePath="EmpID"/>        
        </StackPanel>

        
        <StackPanel Grid.Row="8" Orientation="Horizontal" VerticalAlignment="Center">
            
            <Label Content="Narration : " 
                   Margin="28,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>
        
            <TextBox x:Name="NarrationBox" 
                     Text="..." 
                     Margin="12,0,0,0" 
                     Width="300" 
                     Height="30"/>        
        </StackPanel>

        
        <StackPanel Grid.Row="9" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,398,0">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Margin="460,0,0,0">
                
                <Button x:Name="SaveBtn" 
                        Style="{StaticResource AnimatedRedButton}" 
                        Content="Save"
                        Click="Save_Click">
                </Button>
        
                <Button x:Name="EditBtn" 
                        Style="{StaticResource AnimatedRedButton}" 
                        Content="Edit" 
                        Foreground="White" 
                        Click="EditBtn_Click">
                </Button>
                
                <Button x:Name="DeleteBtn" 
                        Style="{StaticResource AnimatedRedButton}" 
                        Content="Delete" 
                        Click="DeleteBtn_Click">
                </Button>
                
                <Button x:Name="ClearBtn" 
                        Style="{StaticResource AnimatedRedButton}"
                        Content="Clear"  
                        Click="ClearBtn_Click">
                </Button>
            
            
            </StackPanel>
        </StackPanel>

        <!-- Toggle Fields -->
        <StackPanel Margin="907,10,10,10" Grid.Row="7" Grid.RowSpan="3">
            <Button Content="..." Click="ToggleFields_Click" Margin="0,0,0,10" Width="54" HorizontalAlignment="Left" Background="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <StackPanel Name="FieldContainer" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account Group:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountGroupTextBox" Width="150"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountTextBox" Width="150"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
