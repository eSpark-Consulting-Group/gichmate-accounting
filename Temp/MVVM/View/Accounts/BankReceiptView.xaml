<UserControl x:Class="FlexMold.MVVM.View.Accounts.BankReceiptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
             BorderThickness="3" 
             BorderBrush="White"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             Height="900" Width="1300">


    <Control.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </Control.Background>


    <Grid Margin="10,20,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="613*"/>
            <ColumnDefinition Width="501*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" MinHeight="28"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="201*"/>
            <RowDefinition Height="Auto" MinHeight="39.62"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" Margin="26,20,26,349" Grid.Row="2">
            <TextBlock Text="Collected By :" VerticalAlignment="Center" Foreground="White" FontSize="14"/>
            <ComboBox Width="500" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>


        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="4,17,0,343" Width="148" Grid.Row="2" Grid.Column="1">
            <CheckBox  Content="Auto Refresh" Foreground="White" Height="17" Width="149" FontSize="14"/>
        </StackPanel>


        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False" FontSize="15"
                  Margin="20,59,30,394" RenderTransformOrigin="0.499,0.42" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="SL" Width="50" Binding="{Binding}"/>
                <DataGridTextColumn Header="Voucher No" Width="120" Binding="{Binding}"/>
                <DataGridTextColumn Header="Date" Width="110" Binding="{Binding}"/>
                <DataGridTextColumn Header="Cash Account" Width="160" Binding="{Binding}"/>
                <DataGridTextColumn Header="Party Account" Width="160" Binding="{Binding}"/>
                <DataGridTextColumn Header="Amount" Width="110" Binding="{Binding}"/>
                <DataGridTextColumn Header="Narration" Width="180" Binding="{Binding }"/>
                <DataGridTextColumn Header="Paid By" Width="*" Binding="{Binding}" />
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="15,295,0,61" Width="552" Grid.Column="1">
            <Button Content="Save" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Edit" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Delete" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Clear" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Print" Width="80" Background="#FF6F0404" Foreground="White" Height="28">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Mail" Width="80" Background="#FF6F0404" Foreground="White" Height="28">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" 
                   Height="22" Margin="360,16,0,0"
                   Grid.Row="3" TextWrapping="Wrap" 
                   Text="Total : "  FontWeight="Bold"
                   Foreground="White" FontSize="15"
                   VerticalAlignment="Top" Width="47"/>
        <TextBlock HorizontalAlignment="Left" Foreground="White"
                   Height="22" Margin="429,16,0,0"  FontSize="15"
                   Grid.Row="3" TextWrapping="Wrap" 
                   Text="0.00" FontWeight="Bold" VerticalAlignment="Top" Width="69" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.367"/>
                    <RotateTransform Angle="0.988"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock HorizontalAlignment="Left" FontWeight="Bold"
            Height="26" Margin="659,16,0,0"
            Grid.Row="3" TextWrapping="Wrap" 
            Text="Bank Account Balance :" 
            Foreground="White" FontSize="15"
            VerticalAlignment="Top" Width="173" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Left" Foreground="White"
            Height="26" Margin="802,107,0,0" FontSize="15"
            Grid.Row="3" TextWrapping="Wrap" FontWeight="Bold"
            Text="0.00" VerticalAlignment="Top" Width="68" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" Margin="28,57,239,293" Grid.Row="3">
            <TextBlock Text="Voucher No : " VerticalAlignment="Center" FontSize="15"  Foreground="White"/>
            <mah:NumericUpDown Height="33" Width="300"
                               Maximum="9999"
                               Minimum="0"/>

        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="54,113,239,250" Grid.Row="3">
            <TextBlock Text="Account :" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="296" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="54,158,239,202" Grid.Row="3">
            <TextBlock Text="Amount :" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <TextBox Width="298" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
            </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="25,209,234,155" Grid.Row="3">
            <TextBlock Text="Collected By :"  VerticalAlignment="Center" FontSize="15" Foreground="White" Width="90"/>
            <ComboBox Width="298" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="44,255,243,109" Grid.Row="3">
            <TextBlock Text="Narration :" VerticalAlignment="Center" FontSize="15" Foreground="White" Width="70"/>
            <TextBox Width="300" Margin="10,0,0,0" Height="18" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" 
                   Height="74" Margin="0,-21,0,0" 
                   TextWrapping="Wrap" FontSize="25"
                   Text="Bank Receipt" Foreground="White" FontWeight="Bold"
                   VerticalAlignment="Top" Width="292" Grid.RowSpan="3"/>
        <StackPanel Orientation="Horizontal" Margin="539,65,374,302" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Date :" VerticalAlignment="Center" FontSize="15" Foreground="White" Width="45"/>
            <DatePicker Width="301" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="414,121,272,0" Grid.Row="3" Grid.ColumnSpan="2" Height="0" VerticalAlignment="Top">
            <TextBlock Text="Cash Account :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="300" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <Border BorderBrush="white" BorderThickness="4" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="7" Margin="16,42,0,0" Grid.Row="3" VerticalAlignment="Top" Width="1234"/>
        <StackPanel Orientation="Horizontal" Margin="480,105,372,257" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Bank Account : " VerticalAlignment="Center" FontSize="15" Foreground="White" Width="105"/>
            <ComboBox Width="300" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Cash Account"/>
                <ComboBoxItem Content="Other Account"/>
                <ComboBoxItem Content="Other Payment Method"/>
            </ComboBox>
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="486,143,0,218" Width="98" Grid.Row="3">
            <CheckBox  Content="Discount :" Foreground="White" Height="17" Width="61" FontSize="15"/>
        </StackPanel>
        <TextBox 
                 HorizontalAlignment="Left" 
                 Height="26" 
                 Margin="596,150,0,0" 
                 Grid.Row="3" 
                 TextWrapping="Wrap" 
                 Text="0.00" 
                 VerticalAlignment="Top" Width="300" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Left" Foreground="White"
            Height="22" Margin="232,16,0,0"  FontSize="15"
            Grid.Row="3" TextWrapping="Wrap" 
            Text="0.00" FontWeight="Bold" VerticalAlignment="Top" Width="69" RenderTransformOrigin="0.5,0.5" Grid.Column="1">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.367"/>
                    <RotateTransform Angle="0.988"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>

        <StackPanel Margin="208,67,10,126" Grid.Row="3" Grid.Column="1">
            <!-- Toggle Button -->
            <Button Content="..." Click="ToggleFields_Click" Margin="0,0,0,10" Width="54" HorizontalAlignment="Left" Background="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <!-- Field Container -->
            <StackPanel Name="FieldContainer" Visibility="Collapsed">
                <!-- Account Group -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account Group:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountGroupTextBox" Width="150"/>
                </StackPanel>

                <!-- Account -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountTextBox" Width="150"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>



    </Grid>



</UserControl>
