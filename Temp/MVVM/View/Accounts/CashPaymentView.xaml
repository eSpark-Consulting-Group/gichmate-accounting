<UserControl x:Class="FlexMold.MVVM.View.Accounts.CashPaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             BorderThickness="3" 
             BorderBrush="White"
             mc:Ignorable="d" 
             Height="900" Width="1300">



    <Control.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </Control.Background>


    <Grid Margin="10,20,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="613*"/>
            <ColumnDefinition Width="501*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" MinHeight="28"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="201*"/>
            <RowDefinition Height="Auto" MinHeight="39.62"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" Margin="26,20,84,349" Grid.Row="2">
            <TextBlock Text="Paid By :" VerticalAlignment="Center" FontWeight="Bold" Foreground="White" FontSize="20"/>
            <ComboBox Width="500" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>


        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="4,17,0,343" Width="163" Grid.Row="2" Grid.Column="1">
            <CheckBox  Content="Auto Refresh" Foreground="White" Height="17" Width="218" FontSize="20"/>
        </StackPanel>


        <DataGrid Grid.Row="2" FontSize="20"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Margin="20,59,30,307" RenderTransformOrigin="0.499,0.42" Grid.ColumnSpan="2" Grid.RowSpan="2" >
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="SL" Width="50" Binding="{Binding}"/>
                <DataGridTextColumn Header="Voucher No" Width="150" Binding="{Binding}"/>
                <DataGridTextColumn Header="Date" Width="110" Binding="{Binding}"/>
                <DataGridTextColumn Header="Cash ACcount" Width="190" Binding="{Binding}"/>
                <DataGridTextColumn Header="Party Account" Width="190" Binding="{Binding}"/>
                <DataGridTextColumn Header="Amount" Width="150" Binding="{Binding}"/>
                <DataGridTextColumn Header="Narration" Width="250" Binding="{Binding }"/>
                <DataGridTextColumn Header="Paid By" Width="*" Binding="{Binding}" />
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="193,1,0,0" Width="366" Grid.Column="1">
            <Button Content="Save" Width="80" Margin="5" Background="#FF6F0404" Foreground="White" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Edit" Width="80" Margin="5" Background="#FF6F0404" Foreground="White" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Delete" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Clear" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" 
                   Height="22" Margin="312,107,0,0"
                   Grid.Row="3" TextWrapping="Wrap" 
                   Text="Total : "  FontWeight="Bold"
                   Foreground="White" FontSize="15"
                   VerticalAlignment="Top" Width="47"/>
        <TextBlock HorizontalAlignment="Left" Foreground="White"
                   Height="22" Margin="381,107,0,0"  FontSize="15"
                   Grid.Row="3" TextWrapping="Wrap" 
                   Text="0.00" FontWeight="Bold" VerticalAlignment="Top" Width="69" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.367"/>
                    <RotateTransform Angle="0.988"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock HorizontalAlignment="Left" FontWeight="Bold"
            Height="26" Margin="611,107,0,0"
            Grid.Row="3" TextWrapping="Wrap" 
            Text="Cash Account Balance :" 
            Foreground="White" FontSize="15"
            VerticalAlignment="Top" Width="167" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Left" Foreground="White"
            Height="26" Margin="802,107,0,0" FontSize="15"
            Grid.Row="3" TextWrapping="Wrap" FontWeight="Bold"
            Text="0.00" VerticalAlignment="Top" Width="68" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" Margin="23,149,254,202" Grid.Row="3">
            <TextBlock Text="Voucher No : " VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="White"/>
            <mah:NumericUpDown Height="33" Width="300"
                               Maximum="9999"
                               Minimum="0"/>

        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="49,205,260,165" Grid.Row="3">
            <TextBlock Text="Account :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="298" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="52,250,260,111" Grid.Row="3">
            <TextBlock Text="Amount :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <TextBox Width="297" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
            </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="22,298,235,58" Grid.Row="3">
            <TextBlock Text="        Paid By :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="298" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="40,346,248,17" Grid.Row="3">
            <TextBlock Text="Narration :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <TextBox Width="298" Margin="10,0,0,0" Height="16" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" 
                   Height="67" Margin="0,-12,0,0" 
                   TextWrapping="Wrap" FontSize="35"
                   Text="Cash Payment" Foreground="White" FontWeight="Bold"                  
                   VerticalAlignment="Top" Width="412" Grid.RowSpan="3"/>
        <StackPanel Orientation="Horizontal" Margin="523,146,377,202" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Date :  " FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <DatePicker Width="303" Height="27" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="397,225,290,170" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Cash Account :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="300" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <Border BorderBrush="white" BorderThickness="4" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="8" Margin="0,133,0,0" Grid.Row="3" VerticalAlignment="Top" Width="1280"/>
        <StackPanel Orientation="Horizontal" Margin="462,202,384,161" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Cash Account :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White" Width="105"/>
            <ComboBox Width="300" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Cash Account"/>
                <ComboBoxItem Content="Other Account"/>
                <ComboBoxItem Content="Other Payment Method"/>
            </ComboBox>
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="470,250,0,112" Width="99" Grid.Row="3">
            <CheckBox  Content="Discount :" Foreground="White" Height="17" Width="61" FontWeight="Bold" FontSize="15"/>
        </StackPanel>
        <TextBox 
                 HorizontalAlignment="Left" 
                 Height="26" 
                 Margin="578,254,0,0" 
                 Grid.Row="3" 
                 TextWrapping="Wrap" 
                 Text="0.00" 
                 VerticalAlignment="Top" Width="300" Grid.ColumnSpan="2"/>

        <StackPanel Margin="208,157,0,10" Grid.Row="3" Grid.Column="1">
            <!-- Toggle Button -->
            <Button Content="..." Click="ToggleFields_Click" Margin="0,0,0,10" Width="54" HorizontalAlignment="Left" Background="White"/>

            <!-- Field Container -->
            <StackPanel Name="FieldContainer" Visibility="Collapsed">
                <!-- Account Group -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account Group:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountGroupTextBox" Width="150"/>
                </StackPanel>

                <!-- Account -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountTextBox" Width="150"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" Foreground="White"
            Height="22" Margin="85,107,0,0"  FontSize="15"
            Grid.Row="3" TextWrapping="Wrap" 
            Text="0.00" FontWeight="Bold" VerticalAlignment="Top" Width="69" RenderTransformOrigin="0.5,0.5" Grid.Column="1">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.367"/>
                    <RotateTransform Angle="0.988"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>


    </Grid>
</UserControl>
