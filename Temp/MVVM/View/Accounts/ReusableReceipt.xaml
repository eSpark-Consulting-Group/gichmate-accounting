<Window x:Class="FlexMold.MVVM.View.Accounts.ReusableReceipt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
        mc:Ignorable="d"
        Title="ReusableReceipt" 
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        WindowStyle="ThreeDBorderWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Height="700" 
        BorderThickness="7" 
        BorderBrush="White"
        Width="1200" Background="#FF4A4A4A">


    <Window.Resources>
        <Style TargetType="Button" x:Key="AnimatedRedButton">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF6F0404"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
            CornerRadius="5"
            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation To="#FFAA0000"
                                        Duration="0:0:0.3"
                                        Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"/>
                                            <DoubleAnimation To="1.2"
                                         Duration="0:0:0.3"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation To="1.2"
                                         Duration="0:0:0.3"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation To="#FF6F0404"
                                        Duration="0:0:0.3"
                                        Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"/>
                                            <DoubleAnimation To="1.0"
                                         Duration="0:0:0.3"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation To="1.0"
                                         Duration="0:0:0.3"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="9" Color="White" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="280"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
            <TextBlock Text="- GENERAL RECEIPT -"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       />
        </StackPanel>


        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="Amount Paid :" 
                   Margin="90,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="14"/>
            <TextBox Text="0.00"
                     FontSize="14"
                     Width="300" Height="30" 
                     VerticalAlignment="Center" VerticalContentAlignment="Center"/>

            <Label Content="Voucher No :"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Margin="10,0,0,0"/>
            <mah:NumericUpDown Maximum="9999"
                               Minimum="0"
                               FontSize="14"
                               VerticalAlignment="Center"
                               VerticalContentAlignment="Center"
                               Width="200"
                               Height="30"/>

            <Label Margin="10,0,0,0"
                   Content="Date :"
                   FontSize="14"
                   VerticalAlignment="Center"/>
            <DatePicker Width="200"
                        Height="30"
                        FontSize="14"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Center"/>
        </StackPanel>


        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="Paid By :"
                   FontSize="14"
                   Margin="120,0,0,0" 
                   VerticalAlignment="Center"/>

            <ComboBox Width="300"
                      Height="30" 
                      FontSize="14"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center" 
                      Margin="10,0,0,0">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="General"/>
            </ComboBox>

            <Label Content="Cash / Bank :"
                   FontSize="14"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   VerticalContentAlignment="Center"/>
            <ComboBox Width="200"
                      Height="30"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="Cash"/>
                <ComboBoxItem Content="Bank Account"/>
            </ComboBox>

        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="Collected By :"
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="90,0,0,0"/>
            <ComboBox Width="300"
                      Height="30"
                      FontSize="14"
                      Margin="7,0,0,0"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="User1"/>
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="All"/>
            </ComboBox>


            <Label Content="Remarks :" 
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="40,0,0,0" Width="68"
                   />
            <TextBox Width="463"/>

            <Button Margin="10,0,0,0" 
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Update" Background="#FF3A0000" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>

        <StackPanel Grid.Row="4" >
            <DataGrid Width="1132" FontSize="14" Height="288">
                <DataGrid.Columns>
                    <DataGridTextColumn     Width="90"  Header="SL"/>
                    <DataGridTextColumn     Width="120" Header="Voucher No"/>
                    <DataGridTextColumn     Width="150" Header="Date"/>
                    <DataGridTextColumn     Width="150"  Header="AMOUNT"/>
                    <DataGridTextColumn     Width="170" Header="PAID BY"/>
                    <DataGridTextColumn     Width="170" Header="COLLECTED BY"/>
                    <DataGridTextColumn     Width="*"   Header="NARRATION"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>

        <StackPanel Grid.Row="5" Orientation="Horizontal"  HorizontalAlignment="Center">
            

            <Button Style="{StaticResource AnimatedRedButton}" Content="Save" Background="#FF3A0000" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Style="{StaticResource AnimatedRedButton}" Content="Edit" Background="#FF3A0000" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Style="{StaticResource AnimatedRedButton}" Content="Delete" Background="#FF3A0000" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Style="{StaticResource AnimatedRedButton}" Content="Clear" Background="#FF3A0000" >
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>


    </Grid>
</Window>
