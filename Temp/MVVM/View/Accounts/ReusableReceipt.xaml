<Window x:Class="AccountsPRO.MVVM.View.Accounts.ReusableReceipt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccountsPRO.MVVM.View.Accounts"
        mc:Ignorable="d"
        Title="ReusableReceipt" 
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        WindowStyle="ThreeDBorderWindow"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"             
        BorderThickness="3" 
        BorderBrush="White"
        Height="770" Width="1200">

  
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="400"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Center">
            
            <TextBlock Text="- GENERAL RECEIPT -"
                       FontSize="20"
                       Foreground="White"
                       FontWeight="Bold"
                       />

            <!--<Button Content="X" 
                FontSize="20"
                Width="40"
                Style="{StaticResource AnimatedRedButton}"
                Background="ForestGreen"
                Click="Close_Click"
                Margin="920,0,0,0" />-->
            
        </StackPanel>


        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
            
            <Label Content="Amount Paid :" 
                   Margin="46,0,0,0"
                   VerticalAlignment="Center"
                   FontSize="14"/>
            <TextBox Text="0.00"
                     FontSize="14"
                     Width="250" Height="30" 
                     VerticalAlignment="Center" VerticalContentAlignment="Center"/>

            <Label Content="Voucher No :"
                   VerticalAlignment="Center"
                   FontSize="14"
                   Margin="10,0,0,0"/>
            
            <mah:NumericUpDown Maximum="9999"
                               Minimum="0"
                               FontSize="14"
                               VerticalAlignment="Center"
                               VerticalContentAlignment="Center"
                               Width="250"
                               Height="30"/>

            <Label Margin="10,0,0,0"
                   Content="Date :"
                   FontSize="14"
                   VerticalAlignment="Center"/>
            
            <DatePicker Width="250"
                        Height="30"
                        FontSize="14"
                        VerticalContentAlignment="Center"
                        VerticalAlignment="Center"/>
        </StackPanel>


        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="Paid By :"
                   FontSize="14"
                   Margin="80,0,0,0" 
                   VerticalAlignment="Center"/>

            <ComboBox Width="250"
                      Height="30" 
                      FontSize="14"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center" 
                      Margin="8,0,0,0">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="General"/>
            </ComboBox>

            <Label Content="Cash / Bank :"
                   FontSize="14"
                   Margin="16,0,0,0"
                   VerticalAlignment="Center"
                   VerticalContentAlignment="Center"/>
            <ComboBox Width="250"
                      Height="30"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="Cash"/>
                <ComboBoxItem Content="Bank Account"/>
            </ComboBox>

        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center">
            <Label Content="Collected By :"
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="50,0,0,0"/>
            <ComboBox Width="250"
                      Height="30"
                      FontSize="14"
                      Margin="7,0,0,0"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="User1"/>
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="All"/>
            </ComboBox>


            <Label Content="Remarks :" 
                   FontSize="14"
                   VerticalAlignment="Center"
                   Margin="36,0,0,0" Width="68"
                   />
            <TextBox Width="250"/>

            <Button Margin="10,0,0,0" 
                    Style="{StaticResource AnimatedRedButton}" 
                    Content="Update" >
               
            </Button>
        </StackPanel>

        
        <StackPanel Grid.Row="4" >
            <DataGrid Width="1132" 
                      FontSize="14" 
                      Height="400" 
                      Margin="0,10,0,0"
                      HorizontalContentAlignment="Center"
                      TextBlock.TextAlignment="Center">
                
                <DataGrid.Columns>
                                       
                    <DataGridTextColumn     Width="120" Header="Voucher No"/>
                    <DataGridTextColumn     Width="150" Header="Date"/>
                    <DataGridTextColumn     Width="150" Header="AMOUNT"/>
                    <DataGridTextColumn     Width="170" Header="PAID BY"/>
                    <DataGridTextColumn     Width="170" Header="COLLECTED BY"/>
                    <DataGridTextColumn     Width="*"   Header="NARRATION"/>
                
                </DataGrid.Columns>
            
            </DataGrid>
        </StackPanel>


        <StackPanel Grid.Row="5" Orientation="Horizontal"  HorizontalAlignment="Center" Margin="0,0,0,16">
            
            <Button 
                Style="{StaticResource AnimatedRedButton}" 
                Content="Save"  >
               
            </Button>
            
            <Button 
                Style="{StaticResource AnimatedRedButton}" 
                Content="Edit"  >
                
            </Button>
            
            <Button 
                Style="{StaticResource AnimatedRedButton}" 
                Content="Delete" >
               
            </Button>
            
            <Button 
                Style="{StaticResource AnimatedRedButton}" 
                Content="Clear">
            
            </Button>
            
        </StackPanel>


    </Grid>
</Window>
