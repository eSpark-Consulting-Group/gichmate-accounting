<UserControl x:Class="FlexMold.MVVM.View.Accounts.BankPaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts" xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             Height="900" Width="1300">


    <UserControl.Resources>
        <Style TargetType="Button" x:Key="AnimatedRedButton">
            <Setter Property="Width" Value="70"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#FF6F0404"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
            CornerRadius="5"
            SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation To="#FFAA0000"
                                        Duration="0:0:0.3"
                                        Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"/>
                                            <DoubleAnimation To="1.2"
                                         Duration="0:0:0.3"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation To="1.2"
                                         Duration="0:0:0.3"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation To="#FF6F0404"
                                        Duration="0:0:0.3"
                                        Storyboard.TargetProperty="(Background).(SolidColorBrush.Color)"/>
                                            <DoubleAnimation To="1.0"
                                         Duration="0:0:0.3"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"/>
                                            <DoubleAnimation To="1.0"
                                         Duration="0:0:0.3"
                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="5" ShadowDepth="9" Color="White" Opacity="0.7"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Row="0" HorizontalAlignment="Left">
            <Label Content="Bank Payment"
                   FontSize="30"
                   FontWeight="Bold"/>
        </StackPanel>


        <StackPanel Grid.Row="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

            <Label Content="Paid By :"
                   FontSize="20"
                   VerticalAlignment="Center"
                   VerticalContentAlignment="Center"/>

            <ComboBox Width="555"
                      Height="40"
                      VerticalAlignment="Center"                      
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Seda"/>
            </ComboBox>

            <CheckBox Margin="30,0,0,0"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center" Width="90" RenderTransformOrigin="0.5,0.5">
                <CheckBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </CheckBox.RenderTransform>
            </CheckBox>

            <Label Content="Auto-refresh"
                   Margin="5,0,0,0"
                   FontSize="20"
                   VerticalAlignment="Center"/>
        </StackPanel>


        <StackPanel Grid.Row="2" >
            <DataGrid Width="1280"
                      Height="300"
                      FontSize="20">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="70"  Header="SL"/>
                    <DataGridTextColumn Width="150" Header="Voucher No"/>
                    <DataGridTextColumn Width="150" Header="Date"/>
                    <DataGridTextColumn Width="180" Header="Cash Account"/>
                    <DataGridTextColumn Width="180" Header="Party Account"/>
                    <DataGridTextColumn Width="150" Header="Amount"/>
                    <DataGridTextColumn Width="200" Header="Narration"/>
                    <DataGridTextColumn Width="*" Header="Paid By"/>
                </DataGrid.Columns>
            </DataGrid>
        </StackPanel>


        <StackPanel Grid.Row="3"
                    Orientation="Horizontal">

            <Label Content="Total :"
                   VerticalAlignment="Center"
                   Margin="400,0,0,0"/>

            <TextBlock Text="0.00"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="20"/>

            <Label Content="Bank Account Balance :"
                   Margin="150,0,0,0"
                   VerticalAlignment="Center"/>

            <TextBlock Text="0.00"
                       Margin="10,0,0,0"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="20"/>
        </StackPanel>

        <StackPanel Grid.Row="4"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <Label Content="Voucher No :"
                   />
            <mah:NumericUpDown Width="300"
                               Height="40"
                               VerticalContentAlignment="Center"/>

            <Label Content="Date :"
                   Margin="154,0,0,0"
                   VerticalAlignment="Center"
                   />
            <DatePicker Width="300"
                        Margin="5,0,0,0"
                        Height="40"
                        VerticalAlignment="Center"
                        VerticalContentAlignment="Center"/>
        </StackPanel>

        <StackPanel Grid.Row="5"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <Label Content="Account :"
                   Margin="37,0,0,0"
                   VerticalAlignment="Center"/>

            <ComboBox Width="300"
                      Height="40"
                      Margin="10,0,0,0"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="Seda"/>
            </ComboBox>

            <Label Content="Bank Account :"
                   Margin="80,0,0,0"
                   VerticalAlignment="Center"/>

            <ComboBox Width="300">
                <ComboBoxItem Content="Bank Account"/>
                <ComboBoxItem Content="Cash Account"/>
                <ComboBoxItem Content="Demo Account"/>
            </ComboBox>
        </StackPanel>


        <StackPanel Grid.Row="6"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <Label Content="Amount :"
                   Margin="37,0,0,0"/>

            <TextBox Text="0.00"
                     Width="300"
                     Height="40"
                     Margin="11,0,0,0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"/>

            <CheckBox VerticalAlignment="Center" 
                      Width="9" 
                      RenderTransformOrigin="0.5,0.5"                       
                      >
                <CheckBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </CheckBox.RenderTransform>
            </CheckBox>

            <Label Content="Discount :"
                   VerticalAlignment="Center"
                  />

            <TextBox Text="0.00"
                     Margin="0,0,0,0"
                     VerticalAlignment="Center"
                     VerticalContentAlignment="Center"
                     Width="300"
                     Height="40"/>
        </StackPanel>

        <StackPanel Grid.Row="7" 
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <Label Content="Paid By :"
                   Margin="45,0,0,0"
                   VerticalAlignment="Center"/>
            <ComboBox Width="300"
                      Height="40"
                      Margin="11,0,0,0">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="Demo"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

            <Label Content="Narration :"
                   Margin="25,0,0,0"/>

            <TextBox Text="..."
                     Margin="12,0,0,0"
                     Width="300"
                     Height="40"/>
        </StackPanel>

        <StackPanel Grid.Row="9"
                    Orientation="Horizontal"
                    VerticalAlignment="Center" Margin="0,0,398,0">

            <StackPanel VerticalAlignment="Center" Orientation="Horizontal"
                        Margin="460,0,0,0">

                <Button Style="{StaticResource AnimatedRedButton}" 
                        Content="Save" 
                        Foreground="White" 
                        Background="#FF3A0000" >
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>
                <Button Style="{StaticResource AnimatedRedButton}" 
                        Content="Edit" 
                        Foreground="White" 
                        Background="#FF3A0000" >
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>
                <Button Style="{StaticResource AnimatedRedButton}"
                        Content="Delete" 
                        Background="#FF3A0000" >
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>
                <Button Style="{StaticResource AnimatedRedButton}" Content="Clear" Background="#FF3A0000" >
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>

            </StackPanel>

        </StackPanel>



        <StackPanel Margin="907,10,10,10" Grid.Row="7" Grid.RowSpan="3">
            <!-- Toggle Button -->
            <Button Content="..." Click="ToggleFields_Click" Margin="0,0,0,10" Width="54" HorizontalAlignment="Left" Background="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <!-- Field Container -->
            <StackPanel Name="FieldContainer" Visibility="Collapsed">
                <!-- Account Group -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account Group:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountGroupTextBox" Width="150"/>
                </StackPanel>

                <!-- Account -->
                <StackPanel Orientation="Horizontal" Margin="5">
                    <Label Content="Account:" Width="120" VerticalAlignment="Center"/>
                    <TextBox Name="AccountTextBox" Width="150"/>
                </StackPanel>
            </StackPanel>
        </StackPanel>


    </Grid>
</UserControl>
