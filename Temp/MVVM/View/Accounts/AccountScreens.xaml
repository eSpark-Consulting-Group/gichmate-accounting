<Window
        xmlns:local="clr-namespace:AccountsPRO.MVVM.View.Accounts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" x:Class="AccountsPRO.MVVM.View.Accounts.AccountsScreens"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        BorderThickness="3"
        BorderBrush="White"
        ResizeMode="NoResize"
        WindowStyle="None"
        Title="MainWindow" Height="900" Width="1123">

    <Window.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </Window.Background>


    <Grid Margin="10,20,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="613*"/>
            <ColumnDefinition Width="501*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" MinHeight="28"/>
            <RowDefinition Height="Auto" MinHeight="0"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="201*"/>
            <RowDefinition Height="Auto" MinHeight="39.62"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" Margin="26,20,1,349" Grid.Row="2">
            <TextBlock Text="Paid By :" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
            <ComboBox Width="462" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>


        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="4,17,0,343" Width="124" Grid.Row="2" Grid.Column="1">
            <CheckBox  Content="Auto Refresh" Foreground="White" Height="17" Width="135"/>
        </StackPanel>


        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  Margin="20,59,30,307" RenderTransformOrigin="0.499,0.42" Grid.ColumnSpan="2" Grid.RowSpan="2">
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="SL" Width="50" Binding="{Binding SL}"/>
                <DataGridTextColumn Header="Voucher No" Width="120" Binding="{Binding VoucherNo}"/>
                <DataGridTextColumn Header="Date" Width="110" Binding="{Binding Date}"/>
                <DataGridTextColumn Header="Party Account" Width="160" Binding="{Binding PartyAccount}"/>
                <DataGridTextColumn Header="Amount" Width="110" Binding="{Binding Amount}"/>
                <DataGridTextColumn Header="Narration" Width="180" Binding="{Binding Delete}"/>
                <DataGridTextColumn Header="Paid By" Width="*" Binding="{Binding}" />
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="69,350,0,0" Width="360" Grid.Column="1">
            <Button Content="Save" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Delete" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Clear" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Search" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" 
                   Height="22" Margin="312,107,0,0"
                   Grid.Row="3" TextWrapping="Wrap" 
                   Text="Total : "  FontWeight="Bold"
                   Foreground="White" FontSize="15"
                   VerticalAlignment="Top" Width="47"/>
        <TextBlock HorizontalAlignment="Left" Foreground="White"
                   Height="22" Margin="381,107,0,0"  FontSize="15"
                   Grid.Row="3" TextWrapping="Wrap" 
                   Text="0.00" FontWeight="Bold" VerticalAlignment="Top" Width="69" RenderTransformOrigin="0.5,0.5">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform AngleX="-0.367"/>
                    <RotateTransform Angle="0.988"/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock HorizontalAlignment="Left" FontWeight="Bold"
            Height="26" Margin="611,107,0,0"
            Grid.Row="3" TextWrapping="Wrap" 
            Text="Cash Account Balance :" 
            Foreground="White" FontSize="15"
            VerticalAlignment="Top" Width="167" Grid.ColumnSpan="2"/>
        <TextBlock HorizontalAlignment="Left" Foreground="White"
            Height="26" Margin="802,107,0,0" FontSize="15"
            Grid.Row="3" TextWrapping="Wrap" FontWeight="Bold"
            Text="0.00" VerticalAlignment="Top" Width="68" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" Margin="123,148,82,196" Grid.Row="3">
            <TextBlock Text="Voucher No : " VerticalAlignment="Center" FontSize="14" Foreground="White"/>
            <mah:NumericUpDown Height="20" Width="300"
                               Maximum="9999" FontSize="14" VerticalContentAlignment="Center"
                               Minimum="0"/>

        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="145,200,76,166" Grid.Row="3">
            <TextBlock Text="Account :" VerticalAlignment="Center" FontSize="14" Foreground="White"/>
            <ComboBox Width="300" 
                      Margin="10,0,0,0" 
                      Height="20" 
                      FontSize="14"
                      VerticalAlignment="Center"
                      VerticalContentAlignment="Center"
                      RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="145,241,83,128" Grid.Row="3">
            <TextBlock Text="Amount :" VerticalAlignment="Center" FontSize="14" Foreground="White"/>
            <TextBox Width="303" Margin="10,0,0,0" Height="22" RenderTransformOrigin="0.594,0.542">
                <TextBox.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleY="-1"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </TextBox.RenderTransform>
            </TextBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="151,291,83,82" Grid.Row="3">
            <TextBlock Text="Paid By :" VerticalAlignment="Center" FontSize="14" Foreground="White"/>
            <ComboBox Width="303" Margin="10,0,0,0" Height="20" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="138,331,81,38" Grid.Row="3">
            <TextBlock Text="Narration :" VerticalAlignment="Center" FontSize="14" Foreground="White"/>
            <TextBox Width="303" Margin="10,0,0,0" Height="20" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" 
                   Height="36" Margin="0,-12,0,0" 
                   TextWrapping="Wrap" FontSize="24"
                   Text="Cash Payment" Foreground="White" FontWeight="Bold"
                   VerticalAlignment="Top" Width="194"/>
        <StackPanel Orientation="Horizontal" Margin="51,154,61,211" Grid.Row="3" Grid.Column="1">
            <TextBlock Text="Date :" VerticalAlignment="Center" FontSize="14" Foreground="White"/>
            <DatePicker Width="300" Margin="10,0,0,0" Height="10" RenderTransformOrigin="0.594,0.542">
                <DatePicker.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="0"/>
                        <RotateTransform/>
                        <TranslateTransform X="0"/>
                    </TransformGroup>
                </DatePicker.RenderTransform>
            </DatePicker>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="538,217,149,178" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Cash Account :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="300" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <Border BorderBrush="white" BorderThickness="4" Grid.ColumnSpan="2" HorizontalAlignment="Left" Height="10" Margin="120,133,0,0" Grid.Row="3" VerticalAlignment="Top" Width="900"/>
        <StackPanel Orientation="Horizontal" Margin="604,206,87,161" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Cash Account :" VerticalAlignment="Center" FontSize="14" Foreground="White" Width="98"/>
            <ComboBox Width="300" Margin="1,0,0,0" Height="30" RenderTransformOrigin="0.594,0.542" SelectionChanged="ComboBox_SelectionChanged">
                <ComboBoxItem Content="Cash Account"/>
                <ComboBoxItem Content="Other Account"/>
                <ComboBoxItem Content="Other Payment Method"/>
            </ComboBox>
        </StackPanel>
        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal" Margin="4,247,0,115" Width="99" Grid.Row="3" Grid.Column="1">
            <CheckBox  Content="Discount :" Foreground="White" Height="17" Width="61" FontSize="14"/>
        </StackPanel>
        <TextBox Grid.Column="1" 
                 HorizontalAlignment="Left" 
                 Height="26" 
                 Margin="99,254,0,0" 
                 Grid.Row="3" 
                 TextWrapping="Wrap" 
                 Text="0.00" 
                 VerticalAlignment="Top" Width="300"/>
    </Grid>
</Window>