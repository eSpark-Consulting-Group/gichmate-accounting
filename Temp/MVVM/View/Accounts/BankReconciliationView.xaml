<!-- BankReconciliationView.xaml -->
<UserControl x:Class="FlexMold.MVVM.View.Accounts.BankReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             BorderThickness="3" 
             BorderBrush="White"
             mc:Ignorable="d" 
             Height="700" Width="1200">


    <Control.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFEE4540" Offset="0"/>
            <GradientStop Color="#FFC72C41" Offset="0.2"/>
            <GradientStop Color="#FF801336" Offset="0.4"/>
            <GradientStop Color="#FF670E33" Offset="0.6"/>
            <GradientStop Color="#FF510A32" Offset="0.8"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
        </LinearGradientBrush>
    </Control.Background>

    <Grid Margin="10,20,4,10">

        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="100"/>
            <RowDefinition Height="450"/>
            <RowDefinition Height="50"/>            
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   HorizontalAlignment="Left" 
                   Height="40" 
                   TextWrapping="Wrap" FontSize="30"
                   Text="Bank Reconciliation" Foreground="White" FontWeight="Bold" 
                   VerticalAlignment="Center" Width="336"/>


        <StackPanel Grid.Row="1" Orientation="Horizontal" Grid.ColumnSpan="3">
            <Label Content="Bank Account : " VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbBankAccount"
                      VerticalAlignment="Center" Width="300" Height="40" VerticalContentAlignment="Center">

                <ComboBoxItem Content="BANK ACCOUNT"/>

            </ComboBox>


            <Label Content="Date: " 
                   VerticalAlignment="Center" 
                   Margin="50,0,0,0"/>
            <DatePicker x:Name="dpDate"
                        VerticalAlignment="Center" 
                        Width="300" Height="40" 
                        VerticalContentAlignment="Center"/>

            <Button x:Name="btnLoad"
                    Style="{StaticResource AnimatedRedButton}" 
                    VerticalAlignment="Center" Width="120" Height="40" Margin="50,0,0,0" 
                    Foreground="White"                  
                    Content="Load"
                    Background="ForestGreen"
                    FontSize="20"
                    Click="btnLoad_Click">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>

        <DataGrid x:Name="dgBankReconciliation"
          Grid.Row="2"
          AutoGenerateColumns="False"
          HeadersVisibility="All"
          CanUserAddRows="False"
          CanUserDeleteRows="False"
          FontSize="14"
          FontWeight="ExtraBold"
          IsReadOnly="False">
            <DataGrid.Columns>
                <!-- Hidden column for VchrId -->
                <DataGridTextColumn Header="VchrId" Binding="{Binding VchrId}" Visibility="Collapsed"/>
                <DataGridTextColumn Header="SL" Width="40" Binding="{Binding SL}" IsReadOnly="True"/>
                <DataGridTextColumn Header="INV No" Width="80" Binding="{Binding InvoiceNo}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Invoice Type" Width="140" Binding="{Binding InvoiceType}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Particulars" Width="170" Binding="{Binding Particulars}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Invoice Date" Width="170" Binding="{Binding InvoiceDate, StringFormat=d}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Bank Date" Width="130" 
                            Binding="{Binding BankDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <DataGridTextColumn Header="Debit" Width="150" Binding="{Binding Debit}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Credit" Width="150" Binding="{Binding Credit}" IsReadOnly="True"/>
                <DataGridTextColumn Header="Remarks" Width="*" Binding="{Binding Remarks}" IsReadOnly="True"/>
            </DataGrid.Columns>
        </DataGrid>



        <!-- Update Button -->
        <Button x:Name="btnUpdate"
                Grid.Row="3" 
                Content="Update" 
                FontSize="20"                
                Background="ForestGreen" 
                HorizontalAlignment="Right"
                Margin="0,0,130,0"
                Width="120" Height="40"
                Style="{StaticResource AnimatedRedButton}"
                Click="btnUpdate_Click">
            
        </Button>

    </Grid>
</UserControl>
