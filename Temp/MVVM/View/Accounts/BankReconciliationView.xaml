<UserControl x:Class="AccountsPRO.MVVM.View.Accounts.BankReconciliationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:AccountsPRO.MVVM.View.Accounts" 
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             BorderThickness="3" 
             BorderBrush="White"
             mc:Ignorable="d" 
             Height="770" Width="1200">

    <Control.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFEE4540" Offset="0"/>
            <GradientStop Color="#FFC72C41" Offset="0.2"/>
            <GradientStop Color="#FF801336" Offset="0.4"/>
            <GradientStop Color="#FF670E33" Offset="0.6"/>
            <GradientStop Color="#FF510A32" Offset="0.8"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
        </LinearGradientBrush>
    </Control.Background>

    <Grid Margin="10,20,4,10">

        <Grid.RowDefinitions>
            <RowDefinition Height="43"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="450"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock HorizontalAlignment="Left" 
                       Height="40" 
                       TextWrapping="Wrap" FontSize="30"
                       Text="Bank Reconciliation" Foreground="White" FontWeight="Bold" 
                       VerticalAlignment="Center" Width="336"/>

            <Button Content="X" 
                    FontSize="20"
                    Width="40"
                    Style="{StaticResource AnimatedRedButton}"   
                    Command="{Binding DefaultAccountScreenCommand}"
                    Margin="790,0,0,0" />
            
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Grid.ColumnSpan="3">
            <Label Content="Bank Account : " FontSize="14" VerticalAlignment="Center"/>
            <ComboBox x:Name="cmbBankAccount"
                      VerticalAlignment="Center" 
                      FontSize="14"
                      Width="250" 
                      Height="30"
                      VerticalContentAlignment="Center">
                <ComboBoxItem Content="BANK ACCOUNT"/>
            </ComboBox>

            <Label Content="Date: " 
                   FontSize="14"
                   VerticalAlignment="Center" Margin="50,0,0,0"/>
            <DatePicker x:Name="dpDate"
                        VerticalAlignment="Center" 
                        Width="250" 
                        Height="30" 
                        FontSize="14"
                        VerticalContentAlignment="Center"/>

            <Button x:Name="btnLoad"
                    Style="{StaticResource AnimatedRedButton}" 
                    VerticalAlignment="Center" Width="90" Height="35" Margin="50,0,0,0" 
                    Foreground="White"                  
                    Content="Load"
                    FontSize="20"
                    Click="btnLoad_Click">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>

        <DataGrid x:Name="dgBankReconciliation"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  HeadersVisibility="All"
                  CanUserAddRows="False"
                  HorizontalContentAlignment="Center"
                  TextBlock.TextAlignment="Center"
                  CanUserDeleteRows="False"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  FontSize="12"
                  IsReadOnly="False"  
                  AutoGeneratingColumn="BankReconciliationDataGrid_AutoGeneratingColumn" Margin="0,0,0,-131" Grid.RowSpan="2">
            <DataGrid.Columns>
                <!-- Hidden column for VchrId -->
                <DataGridTextColumn Header="VchrId" Binding="{Binding [VchrId]}" Visibility="Collapsed"/>
                               
                <DataGridTextColumn Header="INV No" Width="80" Binding="{Binding [InvoiceNo]}" IsReadOnly="True"/>
                
                <DataGridTextColumn Header="Invoice Type" Width="140" Binding="{Binding [InvoiceType]}" IsReadOnly="True"/>
                
                <DataGridTextColumn Header="Particulars" Width="170" Binding="{Binding [Particulars]}" IsReadOnly="True"/>
                
                <DataGridTextColumn Header="Invoice Date" Width="170" Binding="{Binding [InvoiceDate], StringFormat=d}" IsReadOnly="True"/>
                
                <DataGridTextColumn Header="Bank Date" Width="130" Binding="{Binding [BankDate], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                
                <DataGridTextColumn Header="Debit" Width="150" Binding="{Binding [Debit]}" IsReadOnly="True"/>
                
                <DataGridTextColumn Header="Credit" Width="150" Binding="{Binding [Credit]}" IsReadOnly="True"/>
                
                <DataGridTextColumn Header="Remarks" Width="*" Binding="{Binding [Remarks]}" IsReadOnly="True"/>
            
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0"/>

    </Grid>
</UserControl>
