<UserControl x:Class="FlexMold.MVVM.View.Accounts.PostDatedChequePaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
                          xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"        
             mc:Ignorable="d"
                         Height="900" Width="1473">

    <Control.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </Control.Background>


    <Grid Margin="10,20,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="613*"/>
            <ColumnDefinition Width="501*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" MinHeight="24"/>
            <RowDefinition Height="Auto" MinHeight="4"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="201*"/>
            <RowDefinition Height="Auto" MinHeight="39.62"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="2" Margin="704,15,423,353" Grid.Row="2">
            <TextBlock Text="Pary A/C :" FontSize="15" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
            <ComboBox Width="250
                      " Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Sample Suppliers"/>
                <ComboBoxItem Content="Supplier One"/>
                <ComboBoxItem Content="Office 2"/>
            </ComboBox>
        </StackPanel>


        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  HeadersVisibility="All"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  FontSize="13"
                  FontWeight="ExtraBold"
                  Margin="-10,59,0,269" RenderTransformOrigin="0.499,0.42" Grid.ColumnSpan="2" Grid.RowSpan="2" >
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="SL" Width="40" Binding="{Binding }"/>
                <DataGridTextColumn Header="Date" Width="100" Binding="{Binding }"/>
                <DataGridTextColumn Header="Voucher No" Width="105" Binding="{Binding }"/>
                <DataGridTextColumn Header="Bank Account" Width="150" Binding="{Binding }"/>
                <DataGridTextColumn Header="Party" Width="125" Binding="{Binding }"/>
                <DataGridTextColumn Header="Amount" Width="100" Binding="{Binding }"/>
                <DataGridTextColumn Header="Bank" Width="140" Binding="{Binding}" />
                <DataGridTextColumn Header="Branch" Width="130" Binding="{Binding}" />
                <DataGridTextColumn Header="Cheque No" Width="90" Binding="{Binding}" />
                <DataGridTextColumn Header="Cheque Date" Width="120" Binding="{Binding}" />
                <DataGridTextColumn Header="Status" Width="100" Binding="{Binding}" />
                <DataGridTextColumn Header="Narration" Width="140" Binding="{Binding}" />
                <DataGridTextColumn Header="Collection Date" Width="*" Binding="{Binding}" />
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="439,4,0,-5" Width="360">
            <Button Content="Save" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Edit" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Delete" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Clear" Width="80" Margin="5" Background="#FF6F0404" Foreground="White">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="30,200,359,160" Grid.Row="3">
            <TextBlock Text="Voucher No : " VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="White"/>
            <mah:NumericUpDown Height="27" Width="300"
                               Maximum="9999"
                               Minimum="0"/>

        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="44,248,365,122" Grid.Row="3">
            <TextBlock Text="Party A/C :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="300" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="46,297,370,83" Grid.Row="3">
            <TextBlock Text="Bank A/C :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="300" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Bank Account"/>
                <ComboBoxItem Content="Debit"/>
                <ComboBoxItem Content="Cash"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="52,333,351,40" Grid.Row="3">
            <TextBlock Text="Remarks :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" 
                   Height="36" Margin="0,-12,0,0" 
                   TextWrapping="Wrap" FontSize="24"
                   Text="Post Dated Cheque Payment" Foreground="White" FontWeight="Bold"
                   VerticalAlignment="Top" Width="336"/>
        <StackPanel Orientation="Horizontal" Margin="485,205,10,168" Grid.Row="3">
            <TextBlock Text="Date :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <DatePicker Width="250" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="267,11,1,356" Grid.Column="1" Grid.Row="2">
            <TextBlock
                VerticalAlignment="Center" Text="Cheque No :" FontSize="15" FontWeight="Bold" Foreground="White"/>
            <TextBox
                Width="250" RenderTransformOrigin="0.594,0.542" Margin="10,0,0,0" Height="27"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="42,20,417,345" Grid.Row="2">
            <TextBlock Text="From :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <DatePicker Width="250" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="379,16,105,349" Grid.Row="2">
            <TextBlock Text="  To :" FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <DatePicker Width="250" Height="27" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="129,336,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" Width="660"/>
        <StackPanel Orientation="Horizontal" Margin="459,248,10,125" Grid.Row="3">
            <TextBlock Text="Amount : " FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="536,251,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            Text="0.00" 
            VerticalAlignment="Top" Width="253"/>
        <StackPanel Orientation="Horizontal" Margin="496,284,13,76" Grid.Row="3">
            <TextBlock Text="Exi : " FontSize="15" VerticalAlignment="Center" FontWeight="Bold" Foreground="White"/>
            <ComboBox Width="250                       " Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Sample Suppliers"/>
                <ComboBoxItem Content="Supplier One"/>
                <ComboBoxItem Content="Office 2"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="120,203,465,169" Grid.Row="3" Grid.Column="1">
            <TextBlock Text="     Bank : " FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="221,206,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" Width="300" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" Margin="120,243,465,128" Grid.Row="3" Grid.Column="1">
            <TextBlock Text=" Branch : " FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="221,246,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" Width="300" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" Margin="120,284,465,87" Grid.Row="3" Grid.Column="1">
            <TextBlock Text="Chq No : " FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="221,287,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap"             
            VerticalAlignment="Top" Width="300" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" Margin="120,325,465,45" Grid.Row="3" Grid.Column="1">
            <TextBlock Text=" Ref No : " FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="221,328,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap"            
            VerticalAlignment="Top" Width="300" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" Margin="107,363,465,8" Grid.Row="3" Grid.Column="1">
            <TextBlock Text=" Chq Date : " FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White" Width="88"/>
        </StackPanel>
        <DatePicker 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="221,368,0,0" 
            Grid.Row="3"                      
            VerticalAlignment="Top" Width="300" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" Margin="55,1,465,6" Grid.Row="4" Grid.Column="1">
            <TextBlock Text=" Collection Status : " FontWeight="Bold" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <ComboBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="221,4,0,0" 
            Grid.Row="4"            
            VerticalAlignment="Top" Width="300" Grid.Column="1"/>

        <Button Grid.Column="1" 
                Content="Export"
                Background="#FF6F0404"
                Foreground="White"
                HorizontalAlignment="Left" 
                Height="40" 
                Margin="558,138,0,0"
                Grid.Row="3" 
                VerticalAlignment="Top"
                Width="90">
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Border BorderBrush="White" BorderThickness="2" HorizontalAlignment="Left" Height="4" Margin="0,181,0,0" Grid.Row="3" VerticalAlignment="Top" Width="1465" Grid.ColumnSpan="2"/>


    </Grid>
</UserControl>