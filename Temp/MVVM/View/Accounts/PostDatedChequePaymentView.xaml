<UserControl x:Class="FlexMold.MVVM.View.Accounts.PostDatedChequePaymentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
             BorderThickness="3" 
             BorderBrush="White"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"        
             mc:Ignorable="d"
             Height="900" Width="1473">

    <Control.Background>
        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>
    </Control.Background>


    <Grid Margin="10,20,0,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="97*"/>
            <ColumnDefinition Width="303*"/>
            <ColumnDefinition/>
            <ColumnDefinition Width="328*"/>
        </Grid.ColumnDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>

            <RowDefinition Height="Auto" MinHeight="24"/>
            <RowDefinition Height="Auto" MinHeight="4"/>
            <RowDefinition Height="200*"/>
            <RowDefinition Height="201*"/>
            <RowDefinition Height="Auto" MinHeight="39.62"/>
        </Grid.RowDefinitions>


        <StackPanel Orientation="Horizontal" Grid.ColumnSpan="3" Margin="511,15,423,353" Grid.Row="2" Grid.Column="1">
            <TextBlock Text="Pary A/C :" FontSize="15" VerticalAlignment="Center" Foreground="White"/>
            <ComboBox Width="250
                      " Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Sample Suppliers"/>
                <ComboBoxItem Content="Supplier One"/>
                <ComboBoxItem Content="Office 2"/>
            </ComboBox>
        </StackPanel>


        <DataGrid Grid.Row="2"
                  AutoGenerateColumns="False"
                  HeadersVisibility="All"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  FontSize="13"
                  FontWeight="ExtraBold"
                  Margin="-10,59,0,388" RenderTransformOrigin="0.499,0.42" Grid.ColumnSpan="4" Grid.RowSpan="2" >
            <DataGrid.Columns>
                <DataGridCheckBoxColumn Header="SL" Width="40" Binding="{Binding }"/>
                <DataGridTextColumn Header="Date" Width="100" Binding="{Binding }"/>
                <DataGridTextColumn Header="Voucher No" Width="105" Binding="{Binding }"/>
                <DataGridTextColumn Header="Bank Account" Width="150" Binding="{Binding }"/>
                <DataGridTextColumn Header="Party" Width="125" Binding="{Binding }"/>
                <DataGridTextColumn Header="Amount" Width="100" Binding="{Binding }"/>
                <DataGridTextColumn Header="Bank" Width="140" Binding="{Binding}" />
                <DataGridTextColumn Header="Branch" Width="120" Binding="{Binding}" />
                <DataGridTextColumn Header="CHQ No" Width="80" Binding="{Binding}" />
                <DataGridTextColumn Header="Cheque Date" Width="120" Binding="{Binding}" />
                <DataGridTextColumn Header="Status" Width="100" Binding="{Binding}" />
                <DataGridTextColumn Header="Narration" Width="140" Binding="{Binding}" />
                <DataGridTextColumn Header="Collection Date" Width="*" Binding="{Binding}" />
            </DataGrid.Columns>
        </DataGrid>


        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="238,279,0,75" Width="360" Grid.Column="1">

            <Button Content="Save" Background="ForestGreen"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}">
            </Button>

            <Button Content="Edit" Background="ForestGreen"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}">
            </Button>

            <Button Content="Delete" Background="ForestGreen"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}">
            </Button>

            <Button Content="Clear" Background="ForestGreen"
                    FontSize="14"
                    Style="{StaticResource AnimatedRedButton}">
            </Button>
            
        </StackPanel>
       
        <StackPanel Orientation="Horizontal" Margin="22,75,366,274" Grid.Row="3" Grid.ColumnSpan="2" >
            <TextBlock Text="Voucher No : " VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <mah:NumericUpDown Height="30" Width="300" VerticalContentAlignment="Center"
                               Maximum="9999"
                               Minimum="0"/>

        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="36,126,372,238" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Party A/C :" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="300" Margin="10,0,0,0" Height="30" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Admin"/>
                <ComboBoxItem Content="Office"/>
                <ComboBoxItem Content="ALL"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="36,172,377,192" Grid.Row="3" Grid.ColumnSpan="2">
            <TextBlock Text="Bank A/C :" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <ComboBox Width="302" Margin="10,0,0,0" Height="30" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Bank Account"/>
                <ComboBoxItem Content="Debit"/>
                <ComboBoxItem Content="Cash"/>
            </ComboBox>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="42,213,85,160" Grid.Row="3">
            <TextBlock Text="Remarks :" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBlock HorizontalAlignment="Left" 
                   Height="36" Margin="0,-12,0,0" 
                   TextWrapping="Wrap" FontSize="25"
                   Text="Post Dated Cheque Payment" Foreground="White" FontWeight="Bold"
                   VerticalAlignment="Top" Width="336" Grid.ColumnSpan="2"/>
        <StackPanel Orientation="Horizontal" Margin="284,83,0,279" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2">
            <TextBlock Text="Date :"  VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <DatePicker Width="256" Margin="10,0,0,0" Height="30" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="267,11,1,356" Grid.Column="3" Grid.Row="2">
            <TextBlock
                VerticalAlignment="Center" Text="Cheque No :" FontSize="15" Foreground="White"/>
            <TextBox
                Width="250" RenderTransformOrigin="0.594,0.542" Margin="10,0,0,0" Height="27"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="42,20,416,345" Grid.Row="2" Grid.ColumnSpan="2">
            <TextBlock Text="From :" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <DatePicker Width="250" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="186,16,104,349" Grid.Row="2" Grid.Column="1">
            <TextBlock Text="  To :" VerticalAlignment="Center" FontSize="15" Foreground="White"/>
            <DatePicker Width="250" Height="27" RenderTransformOrigin="0.594,0.542"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="113,216,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" Width="669" Grid.ColumnSpan="2"/>
        <StackPanel Orientation="Horizontal" Margin="258,128,17,245" Grid.Row="3" Grid.Column="1">
            <TextBlock Text="Amount : " VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="332,131,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            Text="0.00" 
            VerticalAlignment="Top" Width="256" Grid.Column="1"/>
        <StackPanel Orientation="Horizontal" Margin="293,169,1,191" Grid.Row="3" Grid.Column="1">
            <TextBlock Text="Exi : " FontSize="15" VerticalAlignment="Center" Foreground="White"/>
            <ComboBox Width="256" Margin="10,0,0,0" Height="27" RenderTransformOrigin="0.594,0.542">
                <ComboBoxItem Content="Sample Suppliers"/>
                <ComboBoxItem Content="Supplier One"/>
                <ComboBoxItem Content="Office 2"/>
            </ComboBox>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Margin="112,83,473,289" Grid.Row="3" Grid.Column="3">
            <TextBlock Text="     Bank : " VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="213,86,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" Width="300" Grid.Column="3"/>
        <StackPanel Orientation="Horizontal" Margin="112,123,473,248" Grid.Row="3" Grid.Column="3">
            <TextBlock Text=" Branch : " VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="213,126,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap" 
            VerticalAlignment="Top" Width="300" Grid.Column="3"/>
        <StackPanel Orientation="Horizontal" Margin="112,164,473,207" Grid.Row="3" Grid.Column="3">
            <TextBlock Text="Chq No : " VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="213,167,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap"             
            VerticalAlignment="Top" Width="300" Grid.Column="3"/>
        <StackPanel Orientation="Horizontal" Margin="112,205,473,165" Grid.Row="3" Grid.Column="3">
            <TextBlock Text=" Ref No : " VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <TextBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="213,208,0,0" 
            Grid.Row="3" 
            TextWrapping="Wrap"            
            VerticalAlignment="Top" Width="300" Grid.Column="3"/>
        <StackPanel Orientation="Horizontal" Margin="99,243,473,128" Grid.Row="3" Grid.Column="3">
            <TextBlock Text=" Chq Date : " VerticalAlignment="Center" FontSize="15" Foreground="White" Width="88"/>
        </StackPanel>
        <DatePicker 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="213,248,0,0" 
            Grid.Row="3"                      
            VerticalAlignment="Top" Width="300" Grid.Column="3"/>
        <StackPanel Orientation="Horizontal" Margin="47,284,473,78" Grid.Row="3" Grid.Column="3">
            <TextBlock Text="  Collection Status : " VerticalAlignment="Center" FontSize="15" Foreground="White"/>
        </StackPanel>
        <ComboBox 
            HorizontalAlignment="Left" 
            Height="26" 
            Margin="213,287,0,0" 
            Grid.Row="3"            
            VerticalAlignment="Top" Width="300" Grid.Column="3"/>

        <Button Grid.Column="3" 
                Content="Export"
                Background="ForestGreen"
                FontSize="14"
                Style="{StaticResource AnimatedRedButton}"
                Margin="543,12,43,0"
                Grid.Row="3" 
                VerticalAlignment="Top"
                >
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>
        <Border BorderBrush="White" BorderThickness="2" HorizontalAlignment="Left" Height="4" Margin="-8,61,0,0" Grid.Row="3" VerticalAlignment="Top" Width="1465" Grid.ColumnSpan="4"/>


    </Grid>
</UserControl>