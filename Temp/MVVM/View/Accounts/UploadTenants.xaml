<Window x:Class="FlexMold.MVVM.View.Accounts.UploadTenants"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Accounts"
        BorderBrush="White"
        BorderThickness="1.7"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        Title="UploadTenants" Height="840" Width="1600">

    <Grid>
        
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition Height="650"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" >
            <Label Style="{StaticResource AccountsLabel}"
                   Content="Upload Tenants"
                   FontSize="22" FontWeight="Bold"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Grid.ColumnSpan="2">
            <Label Content="Unit No : "
                   Margin="25,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>
            <ComboBox x:Name="UnitNoComboBox" Width="170" 
                      Height="30" 
                      FontSize="14"
                      VerticalContentAlignment="Center" 
                      SelectionChanged="UnitNoComboBox_SelectionChanged" />

            <Label Content="Tenant Name : "
                   Margin="30,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>
            <ComboBox x:Name="TenantNameComboBox" Width="170" 
                      Height="30" 
                      FontSize="14"
                      VerticalContentAlignment="Center" 
                      SelectionChanged="TenantNameComboBox_SelectionChanged"/>

            <Label Content="Arrears : "
                   Margin="30,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="ArreasTxtBox" Width="170" 
                      Height="30" 
                      FontSize="14"
                      VerticalContentAlignment="Center" 
                      TextChanged="ArreasTxtBox_TextChanged"
                      />

            <Label Content="Date : "
                   Margin="30,0,0,0"
                   FontSize="14"
                   Style="{StaticResource AccountsLabel}"/>

            <DatePicker x:Name="DatePickTxtBox" Width="170" 
                       Height="30" 
                       FontSize="14"
                       VerticalContentAlignment="Center"/>
        </StackPanel>


        <StackPanel Grid.Row="2" Margin="10,10,10,10" >

            <DockPanel LastChildFill="True">

                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">

                    <Label Content="Search : " VerticalAlignment="Center" Margin="20,0,0,0" Style="{StaticResource AccountsLabel}" />

                    <TextBox x:Name="SearchTextBox" Width="300" Height="28" Margin="6,0,0,0" VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged" />

                    <Button x:Name="ClearSearchBtn" 
                            Content="Clear" 
                            Style="{StaticResource AnimatedRedButton}"
                            Background="ForestGreen"
                            Margin="20,0,0,0" Click="ClearSearchBtn_Click"/>

                </StackPanel>

                <DataGrid x:Name="TenantsDataGrid"
                          AutoGenerateColumns="True"
                          CanUserAddRows="False"
                          IsReadOnly="True"
                          Height="580"
                          Margin="0,0,0,0"
                          SelectionMode="Extended"
                          AutoGeneratingColumn="TenantsDataGrid_AutoGeneratingColumn"
                          />
            </DockPanel>
        </StackPanel>



        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    VerticalAlignment="Center" 
                   >
            
            <Label Content="Enter Sheet : "
                   Margin="30,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox x:Name="SheetTextBox" Width="150"
                     Height="30"
                     VerticalContentAlignment="Center"
                     FontSize="14"/>

            <Label Content="Enter Date : "
                   Margin="50,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <DatePicker x:Name="DateTimePicker1" Width="150"
                        Height="30"
                        VerticalContentAlignment="Center"
                        FontSize="14" />

            <Button x:Name="UploadFile" Content="Upload File"
                    Style="{StaticResource AnimatedRedButton}"
                    Margin="450,5,0,0"
                    Background="ForestGreen"
                    Width="110"
                    Click="UploadFileBtn_Click"/>
        </StackPanel>

    </Grid>
</Window>
