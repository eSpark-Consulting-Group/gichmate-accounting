<Window x:Class="FlexMold.MVVM.View.Firm.AdminSettingsView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Firm"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        WindowStyle="None"
         Title="AdminSettings" Height="900" Width="1123">


    <Window.Resources>
        <!-- Angled TextBox Style -->

        <Style x:Key="AngledTextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF801336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Path Data="M0,0 L10,0 L0,10 Z"
                                  Fill="#FF801336"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="2"/>
                            <Path Data="M0,10 L10,10 L10,0 Z"
                                  Fill="#FF801336"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="2"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Angled PasswordBox Style -->
        <Style x:Key="AngledPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF801336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4"/>
                            <Path Data="M0,0 L10,0 L0,10 Z"
                                  Fill="#FF801336"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Top"
                                  Margin="2"/>
                            <Path Data="M0,10 L10,10 L10,0 Z"
                                  Fill="#FF801336"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Bottom"
                                  Margin="2"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="472*"/>
            <ColumnDefinition Width="30*"/>
            <ColumnDefinition Width="621*"/>
        </Grid.ColumnDefinitions>
        <!-- Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="2*"/>
            <RowDefinition Height="899*"/>
        </Grid.RowDefinitions>


        <!-- Top Navigation Bar -->
        <Grid Background="#EE4540" Margin="0,0,0,2" Grid.RowSpan="2" Grid.ColumnSpan="3"/>

        <!-- Register Form -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,124,0,80" Grid.ColumnSpan="3">
            <StackPanel HorizontalAlignment="Center" Width="600" Margin="0,20">
                <!-- Logo + Title -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">

                    <TextBlock Text="Admin Settings" FontFamily="Fonts/#font2" FontSize="40"
                               Foreground="White" FontWeight="Bold" VerticalAlignment="Center"
                               Margin="0,10,0,0"/>
                </StackPanel>

                <!-- Form Fields -->
                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Text="          User Name :" Width="170" FontSize="20" FontFamily="Fonts/#myfont"
                               Foreground="WhiteSmoke" VerticalAlignment="Center"
                               Margin="10"/>
                    <TextBox x:Name="userName" Style="{StaticResource AngledTextBoxStyle}" Width="315" Height="28" Foreground="Black"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,15,0,10">
                    <TextBlock Margin="10"
                               Text="      Old Password :" Width="170" FontSize="20" FontFamily="Fonts/#myfont"
                               Foreground="WhiteSmoke" VerticalAlignment="Center"
                               />
                    <TextBox x:Name="oldPassword" Style="{StaticResource AngledTextBoxStyle}" Width="317" Height="28" Foreground="Black"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Margin="10"
                               Text="     New Password :" Width="172" FontSize="20" FontFamily="Fonts/#myfont"
                               Foreground="WhiteSmoke" VerticalAlignment="Center"/>
                    <TextBox x:Name="newPassword" Style="{StaticResource AngledTextBoxStyle}" Width="317" Height="28" Foreground="Black"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,5">
                    <TextBlock Margin="10"
                               Text="Confirm Password :" Width="173" FontSize="20" FontFamily="Fonts/#myfont"
                               Foreground="WhiteSmoke" VerticalAlignment="Center" />
                    <TextBox x:Name="confirmPassword" Style="{StaticResource AngledTextBoxStyle}" Foreground="Black"
                             Width="316" 
                             Height="28"/>
                </StackPanel>



                <!-- Register Button -->
                <Button x:Name="Update" Content="Update"
                        Width="150" Height="45" Margin="90,40,150,-44"
                        FontSize="14" FontWeight="Medium"
                        Foreground="White" Background="#FF801336"
                        HorizontalAlignment="Center" Click="Btn_Update" >
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>

                <Button Content="Clear"
                        Width="150" Height="45" Margin="270,0,0,0"
                        FontSize="14" FontWeight="Medium"
                        Foreground="White" Background="#FF801336"
                        HorizontalAlignment="Center" Click="Button_Click_1" >
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                </Button>

            </StackPanel>
        </ScrollViewer>
        <!-- Dashboard Content Panel -->
        <StackPanel x:Name="DashboardPanel" Grid.Row="2" VerticalAlignment="Center" Grid.ColumnSpan="3">
            <!-- Move all your original dashboard StackPanel content here -->
            <!-- Copy the StackPanel you already have (with logo, text, buttons) inside this one -->
        </StackPanel>
        <Grid Margin="384,562,-1538,-217" Grid.Row="2" Grid.Column="2"
	  >

            <Grid.RenderTransform>
                <RotateTransform Angle ="45" />
            </Grid.RenderTransform>

            <StackPanel Orientation ="Horizontal" Margin="0,0,658,0">
                <StackPanel/>
                <StackPanel>
                    <Border Width="682" 
					Height="35"
					Background="#EE4540"
					Margin="150,0,0,0"
					CornerRadius="20"/>

                    <Border Width="833"
					Height="35"
					Background="white"
					Margin="0,15,0,0"
					CornerRadius="20" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform/>
                                <SkewTransform AngleX="18.19"/>
                                <RotateTransform/>
                                <TranslateTransform X="5.75"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                    </Border>

                    <Border Width="700"
					Height="35"
					Background="#EE4540"
					Margin="75,15,0,0"
					CornerRadius="20"/>
                </StackPanel>

            </StackPanel>

        </Grid>
        <Button FontSize="22" Content="Go To Next Page" HorizontalAlignment="Left" Height="37" Margin="431,0,0,0" Grid.Row="1" VerticalAlignment="Top" Width="190" Click="Button_Click" Grid.RowSpan="2" Grid.Column="2"/>
    </Grid>

</Window>