<Window x:Class="AccountsPro.MVVM.View.Firm.CreateUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccountsPro.MVVM.View.Firm"
        mc:Ignorable="d"        
        Title="CreateUser"
        WindowStartupLocation="CenterScreen"
        BorderBrush="White"
        BorderThickness="3"
        Height="600" 
        Width="790">
    
    <Grid>
        <Grid.Background>

            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540" Offset="1"/>
                <GradientStop Color="#FF2D142C"/>
                <GradientStop Color="#FF510A32" Offset="0.435"/>
                <GradientStop Color="#FFC72C41" Offset="0.843"/>
                <GradientStop Color="#FF801336" Offset="0.635"/>
                <GradientStop Color="#FF670E33" Offset="0.574"/>
            </LinearGradientBrush>
        </Grid.Background>



        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition Height="25"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="200"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>




        <StackPanel Grid.Row="0" VerticalAlignment="Center">

            <Label Content="Create User" 
                   Style="{StaticResource AccountsLabel}"
                   FontSize="20"
                   FontWeight="Medium"/>

        </StackPanel>

        <StackPanel Grid.Row="1">
            <Border BorderBrush="White"
                    BorderThickness="1"/>
        </StackPanel>


        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">

            <Label Content="Enter Username :"
                   Style="{StaticResource AccountsLabel}"/>

            <TextBox Style="{StaticResource AccountsTextBox}"
                     x:Name="txtUserName"/>

        </StackPanel>


        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">

            <Label Content="Enter Password :"
                   Margin="5,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <PasswordBox Style="{StaticResource PasswordTextBox}"
                         x:Name="txtPassword"/>

        </StackPanel>



        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center">

            <Label Content="User Privilege :"
                   Margin="15,0,0,0"
                   Style="{StaticResource AccountsLabel}"/>

            <ComboBox Style="{StaticResource AccountsComboBox}"
                      x:Name="txtComboBox"/>

        </StackPanel>

        <StackPanel Grid.Row="5">

            <DataGrid Height="200"
                      BorderBrush="White"
                      BorderThickness="3"
                      x:Name="dgUserPrivilege">
                
            </DataGrid>
            
        </StackPanel>

        <StackPanel Grid.Row="6" HorizontalAlignment="Center" VerticalAlignment="Center">

            <StackPanel Margin="30,0,0,0"
                        Orientation="Horizontal">

                <Button Content="Save"
                        x:Name="SaveButton"
                        Click="SaveBtn_Click"
                        Width="120"
                        Style="{StaticResource AnimatedRedButton}"/>
                
                <!--<Button Content="Clear"
                        x:Name="ClearButton"
                        Click="ClearBtn_Click"
                        Style="{StaticResource AnimatedRedButton}"/>-->

            </StackPanel>
       
        </StackPanel>















    </Grid>
</Window>
