<Window x:Class="FlexMold.MVVM.View.Firm.FinancialYearView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FlexMold.MVVM.View.Firm"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"        
        WindowStyle="None"               
        Title="MainWindow" Height="900" Width="1123">

    <Window.Resources>
        <!-- this is the Label style-->
        <Style x:Key="AngledLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontFamily" Value="Times New Roman"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Right"/>
            <Setter Property="Margin" Value="10,5,0,5"/>
        </Style>

        <Style x:Key="AngledPasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF801336"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"/>
                            <Path Data="M0,0 L10,0 L0,10 Z"
                          Fill="#FF801336"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="2"/>
                            <Path Data="M0,10 L10,10 L10,0 Z"
                          Fill="#FF801336"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          Margin="2"/>
                            <ScrollViewer x:Name="PART_ContentHost" Margin="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Common PasswordBox Style -->
        <Style x:Key="CommonPasswordBoxStyle" BasedOn="{StaticResource AngledPasswordBoxStyle}" TargetType="PasswordBox">
            <Setter Property="Width" Value="300"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

    </Window.Resources>


    <Grid>
        <!-- Gradient Background -->
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="680*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="338"/>
            <RowDefinition Height="162"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="2">
            <TextBlock Text="Financial Year" FontSize="50" 
                       VerticalAlignment="Bottom"                       
                       Foreground="White" FontWeight="Bold" FontFamily="Times New Roman" Height="63"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="30,50,30,218">
            <TextBlock Text="From Date : " Style="{StaticResource AngledLabelStyle}" Width="190"/>
            <DatePicker Height="33" Width="342" FontSize="20"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="30,118,30,150">
            <TextBlock Text="To Date : " Style="{StaticResource AngledLabelStyle}" Width="191"/>
            <DatePicker Height="46" Width="342" FontSize="20"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="30,180,30,42">
            <TextBlock Text="Financial Year Name : " Style="{StaticResource AngledLabelStyle}"/>
            <TextBox Width="335" Height="30" />
        </StackPanel>

        <StackPanel Grid.Column="1"  Grid.Row="2">
            <DataGrid  HorizontalAlignment="Center" 
                       FontSize="20"
                       Height="340"  Width="923" 
                       d:ItemsSource="{d:SampleData ItemCount=20}"/>
        </StackPanel>


        <StackPanel Grid.Row="3" Grid.Column="1">

            <Button Content="Save"
                    Width="150" Height="45" Margin="0,40,450,-44"
                    FontSize="21" FontWeight="Medium"
                    Foreground="White"
                    HorizontalAlignment="Center" >
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFDC6969"/>
                        <GradientStop Color="Red" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>
            <Button Content="Delete"
                Width="150" Height="45"
                FontSize="21" FontWeight="Medium"
                Foreground="White"
        >
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFDC6969"/>
                        <GradientStop Color="Red" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

            <Button Content="Clear"
        Width="150" Height="45" Margin="450,-44,0,0"
        FontSize="21" FontWeight="Medium"
        Foreground="White"
        HorizontalAlignment="Center" >
                <Button.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFDC6969"/>
                        <GradientStop Color="Red" Offset="1"/>
                    </LinearGradientBrush>
                </Button.Background>
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
            </Button>

        </StackPanel>
        <Button Content="View Reports"
            FontSize="21" FontWeight="Medium"
            Foreground="White"
        Grid.Column="1" Margin="696,196,78,58" Grid.Row="1" Click="Button_Click" >
            <Button.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFDC6969"/>
                    <GradientStop Color="Red" Offset="1"/>
                </LinearGradientBrush>
            </Button.Background>
            <Button.Effect>
                <DropShadowEffect/>
            </Button.Effect>
        </Button>





    </Grid>
</Window>
