<Window x:Class="AccountsPRO.MVVM.View.Firm.FinancialYearView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccountsPRO.MVVM.View.Firm"
        WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"        
        BorderBrush="White"
        BorderThickness="3"
        WindowStyle="None"               
        Title="MainWindow" 
        Height="770" 
        Width="1200">


    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>


        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="680*"/>
            <ColumnDefinition Width="100"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="300"/>
            <RowDefinition Height="100"/>
        </Grid.RowDefinitions>


        <StackPanel Grid.Column="1" Orientation="Horizontal" Grid.ColumnSpan="2">
            <TextBlock Text="Financial Year" FontSize="50"                       
                       Foreground="White"
                       FontWeight="Bold" 
                       FontFamily="Times New Roman"
                       Height="62"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="36,56,24,212">

            <Label     Content="From Date : " 
                       Style="{StaticResource AccountsLabel}"
                       />

            <DatePicker
                x:Name="FromDatePicker"
                Height="30" 
                Width="250" 
                FontSize="14"/>

        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="36,124,24,144">
            <Label     Content="From Date : " 
           Style="{StaticResource AccountsLabel}"
           />
            <DatePicker x:Name="ToDatePicker"
                        Height="30" Width="250" 
                        FontSize="14"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="36,186,24,75">
            <Label     Content="From Date : " 
           Style="{StaticResource AccountsLabel}"
           />
            <TextBox x:Name="txtFinancialYear"
                     Style="{StaticResource AccountsTextBox}" />
        </StackPanel>

        <StackPanel  Grid.Row="2" Grid.ColumnSpan="3">
            <DataGrid  x:Name="dgFinancialYear"
                       HorizontalAlignment="Center" 
                       FontSize="20"
                       Height="363"  Width="1190" />
        </StackPanel>

        <Button x:Name="ViewReportsButton"
                Click="viewReportsBtn_Click"
                Content="View Reports"
                Style="{StaticResource AnimatedRedButton}"
                Width="190"
            Grid.Column="1" Margin="780,230,24,35" Grid.Row="1" >
        </Button>


        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Grid.Column="1" Grid.Row="3">

            <Button Style="{StaticResource AnimatedRedButton}"
                    Content="Save"
                    Click="SaveBtn_Click"
                    x:Name="SaveButton"
                    Width="90"/>

            <Button Style="{StaticResource AnimatedRedButton}"
                    Content="Delete"
                    x:Name="DeleteButton"
                    Width="90" Click="DeleteButton_Click"/>

            <Button Style="{StaticResource AnimatedRedButton}"
                    Content="Clear"
                    Click="ClearBtn_Click"
                    x:Name="ClearButton"
                    Width="90"/>


        </StackPanel>



    </Grid>
</Window>
