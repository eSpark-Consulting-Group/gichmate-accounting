<UserControl
    x:Class="AccountsPRO.MVVM.View.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:AccountsPRO.MVVM.View"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:AccountsPRO.MVVM.ViewModel"
    Height="1000" Width="1600"
    mc:Ignorable="d">

    <Border Style="{StaticResource panelMenuBorder}" Background="#FFB2B2C1">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFEE4540"/>
                    <GradientStop Color="#FF2D142C" Offset="1"/>
                    <GradientStop Color="#FF510A32" Offset="0.565"/>
                    <GradientStop Color="#FFC72C41" Offset="0.157"/>
                    <GradientStop Color="#FF801336" Offset="0.365"/>
                    <GradientStop Color="#FF670E33" Offset="0.426"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
            </Grid.RowDefinitions>
            <StackPanel
                Grid.Row="0"
                Orientation="Vertical"
                ScrollViewer.CanContentScroll="True">
                <StackPanel.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#FFEE4540"/>
                        <GradientStop Color="#FF2D142C" Offset="1"/>
                        <GradientStop Color="#FF510A32" Offset="0.565"/>
                        <GradientStop Color="#FFC72C41" Offset="0.157"/>
                        <GradientStop Color="#FF801336" Offset="0.365"/>
                        <GradientStop Color="#FF670E33" Offset="0.426"/>
                    </LinearGradientBrush>
                </StackPanel.Background>
                <RadioButton
                    Command="{Binding VisualDisplayCommand}"
                    Content="Visual Display"
                    IsChecked="True"
                    Style="{StaticResource MenuButtonTheme}" />
                <RadioButton
                    Command="{Binding VaccumStatusCommand}"
                    Content="Vaccum Status"
                    Style="{StaticResource MenuButtonTheme}" />
                <RadioButton
                    Command="{Binding MachineDetailCommand}"
                    Content="Machine Details"
                    Style="{StaticResource MenuButtonTheme}" />
                <RadioButton
                    Command="{Binding MotorStatusCommand}"
                    Content="Motor Status"
                    Style="{StaticResource MenuButtonTheme}" />
                <RadioButton
                    Command="{Binding HeaterStatusCommand}"
                    Content="Heater Status"
                    Style="{StaticResource MenuButtonTheme}" />
                <RadioButton
                    Command="{Binding PowerStatusCommand}"
                    Content="Power Status"
                    Style="{StaticResource MenuButtonTheme}" />
                <RadioButton
                    Command="{Binding EmergencyStatusCommand}"
                    Content="Emergency Status"
                    Style="{StaticResource MenuButtonTheme}" />
                <RadioButton
                    Command="{Binding LaserStatusCommand}"
                    Content="Laser Status"
                    Style="{StaticResource MenuButtonTheme}" />
            </StackPanel>
            <ContentControl
                Grid.Column="1"
                Margin="40,37,52,37"
                Content="{Binding CurrentView}" >
                <ContentControl.Background>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="Black"/>
                        <GradientStop Color="#FFF1C9C9" Offset="1"/>
                    </LinearGradientBrush>
                </ContentControl.Background>
            </ContentControl>
        </Grid>
    </Border>
</UserControl>