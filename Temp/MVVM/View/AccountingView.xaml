<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlexMold.MVVM.View"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:FlexMold.MVVM.ViewModel"    
    x:Class="FlexMold.MVVM.View.MasterTransaction_Click"
    Height="1000" Width="1850"
    
    mc:Ignorable="d">


    <UserControl.Resources>

        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>


        <Storyboard x:Key="ExpandSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarPanel"
                             Storyboard.TargetProperty="Width"
                             To="200" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="CollapseSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarPanel"
                             Storyboard.TargetProperty="Width"
                             To="60" Duration="0:0:0.3"/>
        </Storyboard>



    </UserControl.Resources>

    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="White"/>
                <GradientStop Color="#FF730000" Offset="1"/>
                <GradientStop Color="White" Offset="0.323"/>
                <GradientStop Color="#FFEDDFDF" Offset="0.406"/>
                <GradientStop Color="#FEE3CDCD" Offset="0.453"/>
                <GradientStop Color="#FEDFC7C7" Offset="0.479"/>
                <GradientStop Color="#FFF5EEEE" Offset="0.365"/>
                <GradientStop Color="#FEFFFFFF" Offset="0.682"/>
            </LinearGradientBrush>
        </Grid.Background>
        <!-- Top Bar -->
        <Grid Background="#EE4540" Height="39" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="7"/>
                <ColumnDefinition Width="111"/>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="173"/>
                <ColumnDefinition Width="41*" />
                <ColumnDefinition Width="112*" />
                <ColumnDefinition Width="112*" />
                <ColumnDefinition Width="112*" />
                <ColumnDefinition Width="112*" />
                <ColumnDefinition Width="112*" />
                <ColumnDefinition Width="112*" />
                <ColumnDefinition Width="112*" />
                <ColumnDefinition Width="112*" />
                <ColumnDefinition Width="112*" />
            </Grid.ColumnDefinitions>

            <Button Content="  DASHBOARD  "
                Foreground="White"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"                
                FontSize="17"         
                Style="{StaticResource Animation}"
                Height="38" 
                Width="134"
                Command="{Binding UploadTenantsCommand}">
            </Button>



            <Button x:Name="TopBarMasterButton"
                    Content="  LEDGER | ACCOUNTS  "
                    Foreground="White"
                    Background="Transparent"                    
                    Grid.Column="2"
                    HorizontalAlignment="Center"
                    FontSize="17"   
                    Style="{StaticResource Animation}"
                    Width="190" Click="TopBarMasterButton_Click" Height="38" VerticalAlignment="Center">

                <Button.ContextMenu>
                    <ContextMenu x:Name="MasterContextMenu" >
                        <MenuItem Header="Ledger and Account Groups" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="Accounts Group"  Click="MasterGroupButton_click"/>
                        <MenuItem Header="Accounts Ledger" Click="MasterLedgerButton_click"/>
                        <MenuItem Header="Bank"            Click="MasterBankButton_click"/>
                        <MenuItem Header="Balance Sheet"   Click="MasterBalanceSheetButton_click"/>
                        <MenuItem Header="Double Journal Entries" Click="MasterDoubleJournalEntries_Click"/>
                        <MenuItem Header="Expense Account" Click="MasterExpenseButton_click"/>
                        <!--<MenuItem Header="Transaction Without Inventory" Click="MasterTransactionButton_Click"/>-->
                        <MenuItem Header="Upload Tenants" Click="MasterUploadTenantsButton_Click"/>
                        <MenuItem Header="Upload Bank Receipts" Click="MasterUploadBank_Click"/>
                        <MenuItem Header="Single Journal Entry" Click="MasterJournalEntryButton_Click"/>

                    </ContextMenu>
                </Button.ContextMenu>
            </Button>


            <Button x:Name="TopBarAccountsButton"
        Content="  ACCOUNTS  "
        Foreground="White"
        Background="Transparent"                    
        Grid.Column="3"                    
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        FontSize="17"           
        Style="{StaticResource Animation}"
        Click="TopBarAccountsButton_Click"
        
        Width="128" Margin="0,0,0,1">
                <Button.ContextMenu>
                    <ContextMenu x:Name="AccountsContextMenu" Margin="0,10,20,20">
                        <MenuItem Header="Account Screens" IsEnabled="False"/>
                        <Separator/>

                        <MenuItem Header="Bank Payment"
             Command="{Binding BankPaymentCommand}"/>

                        <MenuItem Header="Bank Receipt"
             Command="{Binding BankReceiptCommand}"/>

                        <MenuItem Header="Bank Reconciliation"
             Command="{Binding BankReconciliationCommand}"/>

                        <MenuItem Header="Cash Payment"
             Command="{Binding CashPaymentCommand}"/>

                        <MenuItem Header="Cash Receipt"
             Command="{Binding CashReceiptCommand}"/>

                        <MenuItem Header="Credit Note"
             Command="{Binding CreditNoteCommand}"/>

                        <MenuItem Header="Debit Note"
             Command="{Binding DebitNoteCommand}"/>

                        <MenuItem Header="Payment And Receipt"
             Command="{Binding PaymentAndReceiptCommand}"/>

                        <MenuItem Header="Post Dated Cheque Payment"
             Command="{Binding PostDatedChequePaymentCommand}"/>

                        <MenuItem Header="Post Dated Cheque Receipt"
             Command="{Binding PostDatedChequeReceiptCommand}"/>

                        <MenuItem Header="Receipt"
            Command="{Binding ReceiptCommand}"/>
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>






            <Button x:Name="TopBarReportsButton"
                    Content="  REPORTS  "
                    Foreground="White"
                    Background="Transparent"                    
                    Grid.Column="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="17"         
                    Style="{StaticResource Animation}"
                    Width="110" 
                    Click="TopBarReportsButton_Click" Margin="0,0,0,1">

                <Button.ContextMenu>
                    <ContextMenu x:Name="ReportsContextMenu" >
                        <MenuItem Header="Report Screens" IsEnabled="False"/>
                        <Separator/>
                        <MenuItem Header="Reports Demo" />
                        <MenuItem Header="Reports Menu" />
                        <MenuItem Header="AdvanceReport" />
                        <MenuItem Header="Sales Report" />
                        <MenuItem Header="Sales Return Report" />
                        <MenuItem Header="Purchase Report" />
                        <MenuItem Header="Purchase Return Report" />
                        <MenuItem Header="Sales Estimate Report" />
                        <MenuItem Header="Sales Order Report" />
                        <MenuItem Header="Sales Quotation Report"/>
                        <MenuItem Header="Purchase Order Report" />
                        <MenuItem Header="Price List" />
                        <MenuItem Header="Party List" />
                        <MenuItem Header="Account Payable and Recievable Report" />
                        <MenuItem Header="Rootwise Collection Report" />
                        <MenuItem Header="Transaction Report" />
                        <MenuItem Header="Other Reports" />
                        <MenuItem Header="Customer Report" />
                        <MenuItem Header="Supplier Report" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>



            <!--<Button Content="  MENU  "
                 Foreground="White"
                 Background="Transparent"
                 BorderThickness="0"
                 Grid.Column="5"                 
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 FontSize="17"
                 Style="{StaticResource Animation}"
                 Height="38" Width="82">
            </Button>-->




            <!--<Button Content="  SEARCH  "
                    Foreground="White"
                    Background="Transparent"
                    BorderThickness="0"
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    FontSize="17"  
                    Style="{StaticResource Animation}"
                    Height="32" Width="90">
            </Button>-->

            <Button Content="  ADMIN SETTINGS  "
                    Foreground="White"
                    Background="Transparent"                    
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    FontSize="17"                   
                    Width="NaN" Height="38" Click="Button_Click" 
                    Margin="9,0,3,0" 
                    Style="{StaticResource Animation}">
            </Button>


            <Button Content="  VIEW  " 
                    Height="25"
                    Grid.Column="13" 
                    Foreground="WhiteSmoke" 
                    Style="{StaticResource AnimatedRedButton}"
                    Background="Transparent"
                    BorderThickness="0" 
                    FontSize="15" 
                    Click="Button_Click_2"
                    >
            </Button>

            <Button Content="  🔔  " Grid.Column="14" 
                    Height="25"
                    Foreground="WhiteSmoke" 
                    Background="Transparent" 
                    Style="{StaticResource AnimatedRedButton}"
                    BorderThickness="0" 
                    FontSize="15" 
                    >
            </Button>
            <Button Content="  ☀  " 
                    Grid.Column="15" 
                    Height="25"
                    Style="{StaticResource AnimatedRedButton}"
                    Foreground="WhiteSmoke" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    FontSize="15" 
                    >
            </Button>
            <Button Content="  👤  " 
                    Grid.Column="16" 
                    Height="25"
                    Style="{StaticResource AnimatedRedButton}"
                    Foreground="WhiteSmoke" 
                    Background="Transparent" 
                    BorderThickness="0" 
                    FontSize="15" 
                    Click="Button_Click_1">
            </Button>

        </Grid>


        <Grid x:Name="SidebarPanel" Width="94"
              Background="{DynamicResource SidebarBrush}"
              Margin="0,30,0,0"
              HorizontalAlignment="Left" RenderTransformOrigin="1.367,0.57">


            <StackPanel Margin="10,10,10,0"
                        VerticalAlignment="Top"
                        Grid.RowSpan="2" 
                        Grid.ColumnSpan="2">

                <Button Content="☰" 
                        Foreground="White"
                        Background="Transparent"
                        FontSize="18"
                        Margin="10"
                        BorderThickness="0"
                        Style="{StaticResource Animation}"/>

                <Button Background="Transparent"
                        BorderThickness="0" 
                        Height="50" 
                        Foreground="White"
                        Style="{StaticResource Animation}"
                        Click="SideBarBtn_DoubleJournalEntriesClick">


                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="🏠" 
                                   FontSize="18"
                                   Margin="10,0"/>

                        <TextBlock x:Name="lblButton1" 
                                   Text="Home"
                                   FontSize="16" 
                                   Foreground="White"
                                   Margin="10,0" 
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Button>


                <Button Background="Transparent"
                        BorderThickness="0" 
                        Height="50"
                        Style="{StaticResource Animation}"
                        Click="SideBarBtn_BankReceiptsClick">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="📁"
                                   FontSize="18"
                                   Margin="10,0" 
                                   Foreground="White"/>

                        <TextBlock x:Name="lblButton2" 
                                   Text="Files"
                                   FontSize="16"
                                   Foreground="White"
                                   Margin="10,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Button>

                <Button Background="Transparent" 
                        BorderThickness="0"
                        Height="50"
                        Style="{StaticResource Animation}"
                        Click="SideBarBtn_BalanceSheetClick">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="📊" 
                                   FontSize="18" 
                                   Margin="10,0" 
                                   Foreground="White"/>

                        <TextBlock x:Name="lblButton3"
                                   Text="Reports"
                                   FontSize="16"
                                   Foreground="White"
                                   Margin="10,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Button>

                <Button Background="Transparent" 
                        BorderThickness="0" 
                        Height="50"
                        Style="{StaticResource Animation}"
                        Click="SideBarBtn_UploadTenantsClick">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="🔍" 
                                   FontSize="18" 
                                   Margin="10,0" 
                                   Foreground="White"/>

                        <TextBlock x:Name="lblButton4" 
                                   Text="Search"
                                   FontSize="16"
                                   Foreground="White"
                                   Margin="10,0"
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Button
                        >
                <Button Background="Transparent" 
                        BorderThickness="0"
                        Height="50"
                        Style="{StaticResource Animation}"
                        Click="SideBarBtn_AdminSettingsClick">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="⚙" 
                                   FontSize="18" 
                                   Margin="10,0"
                                   Foreground="White"/>

                        <TextBlock x:Name="lblButton5"
                                   Text="Settings"
                                   FontSize="16" 
                                   Foreground="White"
                                   Margin="10,0" 
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Button>

                <Button Background="Transparent"
                            BorderThickness="0" 
                            Height="50"
                            Style="{StaticResource Animation}"
                            Click="SideBarBtn_UserSettingsClick">

                    <StackPanel Orientation="Horizontal">

                        <TextBlock Text="👤" 
                                   FontSize="18" 
                                   Margin="10,0" 
                                   Foreground="White"/>
                        <TextBlock x:Name="lblButton6"
                                   Text="Profile"
                                   FontSize="16"
                                   Foreground="White"
                                   Margin="10,0" 
                                   Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <Grid Margin="99,44,5,0">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFEE4540" Offset="0"/>
                    <GradientStop Color="#FFC72C41" Offset="0.2"/>
                    <GradientStop Color="#FF801336" Offset="0.4"/>
                    <GradientStop Color="#FF670E33" Offset="0.6"/>
                    <GradientStop Color="#FF510A32" Offset="0.8"/>
                    <GradientStop Color="#FF2D142C" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>

            <Grid HorizontalAlignment="Left" Height="770"
                  VerticalAlignment="Top" 
                  Width="1200" 
                  Margin="450,28,0,0" >

                <ContentControl Content="{Binding CurrentView}" 
                                VerticalAlignment="Top"
                                HorizontalAlignment="Center" 
                                Margin="0,0,0,10" />

            </Grid>

        </Grid>



    </Grid>

</UserControl>