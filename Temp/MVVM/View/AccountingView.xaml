<UserControl
    x:Class="FlexMold.MVVM.View.AccountingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlexMold.MVVM.View"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:accounts="clr-namespace:FlexMold.MVVM.View.Accounts"
    xmlns:viewmodel="clr-namespace:FlexMold.MVVM.ViewModel"
    Height="1000" Width="1900"
    mc:Ignorable="d">

    <UserControl.Resources>
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>

        <Storyboard x:Key="ExpandSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarPanel"
                             Storyboard.TargetProperty="Width"
                             To="200" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="CollapseSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarPanel"
                             Storyboard.TargetProperty="Width"
                             To="60" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Top Bar -->
        <Grid Background="#EE4540" Height="30" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="27"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="133"/>
                <ColumnDefinition Width="28*" />
                <ColumnDefinition Width="39*" />
                <ColumnDefinition Width="39*" />
                <ColumnDefinition Width="39*" />
                <ColumnDefinition Width="39*" />
                <ColumnDefinition Width="39*" />
                <ColumnDefinition Width="39*" />
                <ColumnDefinition Width="39*" />
                <ColumnDefinition Width="39*" />
                <ColumnDefinition Width="39*" />
            </Grid.ColumnDefinitions>

            <Button Content="DASHBOARD"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="1"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                RenderTransformOrigin="0.5,0.5" Height="22" Width="98">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="MENU"
                 Foreground="WhiteSmoke"
                 Background="Transparent"
                 BorderThickness="0"
                 Grid.Column="2"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 FontSize="17"
                 FontFamily="Fonts/#myfont"
                 FontWeight="UltraLight" RenderTransformOrigin="0.5,0.5" Height="22" Width="48">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="ACCOUNTS"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="3"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                RenderTransformOrigin="0.5,0.5" Height="22" Width="86" Click="Button_Click_2">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button x:Name="TopBarReportsButton" Content="REPORTS"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="4"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                RenderTransformOrigin="0.5,0.5" Height="22" Width="68">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="PROFILES"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="5"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight" RenderTransformOrigin="0.5,0.5" Height="22" Width="70">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="SEARCH"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="6"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                RenderTransformOrigin="0.5,0.5" Height="22" Width="62">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <Button Content="ADMIN SETTINGS"
                Foreground="WhiteSmoke"
                Background="Transparent"
                BorderThickness="0"
                Grid.Column="7"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                FontSize="17"
                FontFamily="Fonts/#myfont"
                FontWeight="UltraLight"
                RenderTransformOrigin="0.5,0.5" Width="132" Height="22" Click="Button_Click" >
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform Angle="0.126"/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>


            <Button Content="VIEW" Grid.Column="12" 
                    Foreground="WhiteSmoke" Background="Transparent"
                    BorderThickness="0" FontSize="15" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="3" Margin="117,0,117,0">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button Content="🔔" Grid.Column="14" 
                    Foreground="WhiteSmoke" Background="Transparent" 
                    BorderThickness="0" FontSize="15" RenderTransformOrigin="0.5,0.5">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button Content="☀" Grid.Column="14" 
                    Foreground="WhiteSmoke" Background="Transparent" 
                    BorderThickness="0" FontSize="15" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="2" Margin="117,0,0,0">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button Content="👤" Grid.Column="15" 
                    Foreground="WhiteSmoke" Background="Transparent" 
                    BorderThickness="0" FontSize="15" RenderTransformOrigin="0.5,0.5" Grid.ColumnSpan="3" Margin="117,0,117,0" Click="Button_Click_1">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
            <Button x:Name="btn_Login" Content="Main Menu" Grid.Column="17"
                    Foreground="White" FontSize="14" FontWeight="Medium"
                    Background="#FF801336" BorderThickness="0" Width="85" 
                    RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Margin="0,3,0,3">
                <Button.Style>
                    <Style/>
                </Button.Style>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>
        </Grid>

        <!-- Sidebar -->
        <Grid x:Name="SidebarPanel" Width="75"
              Background="{DynamicResource SidebarBrush}"
              Margin="0,30,0,0"
              HorizontalAlignment="Left" RenderTransformOrigin="1.367,0.57">
            <Grid.RowDefinitions>
                <RowDefinition Height="149*"/>
                <RowDefinition Height="286*"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="10,10,10,0" VerticalAlignment="Top" Grid.RowSpan="2">
                <Button Content="☰" Click="ToggleSidebar_Click"
                        Foreground="White" Background="Transparent"
                        FontSize="18" Margin="10" BorderThickness="0"/>

                <Button Background="Transparent" BorderThickness="0" Height="50" Foreground="White">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏠" FontSize="18" Margin="10,0"/>
                        <TextBlock x:Name="lblButton1" Text="Home"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📁" FontSize="18" Margin="10,0" Foreground="White"/>
                        <TextBlock x:Name="lblButton2" Text="Files"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📊" FontSize="18" Margin="10,0" Foreground="White"/>
                        <TextBlock x:Name="lblButton3" Text="Reports"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍" FontSize="18" Margin="10,0" Foreground="White"/>
                        <TextBlock x:Name="lblButton4" Text="Search"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⚙" FontSize="18" Margin="10,0" Foreground="White"/>
                        <TextBlock x:Name="lblButton5" Text="Settings"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
                <Button Background="Transparent" BorderThickness="0" Height="50">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="👤" FontSize="18" Margin="10,0" Foreground="White"/>
                        <TextBlock x:Name="lblButton6" Text="Profile"
                                   FontSize="16" Foreground="White"
                                   Margin="10,0" Visibility="Collapsed"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main content -->
        <Grid Margin="60,30,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="287*"/>
            </Grid.ColumnDefinitions>
            <Grid.Background>
                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                    <GradientStop Color="#FFEE4540"/>
                    <GradientStop Color="#FF2D142C" Offset="1"/>
                    <GradientStop Color="#FF510A32" Offset="0.565"/>
                    <GradientStop Color="#FFC72C41" Offset="0.157"/>
                    <GradientStop Color="#FF801336" Offset="0.365"/>
                    <GradientStop Color="#FF670E33" Offset="0.426"/>
                </LinearGradientBrush>
            </Grid.Background>
        </Grid>

        <Grid Grid.Column="1" >
            <accounts:BankReconciliationView/>
            <Border BorderBrush="White" BorderThickness="5" HorizontalAlignment="Center" Height="900" VerticalAlignment="Center" Width="1472"/>
        </Grid>

    </Grid>
</UserControl>