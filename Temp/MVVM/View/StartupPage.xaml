<Window x:Class="AccountsPro.MVVM.View.StartupPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AccountsPro.MVVM.View"
        mc:Ignorable="d"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        BorderBrush="White"
        BorderThickness="1"
        Height="450" 
        Width="850"
        WindowStyle="None"
        Background="Beige">



    <Grid UseLayoutRounding="True">

        <Grid.Background>

            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540" Offset="1"/>
                <GradientStop Color="#FF2D142C"/>
                <GradientStop Color="#FF510A32" Offset="0.435"/>
                <GradientStop Color="#FFC72C41" Offset="0.843"/>
                <GradientStop Color="#FF801336" Offset="0.635"/>
                <GradientStop Color="#FF670E33" Offset="0.574"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel Grid.Row="1" VerticalAlignment="Center"  Height="212" >

            <StackPanel Orientation="Horizontal"  
                        Margin="30" 
                        Height="41">

                <Image Width="40" 
                       Height="31"
                       VerticalAlignment="Center"
					   RenderOptions.BitmapScalingMode="Fant"
                       Source="C:\Users\Dotnet_User1\Desktop\12SeptemberUpdate\FlexMold[12-Feb]-AccountingUpdate\Accountspro.ico"/>

                <TextBlock Text="AccountsPRO"
                           Foreground="White"
                           VerticalAlignment="Center"
                           FontWeight="Medium"
                           FontSize="25"
						   Margin="0,0,0,0" 
                           />
            </StackPanel>
            <TextBlock Text="Welcome to AccountsPRO, your one-stop solution!"
                       Foreground="WhiteSmoke"
                       HorizontalAlignment="Left"
                       FontSize="14"
                       TextWrapping="Wrap" Height="25"
                       Margin="69,-15,0,0"
                       Width="320"/>

            
            <StackPanel Orientation="Horizontal" Margin="60,10,120,0">
                <Button x:Name="btn_Start"
                        Content="Start"
                        Foreground="White"
                        Width="90"
                        Height="30"
                        FontWeight="Medium"  
                        FontSize="13"
                        Style="{StaticResource AnimatedRedButton}"
                        Click="btn_Start_Click"
                       />


                <Button Content="Register"
                    Width="90" 
                    Height="30"
                    Margin="10,0,0,0"
                    FontSize="13"
                    FontWeight="Medium"
                    Foreground="White"
                    HorizontalAlignment="Center"
                        Style="{StaticResource AnimatedRedButton}"
                    />
                
            </StackPanel>
            
        </StackPanel>


        <Grid Margin="82,-424,-476,386"
			  >

            <Grid.RenderTransform>
                <RotateTransform Angle ="45" />
            </Grid.RenderTransform>

            <StackPanel Orientation ="Horizontal" Margin="0,0,0,345">

                <StackPanel RenderTransformOrigin="0.5,0.5" Height="590">
                    <StackPanel.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform AngleX="0.302"/>
                            <RotateTransform/>
                            <TranslateTransform X="1.586"/>
                        </TransformGroup>
                    </StackPanel.RenderTransform>
                    <Border Width="700" 
							Height="35"
							Background="#FFEE4540"
							Margin="150,0,0,0"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="#801336"
							Margin="0,15,0,0"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="#510A46"
							Margin="75,15,0,0"
							CornerRadius="20"/>
                </StackPanel>
                <StackPanel Height="585">
                    <Border Width="700"
							Height="32"
							Background="white"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="#FFEE4540"
							Margin="75,15,0,0"
							CornerRadius="20"/>
                </StackPanel>

            </StackPanel>

        </Grid>
        <StackPanel  Height="53"/>


    </Grid>

</Window>
