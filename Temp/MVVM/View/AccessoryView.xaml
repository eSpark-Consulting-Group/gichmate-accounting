<UserControl
    x:Class="FlexMold.MVVM.View.AccessoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlexMold.MVVM.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:FlexMold.MVVM.ViewModel"
    xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    Height="1000" Width="1900"
       mc:Ignorable="d">

    <UserControl.DataContext>
        <viewmodel:AccessoryViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Storyboard x:Key="ExpandSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarPanel"
                         Storyboard.TargetProperty="Width"
                         To="250" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="CollapseSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarPanel"
                         Storyboard.TargetProperty="Width"
                         To="360" Duration="0:0:0.1"/>
        </Storyboard>
    </UserControl.Resources>


    <Grid>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="SidebarBorder" MinWidth="50" Background="White">
            <StackPanel>
                <!-- Hamburger toggle -->
                <ToggleButton x:Name="SidebarToggle"
                          Width="50"
                          Height="50"
                          Content="☰"
                          FontSize="20"
                          Background="Transparent"
                          Foreground="Black"
                          BorderThickness="0"/>

                <!-- MENU ITEM 1 with submenu -->
                <ToggleButton x:Name="Menu1Toggle"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="Black"
                          Padding="10"
                          HorizontalContentAlignment="Left"
                          Content="📁 Sales Reports"
                          Visibility="{Binding IsChecked, ElementName=SidebarToggle, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Margin="20,0,0,0"
                        Visibility="{Binding IsChecked, ElementName=Menu1Toggle, Converter={StaticResource BoolToVis}}">
                    <Button Content="New File"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                    <Button Content="Sales Report 1"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                    <Button Content="File"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                    <Button Content="Report 2"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                    <Button Content="Purchase"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                </StackPanel>

                <!-- MENU ITEM 2 with submenu -->
                <ToggleButton x:Name="Menu2Toggle"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="Black"
                          Padding="10"
                          HorizontalContentAlignment="Left"
                          Content="📊 DASHBOARD"
                          Visibility="{Binding IsChecked, ElementName=SidebarToggle, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Margin="20,0,0,0"
                        Visibility="{Binding IsChecked, ElementName=Menu2Toggle, Converter={StaticResource BoolToVis}}">
                    <Button Content="New File"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                    <Button Content="Sales Report 1"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                    <Button Content="File"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                    <Button Content="Report 2"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                    <Button Content="Purchase"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                </StackPanel>


                <!-- MENU ITEM 3 with submenu -->
                <ToggleButton x:Name="Menu3Toggle"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="Black"
                          Padding="10"
                          HorizontalContentAlignment="Left"
                          Content="👤 Account"
                          Visibility="{Binding IsChecked, ElementName=SidebarToggle, Converter={StaticResource BoolToVis}}"/>
                <StackPanel Margin="20,0,0,0"
                        Visibility="{Binding IsChecked, ElementName=Menu3Toggle, Converter={StaticResource BoolToVis}}">
                    <Button Content="Add"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                    <Button Content="Edit"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="Black"
                        Padding="5"
                        HorizontalContentAlignment="Left"/>
                </StackPanel>

                <!-- MENU ITEM 4 (no submenu) -->
                <Button Content="⚙️ Settings"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="Black"
                    FontSize="16"
                    Padding="10"
                    HorizontalContentAlignment="Left"
                    Visibility="{Binding IsChecked, ElementName=SidebarToggle, Converter={StaticResource BoolToVis}}"/>

                <!-- MENU ITEM 5 (no submenu) -->
                <Button Content="❓ Help"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="Black"
                    FontSize="16"
                    Padding="10"
                    HorizontalContentAlignment="Left"
                    Visibility="{Binding IsChecked, ElementName=SidebarToggle, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1">
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFEE4540"/>
                    <GradientStop Color="#FF2D142C" Offset="1"/>
                    <GradientStop Color="#FF510A32" Offset="0.565"/>
                    <GradientStop Color="#FFC72C41" Offset="0.157"/>
                    <GradientStop Color="#FF801336" Offset="0.365"/>
                    <GradientStop Color="#FF670E33" Offset="0.426"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.RowDefinitions>
                <RowDefinition Height="34*"/>
                <RowDefinition Height="236*"/>
                <RowDefinition Height="564*"/>
                <RowDefinition Height="75*"/>
                <RowDefinition Height="91*"/>
            </Grid.RowDefinitions>
        </Grid>
    </Grid>


</UserControl>