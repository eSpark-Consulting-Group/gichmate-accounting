<UserControl
    x:Class="FlexMold.MVVM.View.Home.VisualDisplayView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:FlexMold.MVVM.View.Home"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">


    <UserControl.Resources>
        <LinearGradientBrush x:Key="SidebarBrush" StartPoint="0.5,0" EndPoint="0.5,1">
            <GradientStop Color="#FFEE4540"/>
            <GradientStop Color="#FF2D142C" Offset="1"/>
            <GradientStop Color="#FF510A32" Offset="0.565"/>
            <GradientStop Color="#FFC72C41" Offset="0.157"/>
            <GradientStop Color="#FF801336" Offset="0.365"/>
            <GradientStop Color="#FF670E33" Offset="0.426"/>
        </LinearGradientBrush>

        <Storyboard x:Key="ExpandSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarPanel"
                             Storyboard.TargetProperty="Width"
                             To="200" Duration="0:0:0.3"/>
        </Storyboard>

        <Storyboard x:Key="CollapseSidebar">
            <DoubleAnimation Storyboard.TargetName="SidebarPanel"
                             Storyboard.TargetProperty="Width"
                             To="60" Duration="0:0:0.3"/>
        </Storyboard>
    </UserControl.Resources>

    <Border Background="AliceBlue"
            CornerRadius="30">

        <Grid x:Name="MenuBarStackPanel">
            <Grid.Background>

                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFEE4540"/>
                    <GradientStop Color="#FF2D142C" Offset="1"/>
                    <GradientStop Color="#FF510A32" Offset="0.565"/>
                    <GradientStop Color="#FFC72C41" Offset="0.157"/>
                    <GradientStop Color="#FF801336" Offset="0.365"/>
                    <GradientStop Color="#FF670E33" Offset="0.426"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="239"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="0*"/>
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="75"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="REPORTS"
                       VerticalAlignment="Center"
                       Foreground="White"
                       FontSize="32"
                       FontFamily="/Fonts/#Poppins-Bold"
                       Margin="10,0,0,0" Height="48" />


            <StackPanel Grid.Row="1" Background="GhostWhite">

                <RadioButton Content="ADVANCE REPORTS"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton x:Name="SalesReportButton" Content="SALES"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}" 
                             Command="{Binding ShowReportPageCommand}" 
                                                         />

                <RadioButton Content="SALES RETURN REPORT"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="PURCHASE"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="PURCHASE RETURN REPORT"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="SALES ESTIMATE REPORT"
                            Height="50"
                            Foreground="White"
                            FontSize="14"
                            FontFamily="/Fonts/#Poppins"
                            Style="{StaticResource MenuButtonTheme}"                             
                            />

                <RadioButton Content="SALES ORDER REPORT"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                            
                             />

                <RadioButton Content="SALES QUOTATION REPORT"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="PURCHASE ORDER REPORT"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="PRICE LIST"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="PARTY LIST"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="ACCOUNT PAYABLE REPORT"
                            Height="50"
                            Foreground="White"
                            FontSize="14"
                            FontFamily="/Fonts/#Poppins"
                            Style="{StaticResource MenuButtonTheme}"                             
                            />

                <RadioButton Content="RECIEVABLE REPORT"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                           
                             />

                <RadioButton Content="ROOTWISE COLLECTION RP."
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="TRANSACTION REPORT"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="CUSTOMER REPORT"
                             Height="50"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />

                <RadioButton Content="SUPPLIER REPORT"
                             Height="59"
                             Foreground="White"
                             FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                             Style="{StaticResource MenuButtonTheme}"                             
                             />
                <RadioButton Content="OTHER REPORTS"
                    Height="59"
                    Foreground="White"
                    FontSize="14"
                    FontFamily="/Fonts/#Poppins"
                    Style="{StaticResource MenuButtonTheme}"                             
                             />

                <!--<RadioButton Content="OTHER REPORTS"
                            Height="30"
                            Foreground="White"
                            FontSize="14"
                             FontFamily="/Fonts/#Poppins"
                            Style="{StaticResource MenuButtonTheme}"                             
                            />-->

            </StackPanel>

            <TextBox Width="258"
                     VerticalContentAlignment="Center"
                     HorizontalAlignment="Left"
                     Margin="5,18,0,17"
                     Grid.Column="1"
                     Style="{StaticResource MahApps.Styles.Control.WindowCommands}"/>

            <!--INCLUDING THE MAIN CONTENT HERE -->

            <!--<ContentControl Grid.Row="1"
                      Grid.Column="1"
                      Margin="10,10,289,190"     
                            >
                <ContentControl.Background>
                    <ImageBrush ImageSource="/Capture.PNG"/>
                </ContentControl.Background>
            </ContentControl>-->
            <StackPanel
                Grid.Row="1"
                      Grid.Column="1">

            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" Height="837" Margin="0,0,29,0" Grid.Row="1" VerticalAlignment="Center" Width="1322"/>


        </Grid>
        </Border>
   </UserControl>