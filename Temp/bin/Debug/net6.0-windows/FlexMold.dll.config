<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
		<add key="ZlaserIP" value="192.168.18.162" />
		<add key="ZlaserPort" value="50000" />
		<add key="RPM_Assume" value="30" />
		<add key="AdsStateTimeout" value="6000" />
		<add key="Max_mm" value="1000" />
		<add key="DefaultRampDelay" value="5" />
		<add key="DefaultRampTime" value="33" />
		<add key="RemoveResumeAfterProcess" value="1" />
	</appSettings>
</configuration>
