<Window x:Class="DashboardWPFApp12.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DashboardWPFApp12"
        mc:Ignorable="d"
        Title="MainWindow" Height="500" Width="900"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Beige">

    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                <GradientStop Color="#FFEE4540"/>
                <GradientStop Color="#FF2D142C" Offset="1"/>
                <GradientStop Color="#FF510A32" Offset="0.565"/>
                <GradientStop Color="#FFC72C41" Offset="0.157"/>
                <GradientStop Color="#FF801336" Offset="0.365"/>
                <GradientStop Color="#FF670E33" Offset="0.426"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <!-- Top navigation bar -->
        <Grid Background="#EE4540" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="Dashboard"
                       Foreground="White"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="19"
                       FontFamily="Fonts/#myfont"
                       FontWeight="Medium" Margin="0,0,18,0"
					   />

            <TextBlock Text="MENU"
                       Foreground="WhiteSmoke"
                       Grid.Column="1"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontFamily="Fonts/#myfont"
                       FontWeight="UltraLight"/>

            <TextBlock Text="ACCOUNTS"
                       Foreground="WhiteSmoke"
                       Grid.Column="2"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontFamily="Fonts/#myfont"
                       FontWeight="UltraLight"/>

            <TextBlock Text="PROFILES"
                       Foreground="WhiteSmoke"
                       Grid.Column="3"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       FontSize="17"
                       FontFamily="Fonts/#myfont"
                       FontWeight="UltraLight"/>

            <Button x:Name="btn_Login" Grid.Column="7"
					Content="Log In"
					Foreground="White"
					FontSize="14"
					FontWeight="Medium"
					Margin="10,-5,0,-5" Click="Btn_Login" HorizontalAlignment="Left" Width="116">
                <Button.Effect>
                    <DropShadowEffect/>
                </Button.Effect>
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Background" Value="#FF801336"/>
                    </Style>
                </Button.Style>
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
									Width="90"
									Height="30"
									
									Background="{TemplateBinding Background}">
                            <ContentPresenter VerticalAlignment="center"
												  HorizontalAlignment="center"
												  Content="{TemplateBinding Content}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="#FF9B3D3D"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Main content -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2" VerticalAlignment="center">
            <StackPanel Orientation="Horizontal" Margin="30">
                <Image Width="99" Height="99"
					   RenderOptions.BitmapScalingMode="Fant"
                       Source="C:\Users\Dotnet_User1\Source\Repos\DashboardWPFApp12\Images\logo.png"/>

                <TextBlock Text="AccountsPRO"
                           Foreground="White"
                           FontWeight="Medium"
                           FontFamily="Fonts/#font2"
                           VerticalAlignment="Center"
                           FontSize="30"
						   Margin="0,10,10,0"/>
            </StackPanel>
            <TextBlock Text="Welcome to AccountsPRO, your one-stop solution!"
                       Foreground="WhiteSmoke"
                       FontSize="16"
                       FontFamily="Fonts/#myfont"
                       TextWrapping="Wrap" Height="25" Width="360"/>

            <!-- Start Buttons side by side -->
            <StackPanel Orientation="Horizontal" Margin="40,10,0,0">
                <Button x:Name="btn_Start" Content="Start"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="Medium"
                        Height="45"
                        Width="112" Click="Btn_Start">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF801336"/>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
										Width="100"
										Height="25"
										CornerRadius="12"
										Background="{TemplateBinding Background}">
                                <ContentPresenter VerticalAlignment="Center"
													  HorizontalAlignment="Center"
													  Content="{TemplateBinding Content}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#FF9B3D3D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Content="Register"
                    Width="100" Height="25"
                    Margin="0,0,0,0"
                    FontSize="14"
                    FontWeight="Medium"
                    Foreground="White"
                    HorizontalAlignment="Center"
                    Click="Btn_Register">
                    <Button.Effect>
                        <DropShadowEffect/>
                    </Button.Effect>
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#FF801336"/>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border"
                                CornerRadius="12"
                                Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border"
                                        Property="Background"
                                        Value="#FF9B3D3D"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </StackPanel>


        <!--The main design here-->
        <Grid
			  Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="175,-445,-569,791"
			  >

            <Grid.RenderTransform>
                <RotateTransform Angle ="45" />
            </Grid.RenderTransform>

            <StackPanel Orientation ="Horizontal">

                <StackPanel>
                    <Border Width="700" 
							Height="35"
							Background="#510A32"
							Margin="150,0,0,0"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="#801336"
							Margin="0,15,0,0"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="#510A46"
							Margin="75,15,0,0"
							CornerRadius="20"/>
                </StackPanel>
                <StackPanel>
                    <Border Width="700" 
							Height="35"
							Background="#EE4540"
							Margin="150,0,0,0"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="white"
							Margin="0,15,0,0"
							CornerRadius="20"/>

                    <Border Width="700"
							Height="35"
							Background="#EE4540"
							Margin="75,15,0,0"
							CornerRadius="20"/>
                </StackPanel>

            </StackPanel>

        </Grid>


    </Grid>
</Window>