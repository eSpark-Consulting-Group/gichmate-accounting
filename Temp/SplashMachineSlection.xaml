<mah:MetroWindow
    x:Class="FlexMold.SplashMachineSlection"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:FlexMold"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesignMahApps="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodel="clr-namespace:FlexMold.MVVM.ViewModel"
    Title="Welcome To FlexMold ..."
    Width="800"
    Height="600"
    d:DataContext="{d:DesignInstance viewmodel:SplashScreenViewModel,
                                     IsDesignTimeCreatable=True}"
    ResizeMode="NoResize"
    WindowStyle="None"
    ShowCloseButton="False"
    ShowMaxRestoreButton="False"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <mah:MetroWindow.Resources>
        <ResourceDictionary>
            <Style x:Key="LargeTileStyle" TargetType="mah:Tile">
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="TitleFontSize" Value="14" />
                <Setter Property="Width" Value="300" />
            </Style>
            <Style x:Key="SmallTileStyle" TargetType="mah:Tile">
                <Setter Property="Height" Value="125" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
                <Setter Property="TitleFontSize" Value="10" />
                <Setter Property="Width" Value="147" />
            </Style>
        </ResourceDictionary>
    </mah:MetroWindow.Resources>
    <materialDesignMahApps:DialogHost DialogTheme="Inherit" Identifier="SplashDialog">
        <Grid>
            <Grid.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFEE4540"/>
                    <GradientStop Color="#FF2D142C" Offset="1"/>
                    <GradientStop Color="#FF510A32" Offset="0.565"/>
                    <GradientStop Color="#FFC72C41" Offset="0.157"/>
                    <GradientStop Color="#FF801336" Offset="0.365"/>
                    <GradientStop Color="#FF670E33" Offset="0.426"/>
                </LinearGradientBrush>
            </Grid.Background>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="221*" />
                <ColumnDefinition Width="69*"/>
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="300" />
                <RowDefinition Height="150" />
                <RowDefinition />
            </Grid.RowDefinitions>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                FontFamily="Segoe UI"
                FontSize="30"
                FontWeight="Light"
                Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                Text="Please Select Enter" Grid.ColumnSpan="2" />
            <ItemsControl
                x:Name="MyItems"
                Grid.Column="1"
                IsEnabled="{Binding ICEnable}"
                ItemsSource="{Binding MyMachines}" Grid.ColumnSpan="2" Margin="0,73,0,144" Grid.RowSpan="3">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                    <Style>
                        <Setter Property="Grid.Row" Value="{Binding Row}" />
                        <Setter Property="Grid.Column" Value="{Binding Column}" />
                    </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <mah:Tile
                                Title="{Binding Path=Name}"
                                AutomationProperties.AutomationId="TileClick"
                                Command="{Binding ElementName=MyItems, Path=DataContext.MachineClickCommand}"
                                CommandParameter="{Binding}"
                                Content="{Binding Path=IconT}"
                                Style="{StaticResource LargeTileStyle}"
                                VerticalTitleAlignment="Top" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            
        </Grid>
    </materialDesignMahApps:DialogHost>
</mah:MetroWindow>